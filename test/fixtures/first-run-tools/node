#!/bin/sh
# A stand-in for node (test/fixtures/first-run-tools/README.md): only `node --version`.
[ -n "$FIRST_RUN_TOOLS_LOG" ] && printf 'node %s\n' "$*" >>"$FIRST_RUN_TOOLS_LOG"
if [ "$1" = --version ]; then
  printf 'v%s\n' "${FAKE_NODE_VERSION:-22.11.0}"
  exit 0
fi
printf 'node stand-in: unsupported: %s\n' "$*" >&2
exit 2
