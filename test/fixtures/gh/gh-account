#!/bin/sh
# A gh for the tests of the Project's GitHub account (test/contract/github-prs.test.ts, worfy-week
# ticket 01): logs "<GH_TOKEN or <unset>>\t<arg>\t<arg>…" to $GH_STUB_LOG, is logged in only as
# $GH_STUB_ACCOUNT when $GH_STUB_TOKEN is set, and answers `pr list` from $GH_STUB_DIR/prs.json.
# Only shell built-ins and cat: the tests run it with PATH=/usr/bin:/bin.
{ printf '%s' "${GH_TOKEN-<unset>}"; for a in "$@"; do printf '\t%s' "$a"; done; printf '\n'; } >> "$GH_STUB_LOG"
if [ "$1" = auth ] && [ "$2" = token ]; then
  if [ "$3" = -u ] && [ "$4" = "$GH_STUB_ACCOUNT" ] && [ -n "$GH_STUB_TOKEN" ]; then printf '%s\n' "$GH_STUB_TOKEN"; exit 0; fi
  printf 'no oauth token found for github.com account %s\n' "$4" >&2
  exit 1
fi
if [ "$1" = pr ] && [ "$2" = list ]; then
  if [ -n "$GH_STUB_LIST_EXIT" ]; then printf '%s' "$GH_STUB_LIST_STDERR" >&2; exit "$GH_STUB_LIST_EXIT"; fi
  cat "$GH_STUB_DIR/prs.json"
  exit 0
fi
printf 'gh stub: unsupported command: %s\n' "$*" >&2
exit 2
