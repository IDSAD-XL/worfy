{
  "env": {
    "CLAUDE_CODE_FIXTURE": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/worktree-lock claim",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/telegram-mcp --hello",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gate.sh fast",
            "timeout": 900
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gate.sh fast",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/worktree-lock beat",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/qmd-refresh --quiet",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SANDBOX__/home/.claude/hooks/session-end.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/worktree-lock release",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "worfy@worfy-harness": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark",
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "__SANDBOX__/dev-checkout/scripts/statusline-bridge.sh 'bash ~/.claude/statusline.sh'"
  }
}
