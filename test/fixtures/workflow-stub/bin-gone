#!/usr/bin/env node
// The old Harness's epic-status while the move to the plugin takes <Claude home>/bin away
// (test/contract/workflow-reader.test.ts): removes the folder of the link it was started by, and
// fails. Only through a link, so running this file itself removes nothing of the fixtures.
import { lstatSync, rmSync } from 'node:fs'
import { dirname } from 'node:path'
import process from 'node:process'

const self = process.argv[1]
if (lstatSync(self).isSymbolicLink()) rmSync(dirname(self), { recursive: true, force: true })
process.exitCode = 1
