#!/usr/bin/env node
// epic-status of the Harness plugin (test/contract/workflow-reader.test.ts): logs the HARNESS_HOME
// it was given to $STUB_HARNESS_ENV, then answers as ./epic-status does.
import { appendFileSync } from 'node:fs'
import process from 'node:process'

appendFileSync(process.env.STUB_HARNESS_ENV, `${process.env.HARNESS_HOME ?? 'unset'}\n`)
await import('./epic-status.mjs')
