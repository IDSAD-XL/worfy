#!/usr/bin/env node
// A stand-in for the Harness scripts epic-status, profile and ticket (test/contract/harness-script-wiring.test.ts):
// the tests link it under those names. It logs what it got to $CALLS and answers as the real script of
// its name would; the answers take the Workflow folder from $WORKFLOW.
//
// worfy starts the Harness scripts as `node <script>` (src/main/workflow/profile.ts, harnessScriptCommand),
// so this is a Node script; the name it answers for is that of the link it was started by.
import { appendFileSync, readFileSync } from 'node:fs'
import { basename } from 'node:path'
import process from 'node:process'

const name = basename(process.argv[1])
const env = (key) => process.env[key] ?? 'unset'
appendFileSync(process.env.CALLS, `${name} MARK=${env('MARK')} WORFY_WIRING_LEAK=${env('WORFY_WIRING_LEAK')} HARNESS_HOME=${env('HARNESS_HOME')}\n`)
if (name === 'epic-status') {
  process.stdout.write('{"ref":"main","epics":[{"epic":"demo","hasSpec":false,"hasMap":false}],"tickets":[]}')
} else if (name === 'profile') {
  // The exit code in $PROFILE_EXIT_FILE, when set: a profile without node or with a broken registry.
  const code = process.env.PROFILE_EXIT_FILE ? readFileSync(process.env.PROFILE_EXIT_FILE, 'utf8').trim() : '0'
  if (code !== '0') {
    process.stderr.write('env: node: No such file or directory\n')
    process.exitCode = Number(code)
  } else {
    process.stdout.write(`{"_resolved":{"mode":"silent","workflow_folder":"${process.env.WORKFLOW}","repos":[]}}`)
  }
} else if (name === 'ticket') {
  process.stdout.write(`${process.env.WORKFLOW}/.scratch\n`)
}
