#!/usr/bin/env node
// The old Harness's epic-status taken away while it runs, as the move to the plugin takes it away
// (test/contract/harness-script-wiring.test.ts): logs what it got to $CALLS, removes the link it was
// started by, and fails. A Node script: worfy starts the Harness scripts as `node <script>`.
import { appendFileSync, unlinkSync } from 'node:fs'
import { basename } from 'node:path'
import process from 'node:process'

const self = process.argv[1]
const env = (key) => process.env[key] ?? 'unset'
appendFileSync(process.env.CALLS, `${basename(self)} MARK=${env('MARK')} WORFY_WIRING_LEAK=${env('WORFY_WIRING_LEAK')} HARNESS_HOME=${env('HARNESS_HOME')}\n`)
try {
  unlinkSync(self)
} catch {
  // Already gone.
}
process.exitCode = 1
