#!/usr/bin/env node
// profile — finds the project's profile from a directory and prints it.
//
//   profile                     summary: name, paths, profile.json and rules.md (this is what agents read)
//   profile --json              profile.json + a _resolved block (name, profile directory, root, checkout,
//                               mode, workflow_folder, repos, pipeline)
//   profile --field a.b.c       one field (a string as is, anything else as JSON); _resolved.* too
//   profile --rules             only rules.md
//   profile --dir               only the profile directory
//   profile --name              only the profile name
//   -C <dir>                    resolve as if profile were run from <dir> (a relative path is
//                               taken from the current one); agents pass the repository path from their brief here
//
// Exit codes: 0 — found; 2 — usage error; 3 — the directory is outside the registered
// projects or the project has no profile; 4 — no such field (--field); 1 — broken config,
// resolver or profile.json.
//
// Identification is the same as in hooks/gate.mjs: directory -> git common dir -> canonical
// repository root -> `hooks/gate-resolve.mjs --which` (the longest `match` prefix
// in gate/config.json). So a worktree anywhere on disk is identified
// by its main repository. The matching logic is not duplicated —
// we call the resolver. The profile is the "profile" field of the entry in gate/config.json;
// the profile itself lives in $HARNESS_HOME/projects/<name>/, during the transition also in
// ~/.claude/profiles/<name>/ (schema 1); format: profiles/README.md.
// profile only reads: it writes nothing anywhere.
// A directory outside every `match` but inside the common parent of one profile's repositories
// (workspace, see workspaceOf below) gets that profile; _resolved.workspace is that parent.
"use strict"

const fs = require("node:fs")
const os = require("node:os")
const path = require("node:path")
const { execFileSync } = require("node:child_process")
// The git to start and the Harness state folder, with the variables of an eval run (EVAL_GIT, EVAL_HARNESS_HOME).
const { git: GIT, harnessHome } = require("../hooks/eval-env.cjs")
// The rules of the Pipeline (workflow.pipeline), one copy for this reader and the writer bin/profile-set.
const { resolvePipeline } = require("../lib/pipeline.cjs")
const { englishPlaceholders, englishHeadings } = require("../lib/old-words.cjs")

// os.homedir(): $HOME where it is set (macOS, Linux, Git Bash), %USERPROFILE% on Windows without it.
const CLAUDE = path.join(os.homedir(), ".claude")
// The plugin root: the folder above bin/, found from this script's real file (not a symlink).
const PLUGIN_ROOT = path.dirname(path.dirname(fs.realpathSync(__filename)))
const RESOLVE = process.env.CLAUDE_GATE_RESOLVE || path.join(PLUGIN_ROOT, "hooks", "gate-resolve.mjs")
// This Harness's own scripts: the folder this script lives in.
const BIN = path.dirname(fs.realpathSync(__filename))

const USAGE = `usage: profile [-C <dir>] [--json | --field <dotted.path> | --rules | --dir | --name]
exit: 0 found, 2 usage, 3 not a registered project / no profile, 4 field absent, 1 broken config`

const out = (s) => process.stdout.write(s.endsWith("\n") ? s : s + "\n")
const err = (s) => process.stderr.write(s.endsWith("\n") ? s : s + "\n")
const die = (code, msg) => {
    if (msg) err(`profile: ${msg}`)
    process.exit(code)
}
const usage = (msg) => {
    if (msg) err(`profile: ${msg}`)
    err(USAGE)
    process.exit(2)
}

// --- arguments -----------------------------------------------------------------
let mode = null
let field = null
let target = process.cwd()
const setMode = (m) => {
    if (mode) usage(`only one of --json/--field/--rules/--dir/--name at a time`)
    mode = m
}
const argv = process.argv.slice(2)
for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    switch (a) {
        case "--json":
        case "--rules":
        case "--dir":
        case "--name":
            setMode(a.slice(2))
            break
        case "--field":
            setMode("field")
            field = argv[++i]
            if (!field || field.startsWith("-")) usage("--field needs a dotted path, e.g. commands.test")
            break
        case "-C":
            target = argv[++i]
            if (!target) usage("-C needs a directory")
            break
        case "-h":
        case "--help":
            out(USAGE)
            process.exit(0)
        default:
            usage(`unknown argument: ${a}`)
    }
}

let abs = path.resolve(target)
try {
    if (!fs.statSync(abs).isDirectory()) usage(`not a directory: ${target}`)
    // native: the spelling from disk (on a case-insensitive FS ~/work/acme -> ~/Work/Acme),
    // otherwise workspaceOf and the resolver would compare strings in someone else's case
    abs = fs.realpathSync.native(abs)
} catch {
    usage(`no such directory: ${target}`)
}

// The Harness state on this machine (HARNESS_HOME, by default ~/.claude/worfy-harness); the gate registry
// lives there. It is asked for the directory being resolved: a relative EVAL_HARNESS_HOME is taken from its
// git common dir.
const HARNESS_HOME = harnessHome(abs)
// Transition: with no registry in HARNESS_HOME but one in the old place, read the old one.
const gateConfig = () => {
    const current = path.join(HARNESS_HOME, "gate", "config.json")
    const legacy = path.join(CLAUDE, "gate", "config.json")
    return !fs.existsSync(current) && fs.existsSync(legacy) ? legacy : current
}
const CFG = process.env.CLAUDE_GATE_CONFIG || gateConfig()
// Where a profile is looked for, in order: $HARNESS_HOME/projects/<name>/, then (transition, schema 1)
// ~/.claude/profiles/<name>/. CLAUDE_PROFILES_DIR (tests) replaces both.
const PROFILE_DIRS = process.env.CLAUDE_PROFILES_DIR
    ? [process.env.CLAUDE_PROFILES_DIR]
    : [path.join(HARNESS_HOME, "projects"), path.join(CLAUDE, "profiles")]

// --- canonical root: as in gate.mjs -----------------------------------------------
const git = (...a) => {
    try {
        return execFileSync(GIT, ["-C", abs, ...a], {
            encoding: "utf8",
            stdio: ["ignore", "pipe", "ignore"],
        }).trim()
    } catch {
        return null
    }
}
const checkout = git("rev-parse", "--show-toplevel")
let canon = abs
if (checkout) {
    const common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if (common) canon = path.dirname(common)
    try {
        canon = fs.realpathSync.native(canon)
    } catch {}
}

// --- gate resolver: the same code that picks the checks ----------------------------
let which
try {
    // The node running this script, not the first `node` on PATH (which may be missing or another version).
    which = execFileSync(process.execPath, [RESOLVE, "--which", canon], {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "pipe"],
        env: { ...process.env, CLAUDE_GATE_CONFIG: CFG },
    }).trim()
} catch (e) {
    // What the resolver said: its Error line when it crashed ("TypeError: …"), not the stack under it
    // nor the "Node.js vNN" line node prints last; otherwise its own last line, which says what to
    // fix ("registry <path> cannot be read: …"). worfy's scriptFailureDetail shares only the `at`,
    // "Node.js vNN" and `^` filters and the choice of the Error line; it also drops node's crash
    // report and takes a FATAL ERROR line, and without an Error line it keeps the first lines.
    const lines = String(e.stderr ?? "")
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter((line) => line !== "" && !/^at\s/.test(line) && !/^Node\.js v\d/.test(line) && !/^\^+$/.test(line))
    const said = lines.find((line) => /^(?:[A-Z][A-Za-z]*)?Error\b.*:/.test(line)) ?? lines.at(-1)
    die(1, `resolver ${RESOLVE} failed (exit ${e.status}) — project not determined${said ? `: ${said}` : ""}`)
}
let cfg
try {
    cfg = JSON.parse(fs.readFileSync(CFG, "utf8"))
} catch (e) {
    die(1, `cannot read ${CFG}: ${e.message}`)
}

// The common directory of a project made of several repositories (workspace). A directory that itself
// lies in no `match` but lies in the common parent of all repositories of ONE profile belongs to
// that profile: this is how a session in /home/me/work/suite (above three repositories, not git itself)
// gets the suite profile. The common parent is computed from the registry, not stored: there is no second
// registry of paths. Not a workspace: a profile with one repository (its directory is the
// match itself), the disk root, $HOME and its parents, a directory inside a registry entry, and a directory holding a repository of another profile or of no profile.
// Only directories OUTSIDE git get the common directory's profile. A git repository that is not in
// the registry but lies in the common directory (scratch-tools in /home/me/work/suite)
// is someone else's project: exit 3, like any unregistered repository. Otherwise the gate, the session hooks
// and preflight would take it for one of the profile's repositories.
const under = (p, dir) => p === dir || p.startsWith(dir.endsWith(path.sep) ? dir : dir + path.sep)
let checkoutCanon = null
if (checkout) {
    try {
        checkoutCanon = fs.realpathSync.native(checkout)
    } catch {
        checkoutCanon = checkout
    }
}
function workspaceOf(target) {
    const repos = (cfg.repos || []).filter((r) => r && typeof r.match === "string" && r.match)
    const groups = new Map()
    for (const r of repos) if (r.profile) groups.set(r.profile, [...(groups.get(r.profile) || []), r])
    const home = os.homedir() ? path.resolve(os.homedir()) : null
    // A directory inside a registry entry (for example, a `match` with a trailing slash, which the resolver
    // compares as a string) is not a workspace: let it stay a loud exit 3, as before.
    if (repos.some((r) => under(target, path.resolve(r.match)))) return null
    const hits = []
    for (const [name, rs] of groups) {
        if (rs.length < 2) continue
        let ws = path.resolve(rs[0].match)
        for (const r of rs.slice(1)) while (!under(path.resolve(r.match), ws) && ws !== path.dirname(ws)) ws = path.dirname(ws)
        if (ws === path.dirname(ws) || (home && under(home, ws))) continue
        if (repos.some((r) => r.profile !== name && under(path.resolve(r.match), ws))) continue
        // A directory inside an unregistered git repository that lies in the common directory is
        // someone else's project. If the git repository is the common directory itself or lies above it (git init
        // in /home/me/work/suite, dotfiles in $HOME), that does not matter: the directory stays a workspace.
        if (checkoutCanon && checkoutCanon !== ws && under(checkoutCanon, ws)) continue
        if (under(target, ws)) hits.push({ name, ws, n: rs.length })
    }
    return hits.length === 1 ? hits[0] : null
}

let key = null
let repoRoot = null
let workspace = null
let entry
if (which) {
    ;[key, repoRoot] = which.split("\t")
    entry = (cfg.repos || []).find((r) => r.key === key)
    if (!entry || !entry.profile) die(3, `project "${key}" is registered in ${CFG} but has no "profile" field`)
} else {
    workspace = workspaceOf(canon)
    if (!workspace) die(3, `${abs} is not in a registered project (no "match" in ${CFG} covers ${canon})`)
    entry = { profile: workspace.name }
}

const name = entry.profile
const candidates = PROFILE_DIRS.map((d) => path.join(d, name, "profile.json"))
const pjPath = candidates.find((p) => fs.existsSync(p))
if (!pjPath)
    die(3, `${key ? `project "${key}"` : `workspace ${workspace.ws}`} names profile "${name}", but neither ${candidates.join(" nor ")} exists`)
const dir = path.dirname(pjPath)
let profile
try {
    profile = JSON.parse(fs.readFileSync(pjPath, "utf8"))
} catch (e) {
    die(1, `${pjPath} is not valid JSON: ${e.message}`)
}
if (profile === null || typeof profile !== "object" || Array.isArray(profile)) die(1, `${pjPath} is not a JSON object`)

// --- schema 1 and 2 ----------------------------------------------------------------
// schema 2 is the current format; schema 1 (or no "schema") is read during the transition.
// Any other value is a broken profile: reading it as one of the two would guess at its fields.
const schema = profile.schema === undefined ? 1 : profile.schema
if (schema !== 1 && schema !== 2) die(1, `${pjPath}: "schema": ${JSON.stringify(profile.schema)} is not supported (1 or 2) — broken profile`)
const MODES = ["full", "silent"]
if (schema === 2 && !MODES.includes(profile.mode))
    die(
        1,
        `${pjPath}: schema 2 needs "mode": "full" or "silent", got ${profile.mode === undefined ? "no mode" : JSON.stringify(profile.mode)} — broken profile (a guessed mode would put the workflow files in the wrong place)`
    )
// Before modes existed the whole Harness worked as Full mode.
if (schema === 1) profile.mode = "full"
// `attribution` not set (absent or null): the default follows the mode — `off` in Silent mode, whose repository
// and PRs show no trace of the workflow, `on` in Full mode. `"on"` or `"off"` written in the profile wins in
// both modes. Any other value is a broken profile, as with `mode`: printed as written it would read as "not
// off" to bin/silent-check and the guard, and a Silent project would carry the lines its default forbids.
// bin/silent-check, the guard, the session hook and skills read the resolved value from here; worfy's copy of
// the default (the "Add project" draft and the move of schema 1 profiles) is held to it by a contract test.
const ATTRIBUTIONS = ["on", "off"]
if (profile.attribution === undefined || profile.attribution === null) profile.attribution = profile.mode === "silent" ? "off" : "on"
else if (!ATTRIBUTIONS.includes(profile.attribution))
    die(
        1,
        `${pjPath}: "attribution" is "on" or "off", got ${JSON.stringify(profile.attribution)} — broken profile (a guessed value would decide whether commits and PRs carry the Claude attribution lines)`
    )
// The old form `"language": "ru"` is one language for everything. Readers ask for `language.reports`,
// `language.team` and `language.docs` (profiles/README.md), so the string is expanded into all three.
// An empty string is checked before that, so it costs one stderr line, not one per expanded field.
if (typeof profile.language === "string" && profile.language)
    profile.language = { reports: profile.language, team: profile.language, docs: profile.language }
// Any other type, or a field that is not a non-empty string, is one line on stderr and the default below,
// as for a broken user.json: a silent en would hide the mistake. An absent language or field is silent.
if (profile.language !== undefined && (profile.language === null || typeof profile.language !== "object" || Array.isArray(profile.language))) {
    err(`profile: ${pjPath}: "language" must be an object such as {"team": "en"} or a language code, got ${JSON.stringify(profile.language)} — ignored`)
    profile.language = undefined
}
profile.language ??= {}
for (const k of ["reports", "team", "docs"]) {
    const v = profile.language[k]
    if (v === undefined || (typeof v === "string" && v)) continue
    err(`profile: ${pjPath}: language.${k} must be a language code such as "en", got ${JSON.stringify(v)} — ignored`)
    delete profile.language[k]
}

// User personalization (profiles/README.md): the language of reports belongs to the user, not to the
// project, and lives in $HARNESS_HOME/user.json for every project. A broken file is one line on stderr and
// the next value below: it must not stop an agent from reading the profile.
const USER_JSON = path.join(HARNESS_HOME, "user.json")
const userReports = (() => {
    let text
    try {
        text = fs.readFileSync(USER_JSON, "utf8")
    } catch (e) {
        if (e.code !== "ENOENT") err(`profile: ${USER_JSON} cannot be read (${e.code || e.message}) — ignored`)
        return undefined
    }
    // Windows PowerShell 5 writes UTF-8 with a byte order mark; an empty file means nothing is set.
    text = text.replace(/^\uFEFF/, "")
    if (text.trim() === "") return undefined
    let user
    try {
        user = JSON.parse(text)
    } catch {
        err(`profile: ${USER_JSON} is not JSON — ignored`)
        return undefined
    }
    if (user === null || typeof user !== "object" || Array.isArray(user)) {
        err(`profile: ${USER_JSON} is not a JSON object — ignored`)
        return undefined
    }
    if (user.language === undefined) return undefined
    if (user.language === null || typeof user.language !== "object" || Array.isArray(user.language)) {
        err(`profile: ${USER_JSON}: "language" must be an object such as {"reports": "en"} — ignored`)
        return undefined
    }
    const reports = user.language.reports
    if (reports === undefined) return undefined
    if (typeof reports !== "string" || !reports.trim()) {
        err(`profile: ${USER_JSON}: language.reports must be a language code such as "en", got ${JSON.stringify(reports)} — ignored`)
        return undefined
    }
    return reports.trim()
})()
// language.reports: the user's file, then the profile's own field, then English. team and docs are the
// project's; unset they are English.
// shortcut: reads the profile's language.reports, remove after the next release
const profileReports = typeof profile.language.reports === "string" && profile.language.reports ? profile.language.reports : undefined
profile.language.reports = userReports ?? profileReports ?? "en"
for (const k of ["team", "docs"]) if (typeof profile.language[k] !== "string" || !profile.language[k]) profile.language[k] = "en"

// The four Harness paths are constants of the Harness, not facts of the project. A reader that still
// asks for them gets this Harness's own scripts: in schema 2 always (the file is not consulted), in
// schema 1 a value naming ~/.claude/bin/<script> (the pre-plugin Harness) is mapped onto the same
// script next to this one; null and any other value stay as they are.
const HARNESS_PATHS = [
    ["tickets", "status_tool", `${BIN}/ticket`],
    ["tickets", "epic_status", `${BIN}/epic-status`],
    ["workflow", "preflight", `${BIN}/preflight --epic <epic>`],
    ["numbering", "reserve_with", `${BIN}/preflight`],
]
const LEGACY_BIN = ["~/.claude/bin/", path.join(CLAUDE, "bin") + path.sep] // schema 1
for (const [group, field, value] of HARNESS_PATHS) {
    if (schema === 2) {
        if (profile[group] === null || typeof profile[group] !== "object") profile[group] = {}
        profile[group][field] = value
        continue
    }
    const g = profile[group]
    if (g === null || typeof g !== "object" || typeof g[field] !== "string") continue
    const prefix = LEGACY_BIN.find((p) => g[field].startsWith(p))
    if (prefix) g[field] = `${BIN}/${g[field].slice(prefix.length)}`
}

// The names of the document sections and marks that code parses (profiles/README.md): the ticket's "done"
// section, the mark of a manual item in it and the label of an ADR's status line. Absent or null — the
// English default, so every reader gets a value. A malformed value is one warning and the default, as with
// language.*: a typo must not stop the project from being read. tickets.trail_section is left as written:
// null there says the tickets have no file-list section, and the skills skip the step that reads it.
const DOC_HEADINGS = [
    ["tickets", "done_section", "## Done when"],
    ["tickets", "manual_mark", "manual"],
    ["docs", "adr_status_label", "Status"],
]
for (const [group, field, value] of DOC_HEADINGS) {
    if (profile[group] === null || typeof profile[group] !== "object" || Array.isArray(profile[group])) profile[group] = {}
    const given = profile[group][field]
    if (typeof given === "string" && given.trim()) continue
    if (given !== undefined && given !== null)
        err(`profile: ${pjPath}: ${group}.${field} must be a non-empty string or null, got ${JSON.stringify(given)} — ignored`)
    profile[group][field] = value
}
// docs.feature_pages (profiles/README.md): the optional folder of feature pages, with no default: absent says
// the project has none, and the skills skip the step. A malformed value is one warning and reads as absent.
const pages = profile.docs.feature_pages
if (pages !== undefined && pages !== null && !(typeof pages === "string" && pages.trim())) {
    err(`profile: ${pjPath}: docs.feature_pages must be a non-empty path or null, got ${JSON.stringify(pages)} — ignored`)
    delete profile.docs.feature_pages
}

let checkoutReal = null
if (checkout) {
    try {
        checkoutReal = fs.realpathSync(checkout)
    } catch {
        checkoutReal = checkout
    }
}
// The repositories of the project: every registry entry that names this profile (the same registry the
// workspace above is computed from). name — the folder name of the repository, used by a ticket's `Repo:` line.
const profileEntries = (cfg.repos || []).filter((r) => r && r.profile === name && typeof r.match === "string" && r.match)
const repos = profileEntries.map((r) => ({ name: path.basename(path.resolve(r.match)), path: path.resolve(r.match), gate_key: r.key ?? null }))
// The common parent of the project's repositories, whatever directory profile runs from (null with one repository).
function commonParent() {
    if (profileEntries.length < 2) return null
    let ws = path.resolve(profileEntries[0].match)
    for (const r of profileEntries.slice(1)) while (!under(path.resolve(r.match), ws) && ws !== path.dirname(ws)) ws = path.dirname(ws)
    return ws === path.dirname(ws) ? null : ws
}
const expandHome = (p) => (p === "~" || p.startsWith("~/") ? path.join(os.homedir(), p.slice(1)) : p)

// The gate before a merge: workflow.merge_gate is "each" (gate full on every PR after a rebase),
// "wave" (one gate full for the set of a wave's ready PRs, bin/wave-gate) or null / absent (none required);
// workflow.e2e_lock is the path of the e2e lock directory or null / absent (no lock). Any other value is a broken
// profile: a guessed one would decide whether a PR is merged without its gate, or two e2e runs share the screen.
// `~/` in e2e_lock is expanded; a relative path would depend on the directory a script runs from.
const MERGE_GATES = ["each", "wave"]
const CI_MODES = ["pr", "batch"]
if (profile.workflow !== null && typeof profile.workflow === "object") {
    const wf = profile.workflow
    if (wf.merge_gate !== undefined && wf.merge_gate !== null && !MERGE_GATES.includes(wf.merge_gate))
        die(1, `${pjPath}: workflow.merge_gate is "each", "wave" or null, got ${JSON.stringify(wf.merge_gate)} — broken profile`)
    if (wf.e2e_lock !== undefined && wf.e2e_lock !== null) {
        const lock = typeof wf.e2e_lock === "string" ? expandHome(wf.e2e_lock.trim()) : ""
        if (!lock || !path.isAbsolute(lock)) die(1, `${pjPath}: workflow.e2e_lock is an absolute path or null, got ${JSON.stringify(wf.e2e_lock)} — broken profile`)
        wf.e2e_lock = lock
    }
    // Where GitHub CI runs: workflow.ci is "pr" (on every PR head — the default, absent or
    // null resolves to it) or "batch" (once on the main branch per wave, with workflow.ci_batch_run, a command
    // where $ref is the branch). A guessed value would decide whether a PR is merged without its CI run.
    if (wf.ci === undefined || wf.ci === null) wf.ci = "pr"
    else if (!CI_MODES.includes(wf.ci)) die(1, `${pjPath}: workflow.ci is "pr", "batch" or null, got ${JSON.stringify(wf.ci)} — broken profile`)
    if (wf.ci_batch_run !== undefined && wf.ci_batch_run !== null && typeof wf.ci_batch_run !== "string")
        die(1, `${pjPath}: workflow.ci_batch_run is a command string or null, got ${JSON.stringify(wf.ci_batch_run)} — broken profile`)
    if (wf.ci === "batch" && !(typeof wf.ci_batch_run === "string" && wf.ci_batch_run.trim()))
        die(1, `${pjPath}: workflow.ci "batch" needs workflow.ci_batch_run, the command that starts the CI run on the main branch — broken profile`)
}

// The cross-machine gate: a project on two machines, one of which cannot run the other's gate
// full. cross_machine_gate is {label, role, exempt?, check?, checks_section} or null / absent (one machine — the
// skills skip the step). role "request" labels its PRs with shared code and does not merge them; "serve" checks,
// reports on and merges the labelled PRs, with check. exempt paths are as gh prints PR files: "/" separated, a
// trailing "/" is a folder; no quote or backslash, so a skill can read the printed list line by line. A guessed
// role would either merge a PR without the other machine's gate or leave it with nobody to merge it.
const CMG_ROLES = ["request", "serve"]
if (profile.cross_machine_gate !== undefined && profile.cross_machine_gate !== null) {
    const g = profile.cross_machine_gate
    const broken = (msg) => die(1, `${pjPath}: cross_machine_gate${msg} — broken profile`)
    const text = (v) => typeof v === "string" && v.trim() !== ""
    if (typeof g !== "object" || Array.isArray(g)) broken(` is an object {label, role, exempt?, check?, checks_section} or null, got ${JSON.stringify(g)}`)
    if (!CMG_ROLES.includes(g.role)) broken(`.role is "request" or "serve", got ${g.role === undefined ? "no role" : JSON.stringify(g.role)}`)
    if (!text(g.label)) broken(`.label is the name of the GitHub label, got ${g.label === undefined ? "no label" : JSON.stringify(g.label)}`)
    if (!text(g.checks_section))
        broken(`.checks_section is the heading of the PR description section with the commands for the serve machine, got ${g.checks_section === undefined ? "no checks_section" : JSON.stringify(g.checks_section)}`)
    if (g.exempt !== undefined && g.exempt !== null && !(Array.isArray(g.exempt) && g.exempt.every((p) => text(p) && !/["\\]/.test(p))))
        broken(`.exempt is a list of paths ("/" separated, no quote or backslash), got ${JSON.stringify(g.exempt)}`)
    if (g.check !== undefined && g.check !== null && !text(g.check)) broken(`.check is a command string or null, got ${JSON.stringify(g.check)}`)
    if (g.role === "serve" && !text(g.check)) broken(`: role "serve" needs check, the command that checks a labelled PR's branch on this machine`)
}

// The Pipeline of the project: its rules live in lib/pipeline.cjs, shared with bin/profile-set, which writes
// the field. A broken one is a broken profile: a guessed Pipeline would show a
// ticket on a Stage it is not on. No field (or null) — the default Pipeline; either way the result is
// _resolved.pipeline, workflow.pipeline stays as written.
const resolvedPipeline = resolvePipeline(profile.workflow)
if (resolvedPipeline.problem !== undefined) die(1, `${pjPath}: workflow.pipeline${resolvedPipeline.problem} — broken profile`)
const pipeline = resolvedPipeline.pipeline

// The Workflow folder — where the workflow files (tickets, the epic spec, the state file, ADRs, lessons) live
// (profiles/README.md, "Workflow folder"). Full mode: the root of the current working tree (they travel in the
// branch). Silent mode: workflow.folder; without it — the folder above the repositories of a project of several
// repositories, otherwise $HARNESS_HOME/projects/<name>/workflow. A relative workflow.folder would depend on
// the directory profile runs from — a broken profile.
let workflowFolder
if (profile.mode === "silent") {
    const wf = profile.workflow && typeof profile.workflow === "object" ? profile.workflow.folder : undefined
    if (typeof wf === "string" && wf.trim()) {
        workflowFolder = expandHome(wf.trim())
        if (!path.isAbsolute(workflowFolder)) die(1, `${pjPath}: workflow.folder ${JSON.stringify(wf)} is not an absolute path — broken profile`)
        workflowFolder = path.resolve(workflowFolder)
    } else if (wf === undefined || wf === null) {
        workflowFolder = commonParent() || path.join(HARNESS_HOME, "projects", name, "workflow")
    } else die(1, `${pjPath}: workflow.folder must be a path or null, got ${JSON.stringify(wf)} — broken profile`)
} else workflowFolder = checkoutReal || (workspace ? workspace.ws : null) || repoRoot || null

const resolved = {
    name,
    dir,
    gate_key: key,
    repo_root: repoRoot,
    checkout: checkoutReal,
    in_worktree: Boolean(!workspace && checkoutReal && checkoutReal !== canon),
    workspace: workspace ? workspace.ws : null,
    mode: profile.mode,
    workflow_folder: workflowFolder,
    repos,
    pipeline,
}
// Placeholders in profile values and the headings of rules.md that agents look for are English
// (profiles/README.md, "Placeholders"); the old Russian ones of profiles written before are printed in
// the English form for one release (lib/old-words.cjs, shared with hooks/session-start.mjs).
englishPlaceholders(profile)
const full = { ...profile, _resolved: resolved }
const rulesPath = path.join(dir, "rules.md")
// The `## Sources` section of rules.md is for whoever maintains the profile, not an instruction to the agent
// (profiles/README.md, "rules.md"): left out from a heading that starts with the word to the next `## ` heading,
// as hooks/session-start.mjs leaves it out.
function withoutSources(text) {
    let skip = false
    return text
        .split("\n")
        .filter((line) => {
            // shortcut: accepts the old Russian token, remove after the next release
            if (line.startsWith("## ")) skip = /^## (Sources|Источники)/.test(line)
            return !skip
        })
        .join("\n")
}
const rules = fs.existsSync(rulesPath) ? withoutSources(englishHeadings(fs.readFileSync(rulesPath, "utf8"))) : null

// --- output -----------------------------------------------------------------------
switch (mode) {
    case "name":
        out(name)
        break
    case "dir":
        out(dir)
        break
    case "rules":
        if (rules === null) err(`profile: ${rulesPath} does not exist`)
        else out(rules)
        break
    case "json":
        out(JSON.stringify(full, null, 2))
        break
    case "field": {
        let v = full
        for (const part of field.split(".")) {
            if (v !== null && typeof v === "object" && Object.prototype.hasOwnProperty.call(v, part)) v = v[part]
            else die(4, `field "${field}" is absent in profile "${name}"`)
        }
        out(typeof v === "string" ? v : JSON.stringify(v, null, 2))
        break
    }
    default:
        out(`profile: ${name} (${dir})`)
        if (workspace)
            out(
                `workspace: ${workspace.ws} (common directory of the profile's ${workspace.n} repositories, not a project repository itself)` +
                    (checkoutReal ? `   checkout: ${checkoutReal}` : "")
            )
        else out(
            `repo: ${repoRoot}` +
                (checkoutReal ? `   checkout: ${checkoutReal}${resolved.in_worktree ? " (worktree)" : ""}` : "")
        )
        // Silent mode is said in the summary itself: an agent that reads only the summary must know that the
        // workflow files are not in the repository. The Full mode summary stays as it was.
        if (profile.mode === "silent")
            out(`mode: silent   workflow folder: ${workflowFolder} (tickets, spec, state file, ADRs, lessons live there, not in the repository)`)
        out("--- profile.json")
        out(JSON.stringify(profile, null, 2))
        out("--- rules.md")
        out(rules === null ? "(no rules.md)" : rules)
}
