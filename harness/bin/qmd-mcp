#!/usr/bin/env node
// qmd-mcp — launches the qmd MCP server for Claude Code (harness/.mcp.json: the server `qmd` of the
// plugin; worfy registers the same command as `plugin_worfy_qmd`).
// Sets the models (0.6B embedding; Russian query expansion only for a project whose documents are
// in Russian), updates the global index in the background (git copy of main, project memory,
// lessons) and starts the server.
// Index: ~/.config/qmd/index.yml and ~/.cache/qmd/index.sqlite. Update log: ~/.cache/qmd/refresh.log.
// Disable the background update: QMD_MCP_NO_REFRESH=1.
//
// Consent: qmd downloads a missing model by itself on the first query, so
// the server starts only after the user agreed to download the models. The answer is the file
// $HARNESS_HOME/qmd-models, written by the worfy app: the first line `downloaded`
// or `skipped`, then the model URIs that were pulled.
//
// When qmd cannot run, one line in stderr names the reason and the grep fallback over the profile's
// qmd.fallback_grep, and `qmd mcp` is not started: exit 3 — no answer `downloaded`, or a node qmd dies on
// without a word (below 22.14, and 23.0 to 23.5) with no newer node of nvm that has qmd; exit 127 — no qmd.
"use strict"

const fs = require("node:fs")
const os = require("node:os")
const path = require("node:path")
const { spawn } = require("node:child_process")
const q = require("../lib/qmd-common.cjs")

const fail = (code, reason) => {
    process.stderr.write(`qmd-mcp: ${reason}, the server does not start; ${q.GREP_FALLBACK}\n`)
    process.exit(code)
}

const answer = q.answerLines()
if (answer[0] !== "downloaded") fail(3, `the qmd models were not downloaded with the user's consent (${q.answerFile()}: ${answer[0] || "no answer"})`)
const tooOld = q.nodeTooOld()
if (tooOld) {
    q.rerunOnNvmNode()
    fail(3, tooOld)
}
const qmd = q.findQmd()
if (!qmd) fail(127, "qmd not found in PATH or in the global folder of npm")

// The language of the project's documents, from the session's directory (the server starts there),
// before the chdir below. Not `ru`, no profile, no field — the default query expansion model of qmd.
const PROFILE_BIN = process.env.QMD_MCP_PROFILE_BIN || path.join(path.dirname(fs.realpathSync(__filename)), "profile") // override for tests
const language = q.runScript(PROFILE_BIN, ["--field", "language.docs"])
const lang = language.status === 0 ? language.stdout.trim() : ""
let generate = lang === "ru" ? q.RU_GENERATE_MODEL : q.DEFAULT_GENERATE_MODEL
// Only a model the user agreed to download: when the answer lists the models and this one is not
// among them but the other expansion model is, take that one rather than let qmd fetch a new one.
if (answer.some((line) => line.startsWith("hf:")) && !answer.includes(generate)) {
    const other = generate === q.RU_GENERATE_MODEL ? q.DEFAULT_GENERATE_MODEL : q.RU_GENERATE_MODEL
    if (answer.includes(other)) generate = other
}
// generate: in index.yml is not read by query (qmd 2.8.3), only the environment variable works
const env = q.qmdEnv({ QMD_EMBED_MODEL: q.EMBED_MODEL })
if (generate === q.RU_GENERATE_MODEL) env.QMD_GENERATE_MODEL = q.RU_GENERATE_MODEL
else delete env.QMD_GENERATE_MODEL

// Before the chdir: a relative EVAL_HARNESS_HOME resolves from the session's directory.
env.HARNESS_HOME = q.harnessHome()

// Always the global index: the session's cwd may contain a project .qmd/.
process.chdir(q.home())

fs.mkdirSync(q.cacheDir(), { recursive: true })
try {
    if (fs.statSync(q.logFile()).size > 1_000_000) fs.writeFileSync(q.logFile(), "")
} catch {}

if (fs.existsSync(q.lockDir()) && q.abandoned(q.lockDir())) q.dropLock()

// The lock exists for `qmd update` (git checkout in the shared copy); `qmd embed` has its own lock.
if (process.env.QMD_MCP_NO_REFRESH !== "1" && q.takeLock()) q.startUpdate("", false, env)

// node has no exec: the server is a child on this stdio, and this process ends with it. The client
// closes stdin to end the server, and qmd ends on that by itself.
const [command, args] = q.qmdCommand(qmd, ["mcp", ...process.argv.slice(2)])
const server = spawn(command, args, { stdio: "inherit", env, windowsHide: true })
for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) process.on(signal, () => server.kill(signal))
server.on("error", (error) => {
    process.stderr.write(`qmd-mcp: could not start ${qmd}: ${error.message}; ${q.GREP_FALLBACK}\n`)
    process.exit(127)
})
server.on("exit", (code, signal) => process.exit(code ?? 128 + (os.constants.signals[signal] || 0)))
