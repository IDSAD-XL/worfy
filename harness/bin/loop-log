#!/usr/bin/env node
// loop-log — the loops the call log saw (worfy-stuck-agents/07).
//
//   loop-log [--since <YYYY-MM-DD>]
//
// Reads <gate state>/calls/loops.jsonl, which the hook hooks/calls.mjs writes, and prints each would-deny
// line — an agent that repeated a call a 4th time — as its time, Session (with /<agent_id> for a Subagent),
// pattern and the start of its command, then the last line `cases: N (revisit at 3)`. --since leaves out
// the cases before that day (UTC). Three cases or more are the condition to come back to the loop detector
// with a hint to the agent and a refusal; until then the hook only writes, and nothing reaches the agent.
//
// The gate state is that of the gate (hooks/gate-paths.mjs: CLAUDE_GATE_STATE, else
// <Harness home>/gate/state). Exit codes: 0, also without the file (cases: 0); 2 — a wrong argument.
// Node only: the same code runs on macOS, Linux and Windows.

import fs from "node:fs"
import path from "node:path"
import { gateStateDir } from "../hooks/gate-paths.mjs"

const REVISIT_AT = 3
const USAGE = "usage: loop-log [--since <YYYY-MM-DD>]\n"

function args(argv) {
    let since = ""
    for (let i = 0; i < argv.length; i++) {
        const a = argv[i]
        if (a === "--help" || a === "-h") return { help: true }
        if (a === "--since" && /^\d{4}-\d{2}-\d{2}$/.test(argv[i + 1] ?? "")) since = argv[++i]
        else return null
    }
    return { since }
}

const parsed = args(process.argv.slice(2))
if (!parsed) {
    process.stderr.write(USAGE)
    process.exit(2)
}
if (parsed.help) {
    process.stdout.write(USAGE)
    process.exit(0)
}

let text = ""
try {
    text = fs.readFileSync(path.join(gateStateDir(), "calls", "loops.jsonl"), "utf8")
} catch {}

const oneLine = (value) => String(value ?? "").replace(/\s+/g, " ").trim()
let cases = 0
for (const line of text.split("\n")) {
    let entry
    try {
        entry = JSON.parse(line)
    } catch {
        continue
    }
    if (!entry || entry.level !== "would-deny" || typeof entry.t !== "string") continue
    if (parsed.since && entry.t.slice(0, 10) < parsed.since) continue
    cases++
    const who = entry.agent_id ? `${entry.session}/${entry.agent_id}` : entry.session
    process.stdout.write(`${entry.t}  ${oneLine(who)}  ${oneLine(entry.pattern)}  ${oneLine(entry.command)}\n`)
}
process.stdout.write(`cases: ${cases} (revisit at ${REVISIT_AT})\n`)
