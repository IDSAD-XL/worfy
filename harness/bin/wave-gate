#!/usr/bin/env node
// wave-gate — one `gate full` for the whole set of ready PRs of a wave, instead of a rebase and a
// `gate full` for every PR (skill epic-wave, section 4, "Gate before merge").
//
//   wave-gate check <state.json>   squash-merge the set in a temporary worktree, run `gate full` on it
//   wave-gate merge <state.json>   merge the checked set (or its green prefix) with `gh pr merge`
//   wave-gate ci <ci.json>         after the whole wave is merged: the one CI run of the wave on the main
//                                  branch (profile workflow.ci "batch")
//
// ci reads a file of its own: {repo, branch, remote?, ci, ci_batch_run} — ci and ci_batch_run are the
// profile's workflow.ci and workflow.ci_batch_run (a set's state file with these two keys works too, once its
// merge is not pending). ci "pr" — nothing is dispatched (CI=skipped, exit 0). ci "batch" — fetch, run
// ci_batch_run once with $ref replaced by the branch, then find the run: the URL the command printed, else
// `gh run list --commit <tip of the branch> --event workflow_dispatch [--workflow <the one the command names>]`.
// It adds ci_run: {status, command, commit, dispatched_at, output, lookups, run_id, url, superseded}. A second ci
// on the same file while the branch is still at the recorded commit never dispatches again: it only looks for
// the run when the first did not find it, at most CI_LOOKUPS calls, then the run is "not verified". When the
// branch has moved (a later wave reusing the file, a merge since), ci dispatches anew for the new tip and keeps
// the old record in ci_run.superseded. Neither check nor merge look at the PRs' checks or mergeStateStatus:
// with "batch" a PR has no CI run on its head.
// Exit codes of ci: 0 dispatched and found (or "pr"), 3 dispatched and not listed yet (CI_RUN=not-found: run ci
// again) or not listed after CI_LOOKUPS calls (CI_RUN=not-verified), 1 error or a failed dispatch (nothing
// recorded as dispatched).
//
// The state file is the input and the record. The orchestrator writes the input:
//   repo       absolute path of a checkout of the repository
//   branch     the main branch ("main"); its remote copy is <remote>/<branch>
//   remote     optional, "origin" by default
//   prs        [{number, head, labels, platform}] in merge order: head — the head SHA the PR was verified
//              on, labels — names, platform — true for a platform PR (the project's rules say which)
//   e2e_lock   path of the e2e lock directory (profile workflow.e2e_lock), or null — no lock
//   prepare    shell command that readies a fresh tree (profile commands.prepare_tree), or null
//   cross_machine_label  the label of a PR that waits for the gate of the other machine (profile
//              cross_machine_gate.label), or null — the project has no such label; missing (a state file
//              written before the field) — needs-mac-gate
//   main_lock  optional path of the main-branch lock; <git common dir>/main.lock by default
// `check` adds: base (SHA of <remote>/<branch>), excluded [{number, reason}], set (numbers), prefixes
// [{number, head, commit, tree}] — the tree after each PR of the set, runs [{role, size, tree, outcome, …}],
// status, and for red: culprit, green_prefix, green_tree; for a green repeat of a red run: flaky.
// `merge` adds merge: {merged: [{number, commit, tree}], status, stopped}.
//
// check:
//   - a PR with platform: true or the label cross_machine_label leaves the set with that reason (the
//     label's name): it is merged the old way (one at a time, rebase, its own gate full);
//   - a temporary worktree at a fixed path in the git directory, <git common dir>/worfy-wave-gate,
//     starts at base; each PR in order is `git merge --squash` + commit, as GitHub's squash merge does;
//     a conflict takes the PR out of the set with reason DIRTY;
//   - `GATE_SCOPE=all gate full` on the tree of the whole set, under the e2e lock. Green — status green.
//     Red — the same tree once more: green now — status green with flaky (the failures of the first run);
//     red again — bisection over the prefixes of the merge order: the shortest red prefix names the
//     culprit, the prefix before it is green_prefix. At most 2 + ceil(log2 N) finished gate runs; each of
//     them may take up to SCREEN_TRIES runs when the screen locks (below), so at most 3 * (2 + ceil(log2 N));
//   - "could not verify" (exit 3, 127, a signal, "nothing ran", the environment unavailable) — status
//     unverified: not green, nothing is merged; the next check tries that run again;
//   - every finished step is written to the state file at once. A check that was broken off (the
//     session ended) is resumed by running it again on the same file: finished gate runs are not
//     repeated, the worktree it left is reused. When <remote>/<branch> has moved since, the state is
//     reset and the set is checked again. The worktree is removed at the end and on an error; a signal
//     leaves it for the resume.
//   - one check per repository at a time: <git common dir>/worfy-wave-gate.pid (see guardPid).
// merge (status green: the set; status red: green_prefix), under the main-branch lock:
//   - fetch; <remote>/<branch> must still be base, else no merge at all: "base moved";
//     resumed after a break, it must still be the commit of the last recorded merge;
//   - each PR: `gh pr merge <N> --squash --match-head-commit <head>`, fetch, and the tree of the main
//     branch must equal the checked tree of that prefix; the first mismatch stops: no further merges,
//     the reason goes to the state file — then gate full on the main branch.
//
// The screen (macOS: a locked screen shows no Electron window, and every e2e fails on its first window):
//   - when `ioreg` is in PATH, check asks `ioreg -n Root -d1` for "IOConsoleLocked" before each gate run;
//     Yes — one line "screen locked: gate full waits", a poll every 30 s, no gate run and no e2e lock held
//     until it is No. No `ioreg` in PATH (Linux, Windows) — no check;
//   - a red gate run whose failed scripts (the "[gate] red (…): <labels>" line) include one that opens
//     Electron windows — test:e2e or test:package — while the screen was locked during the run, is not red:
//     it is recorded as not verified ("screen locked") and run again after the unlock, at most
//     SCREEN_TRIES runs; then check ends unverified. The e2e message itself ("the window was not shown
//     within 30 s") is not looked for: the gate keeps only the last 40 lines of a failed script;
//   - when `caffeinate` is in PATH, check and merge each start `caffeinate -d -w <own pid>`: the display
//     does not sleep while the command lives, and caffeinate ends with it, a SIGKILL included.
//
// The e2e lock has the semantics of the shared one-command lock of the project rules: mkdir; a lock
// older than 30 min counts as abandoned and is removed; a heartbeat `touch -c` every 5 min while it is
// held; released on exit and on error. While wave-gate holds it, the lock directory has holder.json —
// {"prs": [<numbers of the run>], "what": "gate-full", "pid", "host", "since", "child"} — so whoever waits sees who
// holds it and for which PRs; the file goes with the directory (the main-branch lock has none, see merge()).
// A lock older than 30 min is removed with its holder.json, and so is one whose holder.json names this host and a
// pid that is not running, with no running "child" (the gate it runs): a wave-gate killed without its handlers.
//
// Exit codes. check: 0 green (or nothing to check), 2 red, 3 unverified, 1 error. merge: 0 merged
// (or nothing to merge), 4 stopped (reason in the state file), 1 error or refused.
//
// Environment: WAVE_GATE_GATE — an executable used instead of `node <plugin>/hooks/gate.mjs` (it gets
// the argument `full`); WAVE_GATE_GH — an executable used instead of `gh` from PATH, also for a leading `gh` of the
// ci_batch_run command; a `.mjs` file in either runs with this node (Windows cannot start a shell script); WAVE_GATE_SCREEN_POLL_S — the screen poll (30); WAVE_GATE_LOCK_POLL_S, WAVE_GATE_LOCK_STALE_S, WAVE_GATE_HEARTBEAT_S — the e2e
// lock timings (20, 1800, 300); WAVE_GATE_MAIN_LOCK_POLL_S, WAVE_GATE_MAIN_LOCK_STALE_S — the main
// lock (30, 5400). Tests set them; the defaults are the project's.
"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")
const { spawn, spawnSync } = require("child_process")
// The git to start, with the variable of an eval run (EVAL_GIT).
const { git: GIT } = require("../hooks/eval-env.cjs")

const GATE_SCRIPT = path.join(__dirname, "..", "hooks", "gate.mjs")
const TREE_NAME = "worfy-wave-gate"
const SHA = /^[0-9a-f]{40}$/
const seconds = (name, dflt) => {
    const v = Number(process.env[name])
    return Number.isFinite(v) && v > 0 ? v : dflt
}
const E2E = { poll: seconds("WAVE_GATE_LOCK_POLL_S", 20), stale: seconds("WAVE_GATE_LOCK_STALE_S", 1800), beat: seconds("WAVE_GATE_HEARTBEAT_S", 300) }
const TAKEOVER_STALE_S = 60
const MAIN = { poll: seconds("WAVE_GATE_MAIN_LOCK_POLL_S", 30), stale: seconds("WAVE_GATE_MAIN_LOCK_STALE_S", 5400), beat: seconds("WAVE_GATE_HEARTBEAT_S", 300) }
const SCREEN = { poll: seconds("WAVE_GATE_SCREEN_POLL_S", 30) }
const SCREEN_TRIES = 3
// A gate label is "<project>/<workspace>:<script>"; these scripts start Electron and need a window.
const WINDOW_SCRIPT = /(?:^|:)test:(?:e2e|package)$/
// On Windows node gets no SIGTERM from another process (a kill ends it at once, see lock()), but Ctrl+Break in its
// console comes as SIGBREAK.
const SIGNALS = { SIGHUP: 1, SIGINT: 2, SIGTERM: 15, ...(process.platform === "win32" ? { SIGBREAK: 21 } : {}) }

class Fail extends Error {}
const fail = (msg) => {
    throw new Fail(msg)
}
const say = (msg) => process.stdout.write(`[wave-gate] ${msg}\n`)
const sleep = (s) => new Promise((r) => setTimeout(r, s * 1000))
const now = () => new Date().toISOString().replace(/\.\d+Z$/, "Z")

// --- what has to be undone on the way out ----------------------------------------------------
const held = { locks: new Map(), child: null, pidFile: null, tree: null, repo: null, awake: null }

function git(args, cwd, { allowFail = false } = {}) {
    const r = spawnSync(GIT, args, { cwd, encoding: "utf8", windowsHide: true, maxBuffer: 64 << 20 })
    if (r.error) fail(`git ${args.join(" ")}: ${r.error.message}`)
    if (!allowFail && r.status !== 0) fail(`git ${args.join(" ")} (exit ${r.status}): ${(r.stderr || "").trim().split("\n")[0]}`)
    return r
}
const out = (args, cwd) => git(args, cwd).stdout.trim()
const real = (p) => {
    try {
        return fs.realpathSync(p)
    } catch {
        return path.resolve(p)
    }
}

// --- the state file ----------------------------------------------------------------------------
function load(file) {
    let st
    try {
        st = JSON.parse(fs.readFileSync(file, "utf8"))
    } catch (e) {
        fail(`${file}: ${e.message}`)
    }
    if (!st || typeof st !== "object" || Array.isArray(st)) fail(`${file} is not a JSON object`)
    if (typeof st.repo !== "string" || !path.isAbsolute(st.repo) || !fs.existsSync(st.repo)) fail(`${file}: "repo" must be the absolute path of a checkout`)
    if (typeof st.branch !== "string" || !st.branch) fail(`${file}: "branch" must name the main branch`)
    if (st.remote !== undefined && (typeof st.remote !== "string" || !st.remote)) fail(`${file}: "remote" must be a remote name`)
    // A state file written before cross_machine_label existed has none: such a file meant the label wave-gate
    // used then, needs-mac-gate. null still means the project has no such label.
    if (!("cross_machine_label" in st)) st.cross_machine_label = "needs-mac-gate"
    for (const key of ["e2e_lock", "prepare", "cross_machine_label"])
        if (!(key in st) || (st[key] !== null && (typeof st[key] !== "string" || !st[key])))
            fail(`${file}: "${key}" must be present: a string or null (a missing one would silently run without it)`)
    if (st.e2e_lock !== null && !path.isAbsolute(st.e2e_lock)) fail(`${file}: "e2e_lock" must be an absolute path`)
    if (st.main_lock !== undefined && st.main_lock !== null && (typeof st.main_lock !== "string" || !path.isAbsolute(st.main_lock)))
        fail(`${file}: "main_lock" must be an absolute path`)
    if (!Array.isArray(st.prs)) fail(`${file}: "prs" must be a list`)
    const seen = new Set()
    for (const pr of st.prs) {
        if (!pr || !Number.isInteger(pr.number) || pr.number <= 0) fail(`${file}: every PR needs a positive integer "number"`)
        if (typeof pr.head !== "string" || !SHA.test(pr.head)) fail(`${file}: PR #${pr.number}: "head" must be a full SHA`)
        if (seen.has(pr.number)) fail(`${file}: PR #${pr.number} is listed twice`)
        seen.add(pr.number)
    }
    return st
}
function save(file, st) {
    const tmp = `${file}.tmp-${process.pid}`
    fs.writeFileSync(tmp, JSON.stringify(st, null, 2) + "\n")
    fs.renameSync(tmp, file)
}
const labelsOf = (pr) => (Array.isArray(pr.labels) ? pr.labels : []).map((l) => (typeof l === "string" ? l : l && l.name)).filter(Boolean)
const RESULT_KEYS = ["base", "excluded", "candidates", "set", "prefixes", "runs", "status", "flaky", "culprit", "green_prefix", "green_tree", "error", "checked_at"]

// --- locks: a directory made by mkdir ---------------------------------------------------------------
const HOLDER = "holder.json"
// holder — what goes into <dir>/holder.json once the lock is taken (the e2e lock); none for the main lock.
async function lock(dir, t, what, holder) {
    let told = false
    for (;;) {
        try {
            fs.mkdirSync(dir)
            break
        } catch (e) {
            if (e.code !== "EEXIST") throw e
        }
        const dead = deadHolder(dir)
        if (dead && takeOver(dir, dead, what)) continue
        let m
        try {
            m = fs.statSync(dir).mtimeMs
        } catch {
            continue // released between mkdir and stat
        }
        // a dead lock whose takeover token is held is another waiter's to remove, however old it is
        if (!dead && (Date.now() - m) / 1000 > t.stale) {
            say(`${what} ${dir} is older than ${t.stale} s — abandoned, removed`)
            try {
                fs.rmSync(path.join(dir, HOLDER), { force: true })
                fs.rmdirSync(dir)
            } catch {}
            continue
        }
        if (!told) say(`waiting for ${what} ${dir}`)
        told = true
        await sleep(t.poll)
    }
    if (holder) {
        const record = { ...holder, pid: process.pid, host: os.hostname(), since: new Date().toISOString() }
        try {
            fs.writeFileSync(path.join(dir, HOLDER), JSON.stringify(record) + "\n")
        } catch (e) {
            say(`${what} ${dir} is held, but its ${HOLDER} could not be written: ${e.message}`)
        }
    }
    // touch -c: a lock someone else removed is not created again by the heartbeat
    const beat = setInterval(() => {
        try {
            const d = new Date()
            fs.utimesSync(dir, d, d)
        } catch {
            clearInterval(beat)
        }
    }, t.beat * 1000)
    held.locks.set(dir, beat)
}
// The holder.json of a lock whose wave-gate is gone, or null. A wave-gate stopped without its signal handlers
// (SIGKILL; on Windows a kill from any other process, taskkill /F or Git Bash's kill) leaves its lock, and waiting
// for the lock to grow stale would hold every later run for half an hour. Its child (the gate, which runs the e2e)
// may outlive it off Windows (on Windows libuv's job object ends node's children with node), so a holder with a
// `child` that runs is not dead either (noteChild). Only a holder.json with this
// machine's host is judged by its pids: the pid of another machine means nothing here, and the one-PR block of
// skills/epic-wave writes no host and the pid of its shell, which in Git Bash is not a Windows pid.
// shortcut: a child of the gate (an e2e script) that outlives both is not seen; redo with the pids of the whole tree
// when such an orphan is reported.
function deadHolder(dir) {
    let text, record
    try {
        text = fs.readFileSync(path.join(dir, HOLDER), "utf8")
        record = JSON.parse(text)
    } catch {
        return null
    }
    const gone = (pid) => Number.isInteger(pid) && pid > 0 && pid !== process.pid && !pidAlive(pid)
    if (record?.host !== os.hostname() || !gone(record.pid)) return null
    if (record.child !== undefined && !gone(record.child)) return null
    return { text, pid: record.pid }
}
// Takes the lock of a dead holder. Of two waiters only one may remove it, or the second removes the lock the first
// has just made. A rename does not decide that on Windows: libuv renames through a handle it opened, and two renames
// of one path both succeed, the second moving what the first has moved. So a waiter first makes
// `<lock>.takeover` with mkdir, and under it reads the holder.json again: the lock goes only while it is still the
// dead holder's. A token older than TAKEOVER_STALE_S is left by a waiter killed in those milliseconds and is removed.
// false — another waiter takes the lock over right now: the caller waits as for a live lock.
function takeOver(dir, dead, what) {
    const token = `${dir}.takeover`
    try {
        fs.mkdirSync(token)
    } catch (e) {
        if (e.code !== "EEXIST") throw e
        try {
            if ((Date.now() - fs.statSync(token).mtimeMs) / 1000 > TAKEOVER_STALE_S) fs.rmdirSync(token)
        } catch {}
        return false
    }
    try {
        let got = null
        try {
            got = fs.readFileSync(path.join(dir, HOLDER), "utf8")
        } catch {}
        if (got !== dead.text) return true
        say(`${what} ${dir} is held by pid ${dead.pid}, which is not running — abandoned, removed`)
        fs.rmSync(path.join(dir, HOLDER), { force: true })
        // A waiter that is reading the removed holder.json right now keeps it in the directory on Windows until
        // it closes the file, and rmdir fails meanwhile.
        for (let i = 0; ; i++) {
            try {
                fs.rmdirSync(dir)
                break
            } catch (e) {
                if (e.code === "ENOENT") break
                if (i === 50) {
                    say(`${what} ${dir} could not be removed: ${e.message}`)
                    break
                }
                Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 20)
            }
        }
        return true
    } finally {
        try {
            fs.rmdirSync(token)
        } catch {}
    }
}
// The child a run starts while it holds a lock goes into the lock's holder.json (null — it has ended), so a
// waiter does not take the lock of a killed wave-gate while its gate still runs the e2e (deadHolder).
function noteChild(pid) {
    for (const dir of held.locks.keys()) {
        const file = path.join(dir, HOLDER)
        try {
            const record = JSON.parse(fs.readFileSync(file, "utf8"))
            if (record.pid !== process.pid) continue
            if (pid === null) delete record.child
            else record.child = pid
            fs.writeFileSync(file, JSON.stringify(record) + "\n")
        } catch {}
    }
}
function unlock(dir) {
    const beat = held.locks.get(dir)
    if (beat === undefined) return
    clearInterval(beat)
    held.locks.delete(dir)
    // Only our own holder.json goes: a lock someone else took over after ours was removed as abandoned keeps
    // its file, and with it the directory (rmdir of a non-empty directory fails).
    const file = path.join(dir, HOLDER)
    try {
        if (JSON.parse(fs.readFileSync(file, "utf8")).pid === process.pid) fs.rmSync(file, { force: true })
    } catch {}
    try {
        fs.rmdirSync(dir)
    } catch {}
}

// --- the screen ------------------------------------------------------------------------------------
// true — locked; false — not locked, or no `ioreg` in PATH (spawn fails with ENOENT), or no answer.
function screenLocked() {
    const r = spawnSync("ioreg", ["-n", "Root", "-d1"], { encoding: "utf8", windowsHide: true, maxBuffer: 16 << 20 })
    if (r.error || r.status !== 0) return false
    return /"IOConsoleLocked"\s*=\s*Yes\b/.test(r.stdout || "")
}
async function screenWait() {
    if (!screenLocked()) return
    say("screen locked: gate full waits")
    do {
        await sleep(SCREEN.poll)
    } while (screenLocked())
}
// Samples the screen during a gate run; stop() tells whether it was seen locked at any sample or at the end.
function screenWatch() {
    let seen = false
    const t = setInterval(() => {
        if (!seen && screenLocked()) seen = true
    }, SCREEN.poll * 1000)
    return {
        stop() {
            clearInterval(t)
            return seen || screenLocked()
        },
    }
}
// caffeinate -d -w <own pid>: the display stays on while this command lives. -w makes caffeinate end with
// it even when nothing below runs (SIGKILL); the kill on the way out only makes that immediate.
function keepAwake() {
    let child
    try {
        child = spawn("caffeinate", ["-d", "-w", String(process.pid)], { stdio: "ignore", windowsHide: true })
    } catch {
        return
    }
    child.on("error", () => {}) // no caffeinate in PATH: the command goes on without it
    child.unref()
    held.awake = child
}
function letSleep() {
    if (held.awake && held.awake.exitCode === null && held.awake.signalCode === null)
        try {
            held.awake.kill()
        } catch {}
    held.awake = null
}

// --- the temporary worktree -----------------------------------------------------------------------
function commonDir(repo) {
    return real(out(["rev-parse", "--path-format=absolute", "--git-common-dir"], repo))
}
function registered(repo, dir) {
    const list = out(["worktree", "list", "--porcelain"], repo)
    return list.split("\n").some((l) => l.startsWith("worktree ") && real(l.slice(9)) === dir)
}
function openTree(repo, dir, at) {
    git(["worktree", "prune"], repo)
    if (registered(repo, dir)) {
        say(`reusing the worktree ${dir} left by an earlier run`)
        git(["reset", "-q", "--hard", at], dir)
        git(["clean", "-fdqx", "-e", "node_modules"], dir)
    } else {
        fs.rmSync(dir, { recursive: true, force: true })
        git(["worktree", "add", "-q", "--detach", dir, at], repo)
    }
    held.tree = dir
    held.repo = repo
}
function closeTree() {
    if (!held.tree) return
    const r = git(["worktree", "remove", "--force", held.tree], held.repo, { allowFail: true })
    if (r.status !== 0) {
        fs.rmSync(held.tree, { recursive: true, force: true })
        git(["worktree", "prune"], held.repo, { allowFail: true })
    }
    held.tree = null
}
// One check per repository at a time: <git common dir>/worfy-wave-gate.pid, created with O_EXCL ("wx"), so two
// checks that start together cannot both get it. A file whose pid is dead, or which stays without a pid for
// longer than PID_EMPTY_S (its writer died between open and write), is stale. It is taken over by renaming it
// to a name of our own first: only one of two racing checks gets the rename, and the file it got is read again —
// if it is not the stale one it saw (another check took over and wrote a live pid in between), it is put back
// with link(), which fails rather than overwrite a newer file, and this check gives way.
const PID_EMPTY_S = 10
const pidAlive = (pid) => {
    try {
        process.kill(pid, 0)
        return true
    } catch (e) {
        return e.code === "EPERM"
    }
}
function pidState(file) {
    let text, st
    try {
        st = fs.statSync(file)
        text = fs.readFileSync(file, "utf8")
    } catch (e) {
        if (e.code === "ENOENT") return { gone: true }
        throw e
    }
    const pid = Number(text.trim())
    if (Number.isInteger(pid) && pid > 0) return { text, pid, live: pidAlive(pid) }
    return { text, pid: null, live: (Date.now() - st.mtimeMs) / 1000 <= PID_EMPTY_S }
}
function guardPid(common) {
    const file = path.join(common, `${TREE_NAME}.pid`)
    for (let attempt = 0; attempt < 5; attempt++) {
        let fd
        try {
            fd = fs.openSync(file, "wx")
        } catch (e) {
            if (e.code !== "EEXIST") throw e
        }
        if (fd !== undefined) {
            fs.writeSync(fd, `${process.pid}\n`)
            fs.closeSync(fd)
            held.pidFile = file
            return
        }
        const seen = pidState(file)
        if (seen.gone) continue
        if (seen.live) fail(`another wave-gate check runs in this repository (${seen.pid ? `pid ${seen.pid}` : "its pid is being written"}, ${file})`)
        const aside = `${file}.stale-${process.pid}`
        try {
            fs.renameSync(file, aside)
        } catch (e) {
            if (e.code === "ENOENT") continue
            throw e
        }
        const got = fs.readFileSync(aside, "utf8")
        if (got !== seen.text) {
            try {
                fs.linkSync(aside, file)
            } catch {}
            fs.rmSync(aside, { force: true })
            fail(`another wave-gate check took over ${file} at the same moment`)
        }
        say(`${file} named ${seen.pid ? `pid ${seen.pid}, which is not running` : "no pid for over " + PID_EMPTY_S + " s"} — stale, taken over`)
        fs.rmSync(aside, { force: true })
    }
    fail(`could not create ${file}`)
}
function releasePid() {
    if (!held.pidFile) return
    // Only our own: a file another check wrote after ours was taken over stays.
    try {
        if (fs.readFileSync(held.pidFile, "utf8").trim() === String(process.pid)) fs.rmSync(held.pidFile, { force: true })
    } catch {}
    held.pidFile = null
}

// --- a child process, killable on a signal ------------------------------------------------------------
function run(cmd, args, opts, logFile) {
    return new Promise((resolve) => {
        let text = ""
        const log = fs.createWriteStream(logFile, { flags: "a" })
        let child
        try {
            child = spawn(cmd, args, { ...opts, stdio: ["ignore", "pipe", "pipe"], windowsHide: true })
        } catch (e) {
            log.end(`${e.message}\n`)
            return resolve({ code: 127, text: e.message })
        }
        held.child = child
        noteChild(child.pid ?? null)
        const take = (b) => {
            text += b
            log.write(b)
        }
        child.stdout.on("data", take)
        child.stderr.on("data", take)
        child.on("error", (e) => {
            text += `${e.message}\n`
        })
        child.on("close", (code, signal) => {
            held.child = null
            noteChild(null)
            log.end()
            resolve({ code: code ?? (signal ? 128 + (os.constants.signals[signal] || 0) : 127), text })
        })
    })
}

// [file, args] of a program a test may stand in for: `usual` without an override, a `.mjs` override with this
// node, any other override as it is.
function program(override, usual) {
    if (!override) return [usual, []]
    if (override.endsWith(".mjs")) return [process.execPath, [override]]
    return [override, []]
}
// A shell command whose first word is gh, with that word run as WAVE_GATE_GH (quoted for sh and cmd.exe);
// any other command, or no WAVE_GATE_GH, as it is.
function ghShell(command) {
    if (!process.env.WAVE_GATE_GH || !/^\s*gh(\s|$)/.test(command)) return command
    const [file, args] = program(process.env.WAVE_GATE_GH, "gh")
    return [file, ...args].map((a) => `"${a}"`).join(" ") + command.replace(/^\s*gh/, "")
}
function gateCommand() {
    if (process.env.WAVE_GATE_GATE) {
        const [file, args] = program(process.env.WAVE_GATE_GATE)
        return [file, [...args, "full"]]
    }
    return [process.execPath, [GATE_SCRIPT, "full"]]
}
// The verdict lines of the gate: "[gate] green (full): …" and "[gate] red (full): <failed> (passed: <passed>)".
// shortcut: accepts the old Russian token, remove after the next release
// A gate of the release before prints the same lines with Russian words in place of green, red and passed.
const GREEN_FULL = /^\[gate\] (?:green|зелено) \(full\)/
// shortcut: accepts the old Russian token, remove after the next release
const RED_LINE = /^\[gate\] (?:red|красно) \([^)]*\):/
// shortcut: accepts the old Russian token, remove after the next release
const PASSED_TAIL = /\((?:passed|прошло):.*$/
function verdict(code, text) {
    const lines = text.split(/\r?\n/)
    if (code === 0 && lines.some((l) => GREEN_FULL.test(l))) return "green"
    if (code === 2) return "red"
    return "unverified"
}
function failures(text) {
    const lines = text.split(/\r?\n/)
    const red = lines.find((l) => RED_LINE.test(l))
    const scripts = red ? red.replace(RED_LINE, "").replace(PASSED_TAIL, "").trim().split(/\s+/).filter(Boolean) : []
    const tests = [...new Set(lines.filter((l) => /^\s*(FAIL|✘|×|✗)\s+\S/.test(l)).map((l) => l.trim()))].slice(0, 30)
    return { scripts, tests }
}

// --- check ---------------------------------------------------------------------------------------------
async function check(file) {
    const st = load(file)
    if (st.merge && Array.isArray(st.merge.merged) && st.merge.merged.length)
        fail(`${file}: the merge of this set has started (${st.merge.merged.length} merged) — a new set needs a new state file`)
    const remote = st.remote || "origin"
    const repo = st.repo
    const common = commonDir(repo)
    guardPid(common)
    git(["fetch", "-q", remote, `+refs/heads/${st.branch}:refs/remotes/${remote}/${st.branch}`], repo)
    const baseNow = out(["rev-parse", `refs/remotes/${remote}/${st.branch}^{commit}`], repo)
    if (st.base && st.base !== baseNow) {
        say(`${remote}/${st.branch} moved (${st.base.slice(0, 8)} -> ${baseNow.slice(0, 8)}): the set is checked again`)
        st.resets = [...(st.resets || []), { at: now(), from: st.base, to: baseNow }]
        for (const k of RESULT_KEYS) delete st[k]
    }
    if (["green", "red", "empty"].includes(st.status)) {
        summary(st)
        return codeOf(st.status)
    }
    if (Array.isArray(st.runs)) st.runs = st.runs.filter((r) => r.outcome === "green" || r.outcome === "red")
    delete st.error
    if (!st.base) {
        st.base = baseNow
        st.excluded = []
        st.candidates = []
        st.prefixes = []
        st.runs = []
        for (const pr of st.prs) {
            if (pr.platform === true) st.excluded.push({ number: pr.number, reason: "platform" })
            else if (st.cross_machine_label !== null && labelsOf(pr).includes(st.cross_machine_label)) st.excluded.push({ number: pr.number, reason: st.cross_machine_label })
            else st.candidates.push(pr.number)
        }
    }
    st.status = "checking"
    save(file, st)
    const ctx = { st, file, repo, remote, dir: path.join(common, TREE_NAME), logs: `${file}.logs` }
    fs.mkdirSync(ctx.logs, { recursive: true })
    openTree(repo, ctx.dir, st.base)
    squashAll(ctx)
    if (!st.set.length) return finish(ctx, "empty")

    const N = st.set.length
    const first = await gateOn(ctx, N, "full")
    if (first.outcome !== "red") return finish(ctx, first.outcome)
    const again = await gateOn(ctx, N, "retry")
    if (again.outcome === "unverified") return finish(ctx, "unverified")
    if (again.outcome === "green") {
        st.flaky = failures(fs.readFileSync(first.log, "utf8"))
        return finish(ctx, "green")
    }
    // The empty prefix (base) is taken as green: a red base names the first PR, and nothing is merged.
    let lo = 0
    let hi = N
    while (hi - lo > 1) {
        const mid = Math.floor((lo + hi) / 2)
        const r = await gateOn(ctx, mid, "bisect")
        if (r.outcome === "unverified") return finish(ctx, "unverified")
        if (r.outcome === "green") lo = mid
        else hi = mid
    }
    st.culprit = st.set[hi - 1]
    st.green_prefix = st.set.slice(0, lo)
    st.green_tree = lo === 0 ? out(["rev-parse", `${st.base}^{tree}`], repo) : st.prefixes[lo - 1].tree
    return finish(ctx, "red")
}

function haveCommit(repo, sha) {
    return git(["cat-file", "-e", `${sha}^{commit}`], repo, { allowFail: true }).status === 0
}
function fetchHead(ctx, pr) {
    if (haveCommit(ctx.repo, pr.head)) return true
    git(["fetch", "-q", ctx.remote, `refs/pull/${pr.number}/head`], ctx.repo, { allowFail: true })
    if (haveCommit(ctx.repo, pr.head)) return true
    git(["fetch", "-q", ctx.remote, pr.head], ctx.repo, { allowFail: true })
    return haveCommit(ctx.repo, pr.head)
}
function squashAll(ctx) {
    const { st, dir } = ctx
    const done = new Set([...st.prefixes.map((p) => p.number), ...st.excluded.map((e) => e.number)])
    for (const p of st.prefixes) if (!haveCommit(ctx.repo, p.commit)) fail(`the squash commit of PR #${p.number} is gone — start from a fresh state file`)
    for (const n of st.candidates) {
        if (done.has(n)) continue
        const pr = st.prs.find((p) => p.number === n)
        const tip = st.prefixes.length ? st.prefixes[st.prefixes.length - 1].commit : st.base
        git(["reset", "-q", "--hard", tip], dir)
        git(["clean", "-fdqx", "-e", "node_modules"], dir)
        if (!fetchHead(ctx, pr)) {
            st.excluded.push({ number: n, reason: "head-missing", detail: `${pr.head} is not in ${ctx.repo} or ${ctx.remote}` })
            save(ctx.file, st)
            continue
        }
        const m = git(["merge", "--squash", "--no-verify", pr.head], dir, { allowFail: true })
        if (m.status !== 0) {
            const unmerged = out(["diff", "--name-only", "--diff-filter=U"], dir).split("\n").filter(Boolean)
            if (!unmerged.length) fail(`git merge --squash of PR #${n} failed without a conflict: ${(m.stderr || m.stdout).trim().split("\n")[0]}`)
            git(["reset", "-q", "--hard", tip], dir)
            st.excluded.push({ number: n, reason: "DIRTY", detail: unmerged.join(" ") })
            say(`PR #${n} conflicts with the set (${unmerged.join(" ")}): out of the set, DIRTY`)
            save(ctx.file, st)
            continue
        }
        git(
            ["-c", "user.name=wave-gate", "-c", "user.email=wave-gate@localhost", "-c", "commit.gpgsign=false", "commit", "-q", "--no-verify", "--allow-empty", "-m", `wave-gate: squash of #${n}`],
            dir
        )
        const commit = out(["rev-parse", "HEAD"], dir)
        st.prefixes.push({ number: n, head: pr.head, commit, tree: out(["rev-parse", "HEAD^{tree}"], dir) })
        save(ctx.file, st)
    }
    st.set = st.prefixes.map((p) => p.number)
    save(ctx.file, st)
}

// One gate run on the first `size` PRs of the set; a finished run of the same role and size is not repeated.
// A run the locked screen spoiled is run again after the unlock, SCREEN_TRIES runs in all.
async function gateOn(ctx, size, role) {
    const done = ctx.st.runs.find((r) => r.role === role && r.size === size && (r.outcome === "green" || r.outcome === "red"))
    if (done) return done
    for (let i = 1; ; i++) {
        const rec = await gateOnce(ctx, size, role)
        if (!rec.screen_locked || i >= SCREEN_TRIES) return rec
        say(`screen locked during gate full: the run is not verified (an e2e failed under the lock) — run again after the unlock (${i}/${SCREEN_TRIES})`)
    }
}
async function gateOnce(ctx, size, role) {
    const { st, dir } = ctx
    const commit = size === 0 ? st.base : st.prefixes[size - 1].commit
    // Ignored files go too (a build output of a bigger prefix must not reach a run of a smaller one);
    // node_modules stays, and prepare brings it to this tree.
    git(["reset", "-q", "--hard", commit], dir)
    git(["clean", "-fdqx", "-e", "node_modules"], dir)
    const tree = out(["rev-parse", "HEAD^{tree}"], dir)
    const log = path.join(ctx.logs, `${String(st.runs.length + 1).padStart(2, "0")}-${role}-${size}.log`)
    fs.writeFileSync(log, "")
    const rec = { role, size, prs: st.set.slice(0, size), tree, at: now(), log }
    if (st.prepare) {
        const p = await run(st.prepare, [], { cwd: dir, shell: true, env: process.env }, log)
        if (p.code !== 0) {
            Object.assign(rec, { outcome: "unverified", exit: p.code, reason: `prepare failed (exit ${p.code})` })
            st.runs.push(rec)
            save(ctx.file, st)
            say(`run ${role} on ${size} PR(s): could not prepare the tree (exit ${p.code}) — see ${log}`)
            return rec
        }
    }
    let g, locked
    try {
        // The screen is checked before the e2e lock is taken (a wait does not hold it) and again once it is
        // held: waiting for the lock may take a whole gate run of another agent.
        for (;;) {
            await screenWait()
            if (st.e2e_lock) await lock(st.e2e_lock, E2E, "the e2e lock", { prs: rec.prs, what: "gate-full" })
            if (!screenLocked()) break
            if (st.e2e_lock) unlock(st.e2e_lock)
        }
        const [cmd, args] = gateCommand()
        say(`gate full on ${size} PR(s) (${role}): #${rec.prs.join(" #")}`)
        const watch = screenWatch()
        try {
            g = await run(cmd, args, { cwd: dir, env: { ...process.env, GATE_SCOPE: "all" } }, log)
        } finally {
            locked = watch.stop()
        }
    } finally {
        if (st.e2e_lock) unlock(st.e2e_lock)
    }
    Object.assign(rec, { outcome: verdict(g.code, g.text), exit: g.code })
    if (rec.outcome === "red" && locked && failures(g.text).scripts.some((s) => WINDOW_SCRIPT.test(s)))
        Object.assign(rec, { outcome: "unverified", screen_locked: true, reason: "screen locked: an e2e script failed while the screen was locked" })
    if (rec.outcome === "red") Object.assign(rec, failures(g.text))
    st.runs.push(rec)
    save(ctx.file, st)
    say(`  -> ${rec.outcome} (exit ${g.code}); log ${log}`)
    return rec
}

function codeOf(status) {
    return { green: 0, empty: 0, red: 2, unverified: 3 }[status] ?? 1
}
function finish(ctx, status) {
    ctx.st.status = status
    ctx.st.checked_at = now()
    closeTree()
    save(ctx.file, ctx.st)
    summary(ctx.st)
    return codeOf(status)
}
function summary(st) {
    const ex = (st.excluded || []).map((e) => `#${e.number} (${e.reason})`).join(", ") || "none"
    say(`status: ${st.status}; base ${String(st.base).slice(0, 12)}; set: ${(st.set || []).map((n) => "#" + n).join(" ") || "empty"}; out of the set: ${ex}; gate runs: ${(st.runs || []).length}`)
    if (st.status === "red") say(`culprit: #${st.culprit}; green prefix: ${st.green_prefix.map((n) => "#" + n).join(" ") || "none"} (tree ${String(st.green_tree).slice(0, 12)})`)
    if (st.flaky) say(`flaky on the first run: ${[...st.flaky.scripts, ...st.flaky.tests].join("; ")}`)
    if (st.status === "unverified") say("not verified: nothing is merged; fix the cause and run check again")
    if (st.merge) say(`merge: ${st.merge.status}; merged ${st.merge.merged.map((m) => "#" + m.number).join(" ") || "none"}${st.merge.stopped ? `; stopped at #${st.merge.stopped.number}: ${st.merge.stopped.reason}` : ""}`)
    process.stdout.write(`STATUS=${st.status}\n`)
}

// --- merge ----------------------------------------------------------------------------------------------
async function merge(file) {
    const st = load(file)
    if (st.status !== "green" && st.status !== "red" && st.status !== "empty") fail(`status is ${st.status ?? "not checked"}: nothing is merged (run check first)`)
    const list = st.status === "green" ? st.set : st.status === "red" ? st.green_prefix : []
    st.merge = st.merge || { merged: [], status: "pending" }
    if (st.merge.status === "stopped") {
        summary(st)
        say("this merge stopped earlier: no further merges from this state file")
        return 4
    }
    if (!list.length || st.merge.merged.length >= list.length) {
        st.merge.status = "done"
        save(file, st)
        summary(st)
        return 0
    }
    const remote = st.remote || "origin"
    const repo = st.repo
    const mainLock = st.main_lock || path.join(commonDir(repo), "main.lock")
    const stop = (number, reason) => {
        st.merge.status = "stopped"
        st.merge.stopped = { number, reason, at: now() }
        save(file, st)
        summary(st)
        say(`stopped: no further merges. Run gate full on ${st.branch}, and check the set's PRs that are not merged again (a new state file).`)
        return 4
    }
    const treeOf = (n) => st.prefixes.find((p) => p.number === n).tree
    // No holder.json here: the main-branch blocks of skills/epic-wave and gate-queue share this lock and remove a stuck
    // one with a bare rmdir, which a file inside would stop. So a killed merge's lock waits for its age.
    await lock(mainLock, MAIN, "the main-branch lock")
    try {
        const fetch = () => {
            git(["fetch", "-q", remote, `+refs/heads/${st.branch}:refs/remotes/${remote}/${st.branch}`], repo)
            return out(["rev-parse", `refs/remotes/${remote}/${st.branch}^{commit}`], repo)
        }
        const tip = fetch()
        const k = st.merge.merged.length
        if (k === 0 && tip !== st.base) return stop(list[0], `base moved: ${remote}/${st.branch} is ${tip}, the set was checked on ${st.base}`)
        // Resuming after a break: the main branch must still be the commit our last merge made.
        if (k > 0 && tip !== st.merge.merged[k - 1].commit)
            return stop(list[k], `base moved: ${remote}/${st.branch} changed after the merge of #${st.merge.merged[k - 1].number}`)
        for (let i = k; i < list.length; i++) {
            const n = list[i]
            const pr = st.prs.find((p) => p.number === n)
            say(`gh pr merge ${n} --squash --match-head-commit ${pr.head}`)
            const [gh, ghArgs] = program(process.env.WAVE_GATE_GH, "gh")
            const r = spawnSync(gh, [...ghArgs, "pr", "merge", String(n), "--squash", "--match-head-commit", pr.head], { cwd: repo, encoding: "utf8", windowsHide: true })
            if (r.error || r.status !== 0) return stop(n, `gh pr merge failed (exit ${r.status ?? r.error.message}): ${(r.stderr || "").trim().split("\n")[0]}`)
            const sha = fetch()
            const tree = out(["rev-parse", `${sha}^{tree}`], repo)
            st.merge.merged.push({ number: n, commit: sha, tree, at: now() })
            save(file, st)
            if (tree !== treeOf(n)) return stop(n, `tree mismatch after #${n}: ${st.branch} has ${tree}, the checked prefix had ${treeOf(n)}`)
        }
        st.merge.status = "done"
        save(file, st)
        summary(st)
        return 0
    } finally {
        unlock(mainLock)
    }
}

// --- ci: the one CI run of a wave on the main branch (workflow.ci "batch") -----------------------------------
const CI_MODES = ["pr", "batch"]
// How many calls of ci may find no run for one dispatch before the run counts as not verified.
const CI_LOOKUPS = 6
const RUN_URL = /https?:\/\/\S+\/actions\/runs\/(\d+)/
function loadCi(file) {
    let st
    try {
        st = JSON.parse(fs.readFileSync(file, "utf8"))
    } catch (e) {
        fail(`${file}: ${e.message}`)
    }
    if (!st || typeof st !== "object" || Array.isArray(st)) fail(`${file} is not a JSON object`)
    if (typeof st.repo !== "string" || !path.isAbsolute(st.repo) || !fs.existsSync(st.repo)) fail(`${file}: "repo" must be the absolute path of a checkout`)
    // The branch goes into a shell command in place of $ref: only the characters of a plain branch name.
    if (typeof st.branch !== "string" || !/^[A-Za-z0-9._/-]+$/.test(st.branch)) fail(`${file}: "branch" must name the main branch`)
    if (st.remote !== undefined && (typeof st.remote !== "string" || !st.remote)) fail(`${file}: "remote" must be a remote name`)
    if (!CI_MODES.includes(st.ci)) fail(`${file}: "ci" must be "pr" or "batch" (profile workflow.ci), got ${JSON.stringify(st.ci)}`)
    if (st.ci === "batch" && !(typeof st.ci_batch_run === "string" && st.ci_batch_run.trim()))
        fail(`${file}: "ci" is "batch" but "ci_batch_run" (profile workflow.ci_batch_run) is not a command`)
    if (st.merge && st.merge.status === "pending") fail(`${file}: the merge of this set is not finished (merge.status pending): run merge first`)
    return st
}
// The run the dispatch created: the URL `gh workflow run` prints, else the newest workflow_dispatch run on the
// dispatched commit that was created after the dispatch (2 min for clock skew), of the workflow the command names.
async function findRun(st, text) {
    const m = RUN_URL.exec(text || "")
    if (m) return { run_id: Number(m[1]), url: m[0] }
    const args = ["run", "list", "--branch", st.branch, "--commit", st.ci_run.commit, "--event", "workflow_dispatch", "--json", "databaseId,url,createdAt", "--limit", "20"]
    const wf = /\bgh\s+workflow\s+run\s+([^\s-][^\s]*)/.exec(st.ci_run.command)
    if (wf) args.push("--workflow", wf[1])
    const since = Date.parse(st.ci_run.dispatched_at) - 120000
    const tries = seconds("WAVE_GATE_CI_TRIES", 12)
    for (let i = 0; i < tries; i++) {
        if (i) await sleep(seconds("WAVE_GATE_CI_POLL_S", 5))
        const [gh, ghArgs] = program(process.env.WAVE_GATE_GH, "gh")
        const r = spawnSync(gh, [...ghArgs, ...args], { cwd: st.repo, encoding: "utf8", windowsHide: true })
        if (r.error || r.status !== 0) continue
        let runs
        try {
            runs = JSON.parse(r.stdout)
        } catch {
            continue
        }
        const hit = (Array.isArray(runs) ? runs : [])
            .filter((x) => x && Number.isInteger(x.databaseId) && Date.parse(x.createdAt) >= since)
            .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))[0]
        if (hit) return { run_id: hit.databaseId, url: hit.url }
    }
    return null
}
async function ci(file) {
    const st = loadCi(file)
    if (st.ci === "pr") {
        say("workflow.ci is pr: CI runs on every PR head, no batch run is dispatched")
        process.stdout.write("CI=skipped\n")
        return 0
    }
    const remote = st.remote || "origin"
    const done = () => {
        say(`batch CI run on ${st.branch} ${String(st.ci_run.commit).slice(0, 12)}: ${st.ci_run.url}`)
        process.stdout.write(`CI_RUN=${st.ci_run.run_id} ${st.ci_run.url}\n`)
        return 0
    }
    // The tip of the branch now. A recorded dispatch counts only for that same commit: a file reused by a later
    // wave, or a branch that moved since, gets a new dispatch, and the old run is kept in ci_run.superseded.
    git(["fetch", "-q", remote, `+refs/heads/${st.branch}:refs/remotes/${remote}/${st.branch}`], st.repo)
    const commit = out(["rev-parse", `refs/remotes/${remote}/${st.branch}^{commit}`], st.repo)
    const prev = st.ci_run || {}
    if (!(prev.dispatched_at && prev.commit === commit)) {
        const superseded = [...(prev.superseded || [])]
        if (prev.dispatched_at) {
            superseded.push({ ...prev, superseded: undefined })
            say(`${st.branch} is at ${commit.slice(0, 12)}, the recorded run was for ${String(prev.commit).slice(0, 12)}: a new dispatch`)
        }
        const command = st.ci_batch_run.split("${ref}").join(st.branch).split("$ref").join(st.branch)
        say(`dispatch: ${command}`)
        const r = spawnSync(ghShell(command), { cwd: st.repo, shell: true, encoding: "utf8", windowsHide: true, timeout: 120000 })
        if (r.error || r.status !== 0) {
            st.ci_run = { status: "dispatch failed", command, commit, exit: r.status ?? null, error: ((r.stderr || "") + (r.error ? r.error.message : "")).trim().split("\n")[0], at: now(), superseded }
            save(file, st)
            fail(`the dispatch failed (exit ${r.status ?? r.error.message}): ${st.ci_run.error}; nothing is recorded as dispatched, run ci again`)
        }
        st.ci_run = { status: "dispatched", command, commit, dispatched_at: now(), output: `${r.stdout || ""}${r.stderr || ""}`.trim().slice(0, 2000), lookups: 0, superseded }
        save(file, st)
    } else if (prev.run_id) return done()
    else if (prev.status === "not verified") {
        say(`not verified: ${prev.reason}`)
        process.stdout.write("CI_RUN=not-verified\n")
        return 3
    }
    const run = await findRun(st, st.ci_run.output)
    if (!run) {
        st.ci_run.lookups = (st.ci_run.lookups || 0) + 1
        if (st.ci_run.lookups >= CI_LOOKUPS) {
            st.ci_run.status = "not verified"
            st.ci_run.reason = `dispatched at ${st.ci_run.dispatched_at}, but no workflow_dispatch run on ${commit} was listed after ${CI_LOOKUPS} calls of ci`
            save(file, st)
            say(`not verified: ${st.ci_run.reason}`)
            process.stdout.write("CI_RUN=not-verified\n")
            return 3
        }
        save(file, st)
        say(`dispatched at ${st.ci_run.dispatched_at}, but no workflow_dispatch run on ${commit.slice(0, 12)} is listed yet (call ${st.ci_run.lookups} of ${CI_LOOKUPS}): run ci again (it does not dispatch a second time)`)
        process.stdout.write("CI_RUN=not-found\n")
        return 3
    }
    Object.assign(st.ci_run, run, { status: "found" })
    save(file, st)
    return done()
}

// --- entry -------------------------------------------------------------------------------------------------
function release() {
    for (const dir of [...held.locks.keys()]) unlock(dir)
    releasePid()
}
for (const [sig, n] of Object.entries(SIGNALS))
    process.on(sig, () => {
        // A signal is a broken-off run: the worktree stays for the resume, the locks go.
        if (held.child) held.child.kill(sig)
        release()
        letSleep()
        process.stderr.write(`[wave-gate] stopped by ${sig}: the state file has every finished step; run the same command again to resume\n`)
        process.exit(128 + n)
    })

async function main() {
    const [cmd, file, ...rest] = process.argv.slice(2)
    if (!["check", "merge", "ci"].includes(cmd) || !file || rest.length) fail("usage: wave-gate check <state.json> | wave-gate merge <state.json> | wave-gate ci <state.json>")
    const abs = path.resolve(file)
    if (cmd === "ci") return ci(abs)
    keepAwake()
    if (cmd === "merge") return merge(abs)
    try {
        return await check(abs)
    } catch (e) {
        try {
            const st = JSON.parse(fs.readFileSync(abs, "utf8"))
            if (st && typeof st === "object" && st.status === "checking") {
                st.status = "error"
                st.error = e.message
                save(abs, st)
            }
        } catch {}
        throw e
    }
}
main().then(
    (code) => {
        closeTree()
        release()
        letSleep()
        process.exit(code)
    },
    (e) => {
        try {
            closeTree()
        } catch {}
        release()
        letSleep()
        process.stderr.write(`[wave-gate] error: ${e instanceof Fail ? e.message : e.stack || e}\n`)
        process.exit(1)
    }
)
