#!/usr/bin/env node
// worktree-lock — an advisory lock on a working tree. It answers the question
// "who else is writing into this folder right now", because git does not track that:
// two sessions in one tree edit the same files, and the last write wins.
//
// Subcommands (called from hooks, the event JSON is read from stdin):
//   claim    SessionStart — register in the tree and say who is already here
//   beat     Stop         — mark this session alive; speak up if the set of sessions changed
//   release  SessionEnd   — unregister
//   status   by hand      — show the tree's sessions to a human
//
// THE FIRST PROPERTY is to stay out of the way. Any failure in hook mode ends with exit 0 and
// silence: the lock is advisory, and failing a session start because of it is unacceptable.
//
// The registry lives OUTSIDE the repository: $HARNESS_HOME/worktree-sessions/<tree>.json
// (default ~/.claude/worfy-harness/worktree-sessions), so as not to drop foreign files into git's
// own directory. A session counts as alive if it marked itself within the last WORKTREE_LOCK_TTL_MIN minutes
// (default 60): Stop fires on every turn, so silence longer than
// an hour means the session was abandoned or crashed.

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import crypto from "node:crypto"
import { execFileSync } from "node:child_process"
// The git to start and the Harness state folder, with the variables of an eval run (EVAL_GIT, EVAL_HARNESS_HOME).
import { git as GIT, harnessHome } from "../hooks/eval-env.cjs"

const cmd = process.argv[2]
const HOOK = ["claim", "beat", "release"].includes(cmd)

// EPIPE on stdout arrives as an asynchronous event and bypasses the try/catch at the bottom of the file.
// For a hook any failure must be silent and exit 0.
process.stdout.on("error", () => {})
if (HOOK) process.on("uncaughtException", () => process.exit(0))
// An abandoned mutex: the critical section takes milliseconds, so anything
// older than this is a trace of a crashed process.
const MUTEX_STALE_MS = 15000

const main = () => {
    const TTL_MS = Math.max(0, Number(process.env.WORKTREE_LOCK_TTL_MIN ?? 60)) * 60000
    // $HOME where it is set, %USERPROFILE% on Windows without it.
    const home = os.homedir()
    if (!home) return

    const git = (args, cwd) => {
        try {
            return execFileSync(GIT, args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 2000 }).trim()
        } catch {
            return ""
        }
    }

    // stdin is read only for the hook subcommands: they have one and it gets closed. status
    // is called by hand, and reading from an open terminal would hang forever.
    let payload = {}
    if (HOOK) {
        try {
            const raw = fs.readFileSync(0, "utf8")
            if (raw.trim()) payload = JSON.parse(raw) ?? {}
        } catch {
            /* empty or broken payload — work from process.cwd() */
        }
    }
    if (typeof payload !== "object" || payload === null) payload = {}

    const cwd = typeof payload.cwd === "string" ? payload.cwd : process.cwd()
    const root = git(["rev-parse", "--show-toplevel"], cwd)
    if (!root) return // not a repository — nothing for the lock to hold on to

    const rawMe = payload.session_id || process.env.CLAUDE_SESSION_ID || process.env.CLAUDE_CODE_SESSION_ID || ""
    // __proto__ as a key would set the prototype instead of an own field.
    const me = rawMe === "__proto__" || rawMe === "constructor" ? "" : String(rawMe)
    const branch = HOOK ? git(["rev-parse", "--abbrev-ref", "HEAD"], cwd) : ""
    // A hash suffix of the full path: on its own the slug collapses Auction-sale-loop,
    // Auction/sale-loop and Auction_sale_loop into one name.
    const slug = `${root.replace(/[^A-Za-z0-9]+/g, "-").replace(/^-|-$/g, "")}-${crypto.createHash("sha1").update(root).digest("hex").slice(0, 8)}`
    // Harness state on this machine: $HARNESS_HOME/worktree-sessions (ADR-0040 item 5); in an eval
    // run, EVAL_HARNESS_HOME of the tree's repository.
    const dir = path.join(harnessHome(cwd), "worktree-sessions")
    const file = path.join(dir, `${slug}.json`)
    const now = Date.now()

    const short = (id) => String(id || "?").slice(0, 8)
    const ago = (t) => {
        const m = Math.round((now - t) / 60000)
        if (m < 1) return "just now"
        if (m < 60) return `${m} min ago`
        return `${Math.round(m / 60)} h ago`
    }
    const clock = (t) => new Date(t).toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit" })

    // An entry counts as valid only if both times are numbers and not from the future:
    // otherwise a forged started makes the session the holder forever.
    const sane = (e) =>
        e &&
        typeof e === "object" &&
        Number.isFinite(e.seen) &&
        Number.isFinite(e.started) &&
        e.seen <= now + 60000 &&
        e.started <= now + 60000 &&
        now - e.seen <= TTL_MS

    // fn gets the registry and may change it; writing to disk happens only under a held
    // mutex. If it was not taken, we work from what was read but do NOT write: without the lock
    // it is easy to overwrite other sessions' entries.
    let broken = false
    const withRegistry = (fn) => {
        let all = {}
        let readable = true
        try {
            const raw = fs.readFileSync(file, "utf8")
            const parsed = JSON.parse(raw)
            if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) all = parsed
            else readable = false
        } catch (e) {
            // No file — a normal first run. It exists but cannot be read or
            // parsed — other sessions' entries are intact, and they must not be overwritten.
            if (e.code !== "ENOENT") readable = false
        }

        const mutex = `${file}.lock`
        let held = false
        if (readable) {
            try {
                fs.mkdirSync(dir, { recursive: true })
                fs.accessSync(dir, fs.constants.W_OK)
                for (let i = 0; i < (cmd === "release" ? 150 : 50) && !held; i++) {
                    try {
                        fs.mkdirSync(mutex)
                        held = true
                    } catch {
                        try {
                            if (now - fs.statSync(mutex).mtimeMs > MUTEX_STALE_MS) fs.rmdirSync(mutex)
                        } catch {
                            /* already removed by someone else */
                        }
                        if (!held) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 20)
                    }
                }
                // Re-read under the lock: the registry may have changed between the first read and the capture.
                if (held) {
                    try {
                        const parsed = JSON.parse(fs.readFileSync(file, "utf8"))
                        if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) all = parsed
                    } catch {
                        /* no file yet — keep what was read */
                    }
                }
            } catch {
                held = false
            }
        }

        // A hook killed by a timeout leaves a .tmp behind; sweep the old ones.
        try {
            for (const f of fs.readdirSync(dir)) {
                if (!f.endsWith(".tmp")) continue
                const t = path.join(dir, f)
                if (now - fs.statSync(t).mtimeMs > MUTEX_STALE_MS) fs.unlinkSync(t)
            }
        } catch {
            /* the directory is missing or unreadable */
        }
        broken = !readable
        for (const [id, e] of Object.entries(all)) if (!sane(e)) delete all[id]

        try {
            fn(all) // fn prints the warning BEFORE the write: losing the told entry
            // is safer than losing the warning forever.
        } finally {
            if (held) {
                try {
                    const tmp = `${file}.${process.pid}.tmp`
                    fs.writeFileSync(tmp, JSON.stringify(all, null, 2) + "\n")
                    fs.renameSync(tmp, file)
                } catch {
                    /* not written — next time */
                } finally {
                    try {
                        fs.rmdirSync(mutex)
                    } catch {
                        /* already removed */
                    }
                }
            }
        }
        return all
    }

    // The holder is the earliest of the live entries: whoever came first is the one who writes.
    const digest = (ids) => `${ids.length}:${crypto.createHash("sha1").update(ids.join(",")).digest("hex").slice(0, 8)}`

    const holderOf = (all) => Object.entries(all).sort((a, b) => a[1].started - b[1].started)[0]

    const describe = (all) => {
        const others = Object.entries(all).filter(([id]) => id !== me)
        if (!others.length) return null
        const [hid, h] = holderOf(all)
        const card = ([id, e]) => `${short(id)} (since ${clock(e.started)}, last seen ${ago(e.seen)})`
        // List no more than three: in a tree with a hundred sessions the message
        // bloats both the context and the registry itself.
        const list = (xs) => xs.slice(0, 3).map(card).join("; ") + (xs.length > 3 ? ` and ${xs.length - 3} more` : "")
        if (hid === me) {
            return {
                ids: digest(others.map(([id]) => id).sort()),
                text: `The working tree ${root} is held by this session, but ${list(others)} are here too. Agree on edits before changing shared files.`,
            }
        }
        const rest = others.filter(([id]) => id !== hid)
        return {
            ids: digest(others.map(([id]) => id).sort()),
            text:
                `The working tree ${root} is held by session ${card([hid, h])}` +
                (rest.length ? `; besides it, here are ${list(rest)}` : "") +
                `. Reading and investigating is fine, but edit files only after agreeing: git does not reconcile parallel edits, the last write wins.`,
        }
    }

    if (cmd === "status") {
        const all = withRegistry(() => {})
        if (broken) {
            console.log(`${root}: registry unreadable, lock disabled — delete ${file}`)
            return
        }
        const entries = Object.entries(all).sort((a, b) => a[1].started - b[1].started)
        if (!entries.length) {
            console.log(`${root}: no live sessions recorded`)
            return
        }
        const [hid] = holderOf(all)
        console.log(`${root}:`)
        for (const [id, e] of entries) {
            console.log(`  ${id === hid ? "holds" : " also"} ${short(id)}  since ${clock(e.started)}  seen ${ago(e.seen)}${id === me ? "  ← this" : ""}`)
        }
        return
    }

    if (!me) return // without a session id there is no one to register

    const say = (event, said) => {
        if (!said) return
        process.stdout.write(JSON.stringify({ systemMessage: said.text, hookSpecificOutput: { hookEventName: event, additionalContext: said.text } }))
    }

    if (cmd === "claim") {
        withRegistry((all) => {
            all[me] = { started: sane(all[me]) ? all[me].started : now, seen: now, cwd, branch }
            const said = describe(all)
            say("SessionStart", said)
            all[me].told = said ? said.ids : ""
        })
        return
    }

    if (cmd === "beat") {
        withRegistry((all) => {
            const prev = sane(all[me]) ? all[me].told : undefined
            all[me] = {
                started: sane(all[me]) ? all[me].started : now,
                seen: now,
                cwd,
                branch: (sane(all[me]) && all[me].branch) || branch,
                told: prev,
            }
            const said = describe(all)
            const ids = said ? said.ids : ""
            // Stay silent while the set of sessions has not changed: otherwise a warning on every turn.
            if (prev === undefined || prev !== ids) say("Stop", said)
            all[me].told = ids
        })
        return
    }

    if (cmd === "release") {
        withRegistry((all) => {
            delete all[me]
        })
        return
    }

    process.stderr.write("usage: worktree-lock <claim|beat|release|status>\n")
    process.exitCode = 1
}

try {
    main()
} catch (e) {
    // In hook mode a failure must be silent: exit 0, empty stdout.
    if (!HOOK) {
        process.stderr.write(`worktree-lock: ${e.message}\n`)
        process.exitCode = 1
    }
}
