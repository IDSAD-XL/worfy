#!/usr/bin/env node
// project-connect — writes a new project's profile and its gate registry entries on this machine,
// or removes them.
//
//   project-connect [--check | --schema-only | --no-qmd] < draft.json
//   project-connect --remove <name> [--no-qmd]
//   project-connect --facts <folder>
//
// The draft is one JSON object { profile, rules, gate } (profiles/draft.schema.json): profile.json
// (schema 2), the text of rules.md, and the gate registry entries, one per repository. Skill
// connect-project proposes it; worfy's "Add project" dialog and a terminal session call this script.
//
//   (no flag)      checks the draft, then writes: $HARNESS_HOME/projects/<name>/profile.json and
//                  rules.md, the entries appended to $HARNESS_HOME/gate/config.json, the default
//                  Workflow folder of a Silent mode project ($HARNESS_HOME/projects/<name>/workflow/,
//                  created with `git init`; a folder the user chose is taken as it is), and one commit
//                  in the git repository of $HARNESS_HOME (`git init` first when it is none). A failure
//                  half-way rolls back whatever was written. Only then, once the connection holds,
//                  the qmd collections (bin/qmd-collections, only when qmd is installed and its models
//                  were downloaded — otherwise skipped with the reason); their profile field joins
//                  the same commit. A qmd failure is reported and undoes nothing of the connection.
//   --no-qmd       with a write or --remove: the qmd step is skipped, with the reason "skipped: --no-qmd"
//                  (the write leaves the profile without a qmd field; --remove leaves the collections).
//   --remove <name>
//                  removes the project <name> from this machine's Harness: $HARNESS_HOME/projects/<name>/
//                  (with the default Workflow folder of a Silent mode project inside it), every gate
//                  registry entry with `profile: <name>`, $HARNESS_HOME/runs/<name>/ (the agents' marks),
//                  in one commit in the git repository of $HARNESS_HOME (none when it is no git
//                  repository). A failure half-way rolls back whatever was removed: the folders are moved
//                  aside until the commit holds. Only then the qmd collections the profile's qmd field
//                  names are removed (`qmd collection remove`, only when qmd is installed); one that
//                  another profile names too is kept. A qmd failure is reported and undoes nothing.
//                  The project's repositories are not touched. No such profile — exit 1, nothing
//                  touched; a name with a slash or ".." — exit 2. A default Workflow folder that holds
//                  anything beyond an empty `git init` (the project's tickets, out of the Harness home's
//                  history) — exit 1, nothing removed: the user moves it out first. A rollback that
//                  cannot put everything back keeps the staging folder ($HARNESS_HOME/.remove-*) and
//                  names it; staging folders left by an earlier run are named in stderr and in
//                  `leftover`, never deleted.
//   --check        only the checks; writes nothing.
//   --schema-only  only the schema of profiles/draft.schema.json; writes nothing.
//   --facts <dir>  only reads: what a draft needs that only a command could tell (owner decision
//                  2026-10-09: the draft Session has no Bash) — the kind of the folder (a git
//                  repository, or a folder above two or more repositories) and per repository its
//                  name, path, current branch, default branch, whether it has commits, its remotes
//                  (credentials taken out of the URLs) and origin. Prints JSON; no stdin.
//
// The project's repositories get one thing only, and only in Silent mode: the line
// `.claude/worktrees/` in their `.git/info/exclude` (the common git dir, so a linked worktree's
// repository is covered), once — the ticket worktrees live there and must not show in git. Nothing
// goes into a working tree, `.gitignore` or a tracked file.
//
// Exit codes: 0 — written or removed (or the check passed); 1 — the draft failed the schema or a check
// (the name is taken, a `match` is already in the registry, …), --remove found no such profile or an
// unreadable registry, or the write or removal failed and was rolled back: nothing changed, the reasons
// in stderr; 2 — usage error.
// Output (stdout, JSON, English only): on success { name, profileDir, gateKeys, workflowFolder, excludes, qmd }
// (with --check: { ok: true, name, gateKeys, workflowFolder }; with --remove: { name, removed: { profileDir,
// gateKeys, runs, qmd: { status, reason, removed, kept }, leftover } }, runs null when there was none, status
// "removed", "skipped" or "failed", leftover the staging folders still in the Harness home — earlier ones and
// this run's when it could not be deleted after the commit); on exit 1 { ok: false, errors: [{ path, kind, message }] }, kind is
// "schema", "conflict", "value" or "write".
// Environment: HARNESS_HOME (default ~/.claude/worfy-harness). Tests only: PROJECT_CONNECT_FAIL_AT
// (profile | workflow | gate | exclude | commit — fail as that step starts; --remove: profile | gate |
// runs | commit | cleanup), PROJECT_CONNECT_FAIL_ROLLBACK_AT (--remove: profile | gate | runs | commit —
// the rollback of that step fails), PROJECT_CONNECT_QMD_BIN (the qmd-collections to run),
// PROJECT_CONNECT_QMD (the qmd command to look for).
"use strict"

const fs = require("node:fs")
const path = require("node:path")
const { spawnSync } = require("node:child_process")

const HOME = process.env.HOME || require("node:os").homedir()
const HARNESS_HOME = path.resolve(process.env.HARNESS_HOME || path.join(HOME, ".claude", "worfy-harness"))
const BIN = path.dirname(fs.realpathSync(__filename))
const SCHEMA_FILE = path.join(path.dirname(BIN), "profiles", "draft.schema.json")
const QMD_COLLECTIONS = process.env.PROJECT_CONNECT_QMD_BIN || path.join(BIN, "qmd-collections")
const QMD = process.env.PROJECT_CONNECT_QMD || "qmd"
// A Node script (bin/qmd-collections) is started with the node running this one: Windows does not
// start an extensionless file by its #! line. Anything else (a shell stub of a test) is started by
// its #! line, as before — the rule of epic-status's scriptCommand.
function scriptCommand(file, args) {
    let head = ""
    try {
        const fd = fs.openSync(file, "r")
        try {
            const buf = Buffer.alloc(256)
            head = buf.toString("latin1", 0, fs.readSync(fd, buf, 0, buf.length, 0)).split("\n")[0]
        } finally {
            fs.closeSync(fd)
        }
    } catch {
        /* unreadable: let node report it */
    }
    return head.startsWith("#!") && !/\bnode\b/.test(head) ? [file, args] : [process.execPath, [file, ...args]]
}
const FAIL_AT = process.env.PROJECT_CONNECT_FAIL_AT || ""

const USAGE = `usage: project-connect [--check | --schema-only | --no-qmd] < draft.json
       project-connect --remove <name> [--no-qmd]
       project-connect --facts <folder>
exit: 0 written, removed (or checked), 1 the draft failed a check, no such profile, or the write or removal
      was rolled back, 2 usage`

// The .gitignore of a Harness home made a git repository (the same as worfy's move of the old
// Harness writes): the profiles and the gate registry are history, the rest is state.
const HARNESS_GITIGNORE = `# The history of the Harness state on this machine: the Profiles and the Gate registry.
# The plugin copy, Gate markers, worktree locks and the backups of a move are state, not history.
/*
!/.gitignore
!/projects/
/projects/*/state/
/projects/*/epics/*/task-map.json
/projects/*/workflow/
!/gate/
/gate/*
!/gate/config.json
`

// The line that keeps the default Workflow folders out of the history of the Harness home.
const WORKFLOW_IGNORE = "/projects/*/workflow/"

const NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/

const out = (value) => process.stdout.write(JSON.stringify(value, null, 2) + "\n")
const err = (text) => process.stderr.write(`project-connect: ${text}\n`)

// --- arguments ---------------------------------------------------------------------
let mode = "write"
let factsFolder = null
let removeName = null
let noQmd = false
const argv = process.argv.slice(2)
for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (arg === "--no-qmd" && !noQmd) noQmd = true
    else if (arg === "--check" && mode === "write") mode = "check"
    else if (arg === "--schema-only" && mode === "write") mode = "schema"
    else if (arg === "--facts" && mode === "write" && argv[i + 1] !== undefined && !argv[i + 1].startsWith("-")) {
        mode = "facts"
        factsFolder = argv[++i]
    } else if (arg === "--remove" && mode === "write" && argv[i + 1] !== undefined && !argv[i + 1].startsWith("-")) {
        mode = "remove"
        removeName = argv[++i]
    } else if (arg === "-h" || arg === "--help") {
        process.stdout.write(USAGE + "\n")
        process.exit(0)
    } else {
        err(`unknown or repeated argument: ${arg}`)
        process.stderr.write(USAGE + "\n")
        process.exit(2)
    }
}
const usageError = (text) => {
    err(text)
    process.stderr.write(USAGE + "\n")
    process.exit(2)
}
if (noQmd && mode !== "write" && mode !== "remove") usageError("--no-qmd goes with a write or --remove only")
// A name with a slash or "..": refused before any path is built from it.
if (mode === "remove" && !NAME.test(removeName)) usageError(`not a profile name: ${removeName}`)
// --- facts: only reads ------------------------------------------------------------------
// git without the caller's GIT_* variables and without optional locks: not even an index refresh.
const gitEnv = (() => {
    const env = { GIT_OPTIONAL_LOCKS: "0" }
    for (const [key, value] of Object.entries(process.env)) if (!key.startsWith("GIT_")) env[key] = value
    return env
})()
const gitRead = (dir, args) => {
    const result = spawnSync("git", ["-C", dir, ...args], { encoding: "utf8", env: gitEnv })
    return result.status === 0 ? result.stdout.trim() : null
}
const realOr = (p) => {
    try {
        return fs.realpathSync.native(p)
    } catch {
        return null
    }
}
// The root of the main repository `dir` is in (a linked worktree resolves to it), or null.
const repositoryOf = (dir) => {
    const top = gitRead(dir, ["rev-parse", "--show-toplevel"])
    if (!top) return null
    const common = gitRead(dir, ["rev-parse", "--path-format=absolute", "--git-common-dir"])
    return realOr(common && path.basename(common) === ".git" ? path.dirname(common) : top)
}
// A URL without the user and password some remotes carry.
const withoutCredentials = (url) => url.replace(/^([a-z][a-z0-9+.-]*:\/\/)[^@/]*@/i, "$1")
function repoFacts(root) {
    const remotes = []
    const listed = gitRead(root, ["config", "--get-regexp", "^remote\\..*\\.url$"]) || ""
    for (const line of listed.split("\n")) {
        const match = /^remote\.(.+)\.url\s+(.*)$/.exec(line.trim())
        if (match) remotes.push({ name: match[1], url: withoutCredentials(match[2]) })
    }
    const branch = gitRead(root, ["symbolic-ref", "--short", "-q", "HEAD"])
    const originHead = gitRead(root, ["symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD"])
    const local = (name) => gitRead(root, ["show-ref", "--verify", "-q", `refs/heads/${name}`]) !== null
    const defaultBranch = originHead ? originHead.replace(/^origin\//, "") : local("main") ? "main" : local("master") ? "master" : branch
    const origin = remotes.find((remote) => remote.name === "origin")
    return {
        name: path.basename(root),
        path: root,
        branch,
        defaultBranch,
        hasCommits: gitRead(root, ["rev-parse", "-q", "--verify", "HEAD"]) !== null,
        remotes,
        origin: origin ? origin.url : null,
    }
}
// --- shared by the write and --remove ----------------------------------------------------
const isObject = (v) => typeof v === "object" && v !== null && !Array.isArray(v)
const realDir = (p) => {
    try {
        return fs.statSync(p).isDirectory() ? fs.realpathSync.native(p) : null
    } catch {
        return null
    }
}
const step = (label, work) => {
    if (FAIL_AT === label) throw new Error(`failed on purpose at the step "${label}" (PROJECT_CONNECT_FAIL_AT)`)
    work()
}
const run = (cmd, args, cwd) => {
    const result = spawnSync(cmd, args, { cwd, encoding: "utf8" })
    if (result.error) throw new Error(`${cmd} ${args.join(" ")}: ${result.error.message}`)
    if (result.status !== 0) throw new Error(`${cmd} ${args.join(" ")}: ${(result.stderr || result.stdout).trim()}`)
    return result.stdout
}
const isGitRoot = (dir) => {
    const result = spawnSync("git", ["-C", dir, "rev-parse", "--show-toplevel"], { encoding: "utf8" })
    return result.status === 0 && realDir(result.stdout.trim()) === realDir(dir)
}
// git commit without the machine's hooks and signing, and with an identity when it has none.
const commitArgs = (dir) => {
    const args = ["-c", "core.hooksPath=/dev/null", "-c", "commit.gpgsign=false"]
    const email = spawnSync("git", ["-C", dir, "config", "user.email"], { encoding: "utf8" })
    if (email.status !== 0 || email.stdout.trim() === "") args.push("-c", "user.name=worfy Harness", "-c", "user.email=harness@localhost")
    return args
}
const writeAtomic = (file, text) => {
    const tmp = `${file}.tmp-${process.pid}`
    fs.writeFileSync(tmp, text)
    fs.renameSync(tmp, file)
}
// Runs qmd. A Node qmd (the npm package is one, and so is a test's stand-in) is started with the node
// running this script: Windows does not start an extensionless file by its #! line. A bare command
// name (the default "qmd") or a binary is started as it is.
const runQmd = (args) => {
    let head = ""
    try {
        const fd = fs.openSync(QMD, "r")
        try {
            const buf = Buffer.alloc(256)
            head = buf.toString("latin1", 0, fs.readSync(fd, buf, 0, buf.length, 0)).split("\n")[0]
        } finally {
            fs.closeSync(fd)
        }
    } catch {
        /* a bare name looked up on PATH, or unreadable: start it as it is */
    }
    const [file, list] = head.startsWith("#!") && /\bnode\b/.test(head) ? [process.execPath, [QMD, ...args]] : [QMD, args]
    return spawnSync(file, list, { encoding: "utf8" })
}
const qmdInstalled = () => {
    const result = runQmd(["--version"])
    return !result.error && result.status === 0
}
// The last line a failed command printed, without terminal colours.
const lastLine = (result) =>
    ((result.stderr || "") + (result.error ? result.error.message : ""))
        .replace(/\x1b\[[0-9;]*m/g, "")
        .trim()
        .split("\n")
        .pop()

if (mode === "facts") {
    const dir = realOr(path.resolve(factsFolder))
    const refuseFacts = (message) => {
        err(message)
        out({ ok: false, errors: [{ path: "", kind: "value", message }] })
        process.exit(1)
    }
    if (dir === null || !fs.statSync(dir).isDirectory()) refuseFacts(`${factsFolder} is not a folder`)
    const root = repositoryOf(dir)
    if (root !== null) {
        out({ folder: root, kind: "git", repos: [repoFacts(root)] })
        process.exit(0)
    }
    const repos = fs
        .readdirSync(dir, { withFileTypes: true })
        .filter((entry) => entry.isDirectory() && !entry.name.startsWith("."))
        .map((entry) => path.join(dir, entry.name))
        .sort()
        .filter((sub) => {
            const top = gitRead(sub, ["rev-parse", "--show-toplevel"])
            return top !== null && realOr(top) === realOr(sub)
        })
    if (repos.length < 2) refuseFacts(`${dir} is not a git repository and holds ${repos.length === 1 ? "only one" : "no"} repositories`)
    out({ folder: dir, kind: "multi-repo", repos: repos.map((repo) => repoFacts(realOr(repo))) })
    process.exit(0)
}

// --- --remove: the profile, its registry entries, its runs folder, one commit ---------------
if (mode === "remove") {
    const name = removeName
    const profileDir = path.join(HARNESS_HOME, "projects", name)
    const profileFile = path.join(profileDir, "profile.json")
    const gateFile = path.join(HARNESS_HOME, "gate", "config.json")
    const runsDir = path.join(HARNESS_HOME, "runs", name)
    const refuseRemove = (kind, message) => {
        err(message)
        out({ ok: false, errors: [{ path: "", kind, message }] })
        process.exit(1)
    }
    // Staging folders an earlier --remove left behind (killed half-way, or not deletable after its
    // commit): never deleted here, since one may hold the only copy of a profile; named in the answer.
    const earlier = fs.existsSync(HARNESS_HOME)
        ? fs.readdirSync(HARNESS_HOME).filter((entry) => entry.startsWith(".remove-")).map((entry) => path.join(HARNESS_HOME, entry))
        : []
    for (const left of earlier) err(`an earlier removal left ${left}: what it holds was not put back`)
    const earlierNote = earlier.length > 0 ? `; earlier removals left ${earlier.join(", ")}` : ""
    if (!fs.existsSync(profileFile)) refuseRemove("value", `no profile ${name}: ${profileFile} does not exist${earlierNote}`)
    // The default Workflow folder of a Silent mode project lies inside the profile folder and is a git
    // repository of its own, out of the Harness home's history: its tickets could not be brought back.
    // Anything in it beyond an empty `git init` is a refusal.
    const workflowDir = path.join(profileDir, "workflow")
    if (fs.existsSync(workflowDir)) {
        const holds = fs.readdirSync(workflowDir).some((entry) => entry !== ".git")
        const commits = isGitRoot(workflowDir) && spawnSync("git", ["-C", workflowDir, "rev-parse", "-q", "--verify", "HEAD"]).status === 0
        if (holds || commits) {
            refuseRemove("value", `the Workflow folder ${workflowDir} holds the project's own files${commits ? " and commits" : ""}: move it out of ${profileDir} first; nothing was removed`)
        }
    }
    // Read before the removal: the qmd step needs its collections. A broken profile is still removed.
    let stored = null
    try {
        stored = JSON.parse(fs.readFileSync(profileFile, "utf8"))
    } catch {
        /* removed all the same; its qmd collections are not known */
    }
    // The registry as it is now: a broken one is not overwritten.
    let registry = null
    if (fs.existsSync(gateFile)) {
        try {
            registry = JSON.parse(fs.readFileSync(gateFile, "utf8"))
            if (!isObject(registry) || !Array.isArray(registry.repos)) throw new Error('the "repos" field must be an array')
        } catch (e) {
            refuseRemove("value", `the gate registry ${gateFile} cannot be read: ${e.message}`)
        }
    }
    const ours = (entry) => isObject(entry) && entry.profile === name
    const gateKeys = registry ? registry.repos.filter(ours).map((entry) => entry.key) : []
    const removed = { profileDir, gateKeys, runs: fs.existsSync(runsDir) ? runsDir : null, qmd: null, leftover: [...earlier] }

    // The folders are moved aside, not deleted, until the commit holds: the rollback moves them back.
    // The staging folder sits in the Harness home itself (the same disk, so a rename), and its .gitignore
    // (`/*`) keeps it out of the history.
    const undo = []
    // Tests only: PROJECT_CONNECT_FAIL_ROLLBACK_AT=<step> makes the rollback of that step fail.
    const FAIL_ROLLBACK_AT = process.env.PROJECT_CONNECT_FAIL_ROLLBACK_AT || ""
    const undoStep = (label, back) =>
        undo.push(() => {
            if (FAIL_ROLLBACK_AT === label) throw new Error(`failed on purpose at the rollback of "${label}" (PROJECT_CONNECT_FAIL_ROLLBACK_AT)`)
            back()
        })
    let staging = null
    try {
        staging = fs.mkdtempSync(path.join(HARNESS_HOME, ".remove-"))
        step("profile", () => {
            const aside = path.join(staging, "profile")
            fs.renameSync(profileDir, aside)
            undoStep("profile", () => fs.renameSync(aside, profileDir))
        })
        step("gate", () => {
            if (gateKeys.length === 0) return
            const before = fs.readFileSync(gateFile)
            writeAtomic(gateFile, JSON.stringify({ ...registry, repos: registry.repos.filter((entry) => !ours(entry)) }, null, 2) + "\n")
            undoStep("gate", () => writeAtomic(gateFile, before))
        })
        step("runs", () => {
            if (removed.runs === null) return
            const aside = path.join(staging, "runs")
            fs.renameSync(runsDir, aside)
            undoStep("runs", () => fs.renameSync(aside, runsDir))
        })
        step("commit", () => {
            // A Harness home without git (never connected through this script) has no history to keep.
            if (!isGitRoot(HARNESS_HOME)) return
            const profileRel = path.join("projects", name)
            const gateRel = path.join("gate", "config.json")
            const paths = []
            if (run("git", ["ls-files", "--", profileRel], HARNESS_HOME).trim() !== "") {
                run("git", ["rm", "-r", "-q", "--cached", "--", profileRel], HARNESS_HOME)
                undoStep("commit", () => run("git", ["reset", "-q", "--", profileRel], HARNESS_HOME))
                paths.push(profileRel)
            }
            if (gateKeys.length > 0 && run("git", ["ls-files", "--", gateRel], HARNESS_HOME).trim() !== "") {
                run("git", ["add", "--", gateRel], HARNESS_HOME)
                undoStep("commit", () => run("git", ["reset", "-q", "--", gateRel], HARNESS_HOME))
                paths.push(gateRel)
            }
            if (paths.length === 0) return
            run("git", [...commitArgs(HARNESS_HOME), "commit", "-q", "--no-verify", "-m", `Remove the project ${name}`, "--", ...paths], HARNESS_HOME)
        })
    } catch (e) {
        let whole = true
        for (const back of undo.reverse()) {
            try {
                back()
            } catch (rollback) {
                whole = false
                err(`the rollback could not undo a step: ${rollback.message}`)
            }
        }
        // The staging folder goes only when everything in it was put back: otherwise it may hold the
        // only copy of the profile or the runs folder.
        if (!whole) refuseRemove("write", `${e.message}; the rollback failed, what was not put back is kept in ${staging}${earlierNote}`)
        if (staging !== null) fs.rmSync(staging, { recursive: true, force: true })
        refuseRemove("write", `${e.message}; the removal was rolled back${earlierNote}`)
    }
    try {
        step("cleanup", () => fs.rmSync(staging, { recursive: true, force: true }))
    } catch (e) {
        // The removal is committed; what is left is a folder of the Harness home its history ignores.
        removed.leftover.push(staging)
        err(`the removed files are left in ${staging}: ${e.message}`)
    }

    // --- qmd, after the commit: a failure here is reported and puts nothing back ---
    const collections = stored && isObject(stored.qmd) && Array.isArray(stored.qmd.collections) ? stored.qmd.collections.filter((c) => typeof c === "string" && c !== "") : []
    if (noQmd) removed.qmd = { status: "skipped", reason: "skipped: --no-qmd", removed: [], kept: collections }
    else if (collections.length === 0) removed.qmd = { status: "skipped", reason: "the profile names no qmd collections", removed: [], kept: [] }
    else if (!qmdInstalled()) removed.qmd = { status: "skipped", reason: "qmd is not installed", removed: [], kept: collections }
    else {
        // A collection another profile names too (the qmd field of a profile may name shared ones) stays.
        const elsewhere = new Set()
        const projectsDir = path.join(HARNESS_HOME, "projects")
        for (const other of fs.existsSync(projectsDir) ? fs.readdirSync(projectsDir) : []) {
            try {
                const theirs = JSON.parse(fs.readFileSync(path.join(projectsDir, other, "profile.json"), "utf8")).qmd
                for (const c of (isObject(theirs) && Array.isArray(theirs.collections) && theirs.collections) || []) elsewhere.add(c)
            } catch {
                /* not a profile folder, or an unreadable profile: it names nothing */
            }
        }
        const done = []
        const failed = []
        for (const c of collections.filter((c) => !elsewhere.has(c))) {
            const result = runQmd(["collection", "remove", c])
            if (!result.error && result.status === 0) done.push(c)
            else failed.push(`qmd collection remove ${c} failed: ${lastLine(result)}`)
        }
        const kept = collections.filter((c) => elsewhere.has(c))
        const reasons = [...failed]
        if (kept.length > 0) reasons.push(`kept, another profile names them: ${kept.join(", ")}`)
        removed.qmd = { status: failed.length > 0 ? "failed" : done.length > 0 ? "removed" : "skipped", reason: reasons.join("; ") || null, removed: done, kept }
    }
    out({ name, removed })
    process.exit(0)
}

if (process.stdin.isTTY) {
    err("the draft is read from stdin")
    process.stderr.write(USAGE + "\n")
    process.exit(2)
}

const errors = []
const fail = (at, kind, message) => errors.push({ path: at, kind, message })
const refuse = () => {
    for (const e of errors) err(`${e.path || "draft"}: ${e.message}`)
    out({ ok: false, errors })
    process.exit(1)
}

// --- the schema --------------------------------------------------------------------
// The keywords profiles/draft.schema.json uses: type, enum, const, required, properties,
// additionalProperties, items, minItems, minLength.
const TYPES = {
    string: (v) => typeof v === "string",
    number: (v) => typeof v === "number",
    integer: (v) => Number.isInteger(v),
    boolean: (v) => typeof v === "boolean",
    null: (v) => v === null,
    array: Array.isArray,
    object: isObject,
}
const join = (at, key) => (typeof key === "number" ? `${at}[${key}]` : at ? `${at}.${key}` : key)

function validate(schema, value, at) {
    if (schema.const !== undefined && JSON.stringify(schema.const) !== JSON.stringify(value)) {
        return fail(at, "schema", `must be ${JSON.stringify(schema.const)}`)
    }
    if (schema.enum && !schema.enum.some((v) => v === value)) {
        return fail(at, "schema", `must be one of ${schema.enum.map((v) => JSON.stringify(v)).join(", ")}`)
    }
    if (schema.type) {
        const types = [].concat(schema.type)
        if (!types.some((t) => TYPES[t] && TYPES[t](value))) return fail(at, "schema", `must be ${types.join(" or ")}`)
    }
    if (typeof value === "string" && schema.minLength !== undefined && value.length < schema.minLength) {
        fail(at, "schema", "must not be empty")
    }
    if (Array.isArray(value)) {
        if (schema.minItems !== undefined && value.length < schema.minItems) fail(at, "schema", `must have at least ${schema.minItems} item(s)`)
        if (schema.items) value.forEach((item, i) => validate(schema.items, item, join(at, i)))
    }
    if (isObject(value)) {
        for (const key of schema.required || []) if (!(key in value)) fail(join(at, key), "schema", "is required")
        const props = schema.properties || {}
        for (const [key, item] of Object.entries(value)) {
            if (props[key]) validate(props[key], item, join(at, key))
            else if (schema.additionalProperties === false) fail(join(at, key), "schema", "is not a field of the draft")
        }
    }
}

let schema
try {
    schema = JSON.parse(fs.readFileSync(SCHEMA_FILE, "utf8"))
} catch (e) {
    err(`the draft schema ${SCHEMA_FILE} cannot be read: ${e.message}`)
    process.exit(2)
}

let draft
try {
    draft = JSON.parse(fs.readFileSync(0, "utf8"))
} catch (e) {
    fail("", "schema", `the draft is not JSON: ${e.message}`)
    refuse()
}
validate(schema, draft, "")
if (errors.length > 0) refuse()
if (mode === "schema") {
    out({ ok: true })
    process.exit(0)
}

// --- the checks --------------------------------------------------------------------
const profile = draft.profile
const name = profile.name
const projectsDir = path.join(HARNESS_HOME, "projects")
const profileDir = path.join(projectsDir, name)
const gateFile = path.join(HARNESS_HOME, "gate", "config.json")
// Transition, as bin/profile and the gate read it: with no registry in HARNESS_HOME but one in the
// old place, ~/.claude/gate/config.json, the old one is the registry. The write goes to the new
// place and from then on shadows the old one, so it starts from the old registry's entries: the
// Projects there stay known. The old file is only read.
const legacyGateFile = path.join(require("node:os").homedir(), ".claude", "gate", "config.json")
const readGateFile = !fs.existsSync(gateFile) && fs.existsSync(legacyGateFile) ? legacyGateFile : gateFile
const defaultFolder = path.join(profileDir, "workflow")

const inside = (child, parent) => child === parent || child.startsWith(parent.endsWith(path.sep) ? parent : parent + path.sep)

if (!NAME.test(name)) fail("profile.name", "value", "letters, digits, dots, dashes and underscores only, starting with a letter or a digit")
else if (fs.existsSync(profileDir)) fail("profile.name", "conflict", `the name is taken: ${profileDir} exists`)

// The registry as it is now (readGateFile): a broken one is not overwritten, nor carried over.
let registry = null
if (fs.existsSync(readGateFile)) {
    try {
        registry = JSON.parse(fs.readFileSync(readGateFile, "utf8"))
        if (!isObject(registry) || !Array.isArray(registry.repos)) throw new Error('the "repos" field must be an array')
    } catch (e) {
        fail("gate", "value", `the gate registry ${readGateFile} cannot be read: ${e.message}`)
        refuse()
    }
}
const known = registry ? registry.repos : []
const knownKeys = new Set(known.map((entry) => entry && entry.key))
const knownMatches = known
    .map((entry) => entry && typeof entry.match === "string" && (realDir(entry.match) || path.resolve(entry.match)))
    .filter(Boolean)

const repos = []
const keys = new Set()
draft.gate.forEach((entry, i) => {
    const at = `gate[${i}]`
    if (entry.profile !== name) fail(`${at}.profile`, "value", `must be the profile name ${JSON.stringify(name)}`)
    if (!NAME.test(entry.key)) fail(`${at}.key`, "value", "letters, digits, dots, dashes and underscores only")
    else if (keys.has(entry.key)) fail(`${at}.key`, "conflict", `the key ${entry.key} is given twice`)
    else if (knownKeys.has(entry.key)) fail(`${at}.key`, "conflict", `the key ${entry.key} is already in the gate registry`)
    keys.add(entry.key)
    if (!path.isAbsolute(entry.match)) return fail(`${at}.match`, "value", "must be an absolute path")
    const real = realDir(entry.match)
    if (real === null) return fail(`${at}.match`, "value", `${entry.match} is not a folder`)
    if (knownMatches.some((m) => m === real)) return fail(`${at}.match`, "conflict", `${real} is already in the gate registry`)
    if (repos.includes(real)) return fail(`${at}.match`, "conflict", `${real} is given twice`)
    repos.push(real)
})

if (draft.gate.length > 1 && profile.mode !== "silent") {
    fail("profile.mode", "value", "a project over several repositories is always in Silent mode")
}

const folder = profile.workflow.folder
let workflowFolder = null
let defaultWorkflow = false
if (profile.mode === "full") {
    if (folder !== null) fail("profile.workflow.folder", "value", "Full mode has no Workflow folder: the files live in the repository (null)")
} else if (folder === null || path.resolve(folder) === defaultFolder) {
    workflowFolder = defaultFolder
    defaultWorkflow = true
} else if (!path.isAbsolute(folder)) {
    fail("profile.workflow.folder", "value", "must be an absolute path")
} else {
    workflowFolder = realDir(folder)
    if (workflowFolder === null) fail("profile.workflow.folder", "value", `${folder} is not a folder`)
    else if (repos.some((repo) => inside(workflowFolder, repo))) {
        fail("profile.workflow.folder", "value", "the Workflow folder must lie outside the project's repositories")
    }
}

if (errors.length > 0) refuse()
if (mode === "check") {
    out({ ok: true, name, gateKeys: draft.gate.map((entry) => entry.key), workflowFolder })
    process.exit(0)
}

// --- the write, with a rollback --------------------------------------------------------
const undo = []

const written = { name, profileDir, gateKeys: draft.gate.map((entry) => entry.key), workflowFolder, excludes: [], qmd: null }
// The line that keeps the ticket worktrees of a Silent project out of git, in .git/info/exclude.
const WORKTREES_EXCLUDE = ".claude/worktrees/"
try {
    fs.mkdirSync(HARNESS_HOME, { recursive: true })

    step("profile", () => {
        fs.mkdirSync(projectsDir, { recursive: true })
        fs.mkdirSync(profileDir)
        undo.push(() => fs.rmSync(profileDir, { recursive: true, force: true }))
        const stored = { ...profile, workflow: { ...profile.workflow, folder: workflowFolder } }
        fs.writeFileSync(path.join(profileDir, "profile.json"), JSON.stringify(stored, null, 2) + "\n")
        fs.writeFileSync(path.join(profileDir, "rules.md"), draft.rules.endsWith("\n") ? draft.rules : draft.rules + "\n")
    })

    step("workflow", () => {
        if (!defaultWorkflow) return
        // Inside profileDir: the rollback of the profile takes it away too.
        fs.mkdirSync(workflowFolder, { recursive: true })
        run("git", ["init", "-q"], workflowFolder)
    })

    step("gate", () => {
        const before = fs.existsSync(gateFile) ? fs.readFileSync(gateFile) : null
        fs.mkdirSync(path.dirname(gateFile), { recursive: true })
        const next = registry ? { ...registry, repos: [...registry.repos, ...draft.gate] } : { repos: [...draft.gate] }
        writeAtomic(gateFile, JSON.stringify(next, null, 2) + "\n")
        undo.push(() => (before === null ? fs.rmSync(gateFile, { force: true }) : writeAtomic(gateFile, before)))
    })

    step("exclude", () => {
        if (profile.mode !== "silent") return
        const files = new Set()
        for (const repo of repos) {
            const common = gitRead(repo, ["rev-parse", "--path-format=absolute", "--git-common-dir"])
            if (!common) throw new Error(`the git dir of ${repo} cannot be read`)
            files.add(path.join(common, "info", "exclude"))
        }
        for (const file of files) {
            const before = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : null
            const lines = (before || "").split("\n").map((line) => line.trim())
            if (lines.includes(WORKTREES_EXCLUDE) || lines.includes(`/${WORKTREES_EXCLUDE}`)) continue
            fs.mkdirSync(path.dirname(file), { recursive: true })
            const text = before === null || before === "" || before.endsWith("\n") ? before || "" : before + "\n"
            fs.writeFileSync(file, `${text}${WORKTREES_EXCLUDE}\n`)
            undo.push(() => (before === null ? fs.rmSync(file, { force: true }) : fs.writeFileSync(file, before)))
            written.excludes.push(file)
        }
    })

    step("commit", () => {
        const paths = [path.join("projects", name, "profile.json"), path.join("projects", name, "rules.md"), path.join("gate", "config.json")]
        if (!isGitRoot(HARNESS_HOME)) {
            const ignore = path.join(HARNESS_HOME, ".gitignore")
            if (!fs.existsSync(ignore)) {
                fs.writeFileSync(ignore, HARNESS_GITIGNORE)
                undo.push(() => fs.rmSync(ignore, { force: true }))
            }
            run("git", ["init", "-q"], HARNESS_HOME)
            undo.push(() => fs.rmSync(path.join(HARNESS_HOME, ".git"), { recursive: true, force: true }))
            paths.push(".gitignore")
        }
        // The default Workflow folder is a git repository of its own: the history of the Harness
        // home leaves it out.
        if (defaultWorkflow && spawnSync("git", ["-C", HARNESS_HOME, "check-ignore", "-q", path.join("projects", name, "workflow") + "/"]).status !== 0) {
            const ignore = path.join(HARNESS_HOME, ".gitignore")
            const before = fs.existsSync(ignore) ? fs.readFileSync(ignore, "utf8") : null
            const text = before === null || before === "" || before.endsWith("\n") ? before || "" : before + "\n"
            fs.writeFileSync(ignore, `${text}${WORKFLOW_IGNORE}\n`)
            undo.push(() => (before === null ? fs.rmSync(ignore, { force: true }) : fs.writeFileSync(ignore, before)))
            if (!paths.includes(".gitignore")) paths.push(".gitignore")
        }
        run("git", ["add", "--", ...paths], HARNESS_HOME)
        undo.push(() => spawnSync("git", ["-C", HARNESS_HOME, "reset", "-q", "--", ...paths]))
        run("git", [...commitArgs(HARNESS_HOME), "commit", "-q", "--no-verify", "-m", `Connect the project ${name}`, "--", ...paths], HARNESS_HOME)
    })
} catch (e) {
    for (const back of undo.reverse()) {
        try {
            back()
        } catch (rollback) {
            err(`the rollback could not undo a step: ${rollback.message}`)
        }
    }
    fail("", "write", `${e.message}; everything written was rolled back`)
    refuse()
}

// --- qmd, after the commit -------------------------------------------------------------
// The connection is written and committed; nothing below rolls it back. qmd-collections writes
// qmd's index.yml (outside the Harness home, with its own dated copy) and the `qmd` field of
// profile.json: the field goes into the same commit (--amend), so the history keeps one commit.
// A failed qmd-collections leaves profile.json as committed and is reported, not undone further.
const profileRel = path.join("projects", name, "profile.json")
const models = (() => {
    try {
        return fs.readFileSync(path.join(HARNESS_HOME, "qmd-models"), "utf8").split("\n")[0].trim()
    } catch {
        return ""
    }
})()
// qmd's index.yml, found as bin/qmd-collections finds it: whether a failed run had written it.
const INDEX_YML =
    process.env.QMD_INDEX_YML ||
    (process.env.QMD_CONFIG_DIR ? path.join(process.env.QMD_CONFIG_DIR, "index.yml") : path.join(process.env.XDG_CONFIG_HOME || path.join(HOME, ".config"), "qmd", "index.yml"))
const readIndex = () => {
    try {
        return fs.readFileSync(INDEX_YML, "utf8")
    } catch {
        return null
    }
}
// The qmd field qmd-collections wrote into profile.json joins the connection commit.
const amendProfile = () => {
    const changed = spawnSync("git", ["-C", HARNESS_HOME, "status", "--porcelain", "--", profileRel], { encoding: "utf8" })
    if (changed.status !== 0 || changed.stdout.trim() === "") return null
    try {
        run("git", ["add", "--", profileRel], HARNESS_HOME)
        run("git", [...commitArgs(HARNESS_HOME), "commit", "-q", "--no-verify", "--amend", "--no-edit", "--", profileRel], HARNESS_HOME)
        return null
    } catch (e) {
        return `the qmd field of profile.json is not committed: ${e.message}`
    }
}
if (noQmd) written.qmd = { status: "skipped", reason: "skipped: --no-qmd" }
else if (!qmdInstalled()) written.qmd = { status: "skipped", reason: "qmd is not installed" }
else if (models !== "downloaded") written.qmd = { status: "skipped", reason: 'the qmd models were not downloaded (qmd-models is not "downloaded")' }
else {
    const indexBefore = readIndex()
    const [collectionsFile, collectionsArgs] = scriptCommand(QMD_COLLECTIONS, [name])
    const added = spawnSync(collectionsFile, collectionsArgs, { encoding: "utf8", env: { ...process.env, HARNESS_HOME } })
    const last = lastLine(added)
    if (added.status === 0) {
        written.qmd = { status: "added", reason: amendProfile() }
    } else if (readIndex() !== indexBefore) {
        // The collections are in index.yml already: only what came after (qmd update) failed. The
        // profile keeps its qmd field, so the two agree.
        written.qmd = { status: "added", reason: [`the collections are set up, but qmd update failed: ${last}`, amendProfile()].filter(Boolean).join("; ") }
    } else {
        spawnSync("git", ["-C", HARNESS_HOME, "checkout", "-q", "--", profileRel])
        written.qmd = { status: "skipped", reason: `qmd-collections failed: ${last}` }
    }
}

out(written)
