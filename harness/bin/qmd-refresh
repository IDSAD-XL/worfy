#!/bin/zsh
# qmd-refresh — brings the qmd index up to the projects' current main branches.
#
# The qmd-mcp wrapper updates the index ONCE, when the MCP server starts. In a long
# session that is not enough: main moves a dozen merges ahead, while search keeps
# answering with the snapshot from the start of the session — and answers confidently, which is worse than silence.
#
# Here is the same update, but on demand and cheap: first we ask the remote
# repositories whether the main branch has moved, and exit if not. One network call
# per git copy.
#
# What to check is taken from ~/.config/qmd/index.yml, not from this file:
#   git copies — collections with `update: …/qmd-sync-main <profile>`; the copy's path, branch and
#               gh account come from `qmd-sync-main --describe <profile>` (that is, the project's profile);
#   local ones — paths of collections without `update:` (project memory, lessons).
# The exception is memory and lessons: they are outside git, and if there is a file newer than the last
# update (`last-index`), we update without the network check (since 2026-09-29: before that
# a note waited for main to move or for the MCP server to restart).
#
#   qmd-refresh            — update if main has moved
#   qmd-refresh --force    — update unconditionally
#   qmd-refresh --quiet    — no output (for the hook)
#   qmd-refresh --wait     — do not go to the background, wait for the end (for checking by hand)
#
# The check runs in place and costs one network call; the update itself (`update` +
# `embed`) goes to the BACKGROUND, because embed takes minutes and a hook cannot wait.
#
# The lock is shared with qmd-mcp: `qmd update` does a checkout in the shared copy, and two
# checkouts at once produce garbage. If it is taken, exit silently: whoever holds the lock
# is doing exactly the same work.
set -u

CACHE="$HOME/.cache/qmd"
INDEX_YML="${QMD_INDEX_YML:-$HOME/.config/qmd/index.yml}"
# qmd-sync-main is the script next to this one: ${0:A:h} is the folder of this file's real path.
SYNC="${QMD_REFRESH_SYNC:-${0:A:h}/qmd-sync-main}"   # override for tests
LOG="$CACHE/refresh.log"
LOCK="$CACHE/refresh.lock"
STAMP="$CACHE/last-check"
THROTTLE=300   # seconds between network checks
INDEXED="$CACHE/last-index"   # start time of the last index update
# `qmd embed` downloads its model when it is missing, so it runs only after the user agreed to the
# models (the answer file of qmd-mcp) and with the embedding model qmd-mcp
# sets: vectors of another model would not match the server's queries. `qmd update` needs no model.
ANSWER_FILE="${HARNESS_HOME:-$HOME/.claude/worfy-harness}/qmd-models"
export QMD_EMBED_MODEL="hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf"
models_agreed() { [[ -r "$ANSWER_FILE" && "$(head -n 1 "$ANSWER_FILE" 2>/dev/null)" == downloaded ]] }

FORCE=0; QUIET=0; WAIT=0
for a in "$@"; do
  case "$a" in
    --force) FORCE=1 ;;
    --quiet) QUIET=1 ;;
    --wait)  WAIT=1 ;;
  esac
done
say() { [[ "$QUIET" == 1 ]] || print -r -- "$*" }

# A partial failure (one profile not resolved, one copy missing) does not stop the run:
# memory and lessons must be updated even then. Exit code: without --quiet — 1 on a partial
# failure; with --quiet (this is how the Stop hook in settings.json calls it) — 0, because a non-zero hook
# exit would show up as an error on every turn. The signal in that case is a line in $LOG; it is written
# only by a pass that got past the rate limit, otherwise the log would grow by a line
# on every turn.
PARTIAL=0
WARNINGS=()
warn() {
  PARTIAL=1
  WARNINGS+=("$*")
  say "qmd-refresh: $*"
}
log_warnings() {
  (( ${#WARNINGS} )) || return 0
  mkdir -p "$CACHE" 2>/dev/null || return 0
  for w in "${WARNINGS[@]}"; do print -r -- "$(date '+%F %T') qmd-refresh: $w"; done >>"$LOG" 2>/dev/null
  WARNINGS=()
}
finish() {
  [[ "$PARTIAL" == 1 && "$QUIET" != 1 ]] && exit 1
  exit 0
}
# A total failure (no qmd, no index.yml): with --quiet also 0 — for the same reason.
die() { # $1 = exit code without --quiet, the rest is the message
  local code="$1"; shift
  say "qmd-refresh: $*"
  [[ "$QUIET" == 1 ]] && exit 0
  exit "$code"
}

if ! command -v qmd >/dev/null 2>&1 && [[ -s "$HOME/.nvm/nvm.sh" ]]; then
  source "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
  nvm use default --silent >/dev/null 2>&1 || true
fi
QMD_BIN="$(command -v qmd)" || die 127 "qmd not found"

# Parsing index.yml: collections are keys indented by 2 under `collections:`, their fields are indented by 4.
# Prints "m<TAB>profile" for each git copy and "l<TAB>path" for each local collection.
[[ -r "$INDEX_YML" ]] || die 1 "no $INDEX_YML"
SOURCES="$(awk '
  function flush() { if (name == "") return
    if (upd ~ /qmd-sync-main[ \t]+[^ \t]/) { n = upd; sub(/.*qmd-sync-main[ \t]+/, "", n); sub(/[ \t].*/, "", n); if (!(n in seen)) { seen[n] = 1; print "m\t" n } }
    else if (upd == "" && path != "") print "l\t" path
    name = ""; path = ""; upd = "" }
  /^[^ #]/ { flush(); inside = ($0 ~ /^collections:/); next }
  !inside { next }
  /^  [^ #][^:]*:[ \t]*$/ { flush(); name = $1; next }
  /^    path:/   { path = $0; sub(/^    path:[ \t]*/, "", path); gsub(/^"|"$/, "", path) }
  /^    update:/ { upd = $0;  sub(/^    update:[ \t]*/, "", upd) }
  END { flush() }' "$INDEX_YML")"
MIRRORS=(${(f)"$(print -r -- "$SOURCES" | awk -F'\t' '$1 == "m" { print $2 }')"})
LOCAL_DIRS=(${(f)"$(print -r -- "$SOURCES" | awk -F'\t' '$1 == "l" { print $2 }')"})

# Copy, branch, account of each git copy — from the profile via qmd-sync-main --describe.
# The answer is stdout only: a profile warning on stderr (bin/profile warns and still answers) passes
# through to our stderr; on a failure the reason is the last stderr line (qmd-sync-main prints it
# there), or stdout when stderr is empty.
COPIES=(); BRANCHES=(); ACCOUNTS=()
DESCRIBE_ERR="$(mktemp "${TMPDIR:-/tmp}/qmd-refresh-describe.XXXXXX")"
for p in "${MIRRORS[@]}"; do
  d="$("$SYNC" --describe "$p" 2>"$DESCRIBE_ERR")"; rc=$?; e="$(<"$DESCRIBE_ERR")"
  if (( rc )); then warn "profile $p not resolved, its copy skipped — ${${e:+${e##*$'\n'}}:-$d}"; continue; fi
  [[ -n "$e" ]] && print -u2 -r -- "$e"
  c="${d%%$'\t'*}"; r="${d#*$'\t'}"
  [[ -d "$c/.git" ]] || { warn "copy $c (profile $p) is missing, skipped — start a session with qmd-mcp first"; continue }
  COPIES+=("$c"); BRANCHES+=("${r%%$'\t'*}"); ACCOUNTS+=("${r#*$'\t'}")
done
rm -f -- "$DESCRIBE_ERR"

# A failed pull (qmd-sync-main writes the markers, one per profile): the index answers with an old snapshot.
for f in "$CACHE"/sync-failed*(N); do
  say "qmd-refresh: WARNING — the last pull of main failed, the index may be stale: $(head -c 300 "$f")"
done

# Memory and lessons live outside git: main may not have moved while a note appeared. The check
# is local and cheap, so it runs before the rate limit and without the network.
LOCAL_NEWER=0
if [[ ! -f "$INDEXED" ]]; then
  LOCAL_NEWER=1
else
  for d in "${LOCAL_DIRS[@]}"; do
    [[ -d "$d" ]] || continue
    [[ -n "$(find "$d" -name '*.md' -newer "$INDEXED" -print -quit 2>/dev/null)" ]] && { LOCAL_NEWER=1; break }
  done
fi

# Rate: a network call at most once per THROTTLE seconds.
if [[ "$FORCE" != 1 && "$LOCAL_NEWER" != 1 && -f "$STAMP" ]]; then
  age=$(( $(date +%s) - $(stat -f%m "$STAMP" 2>/dev/null || echo 0) ))
  (( age < THROTTLE )) && { say "qmd-refresh: checked $age s ago, skipping"; finish }
fi

log_warnings   # the rate limit is passed (or an out-of-turn update) — write the warnings

# Whether the main branch of at least one copy has moved. An empty answer (no network) is no reason
# to think it has.
if [[ "$FORCE" != 1 && "$LOCAL_NEWER" != 1 ]]; then
  (( ${#COPIES} )) || { say "qmd-refresh: no live git copies in $INDEX_YML, local content unchanged — skipping"; finish }
  moved=0
  for i in {1..${#COPIES}}; do
    COPY="${COPIES[$i]}" BRANCH="${BRANCHES[$i]}" ACCOUNT="${ACCOUNTS[$i]}"
    # The token is taken explicitly from the profile's account: the active gh account may be the work one, and then
    # the private repository "does not exist", and the empty answer below silently skips the update.
    if [[ -n "$ACCOUNT" ]]; then
      remote="$(git -c credential.helper= \
        -c "credential.helper=!f() { echo username=x-access-token; echo password=\$(gh auth token --user $ACCOUNT); }; f" \
        -C "$COPY" ls-remote --heads origin "$BRANCH" 2>/dev/null | cut -f1)"
    else
      remote="$(git -C "$COPY" ls-remote --heads origin "$BRANCH" 2>/dev/null | cut -f1)"
    fi
    [[ -z "$remote" ]] && { say "qmd-refresh: remote unavailable, skipping"; continue }
    # Compare with the CHECKED-OUT commit, not with `origin/main`: the ref is moved by
    # any `git fetch`, including someone else's or a diagnostic one, while what gets indexed is
    # what lies in the copy's working tree. When those two diverge, they give a false "fresh".
    local_ref="$(git -C "$COPY" rev-parse HEAD 2>/dev/null || echo none)"
    if [[ "$remote" == "$local_ref" ]]; then say "qmd-refresh: the index is already at $remote"; else moved=1; fi
  done
  : > "$STAMP"
  [[ "$moved" == 1 ]] || finish
fi

# The lock is shared with qmd-mcp: if it is taken, the same work is going on there.
mkdir "$LOCK" 2>/dev/null || { say "qmd-refresh: an update is already running"; finish }

run_update() {
  trap 'rm -rf "$LOCK" 2>/dev/null' EXIT TERM INT HUP
  # The pid of the holder. In the background subshell $$ is still the pid of this script, which exits at
  # once, and a dead pid reads as an abandoned lock (qmd-collections, qmd-mcp): there only the parent
  # writes the pid, the subshell's own ($!).
  [[ "$WAIT" == 1 ]] && { print -r -- "$$" > "$LOCK/pid" 2>/dev/null || true }
  # The stamp goes BEFORE update: a note written during indexing will be newer and
  # get into the next pass instead of being lost.
  : > "$INDEXED"
  {
    echo "== $(date '+%F %T') refresh (qmd-refresh)"
    "$QMD_BIN" update; echo "update rc=$?"
    if models_agreed; then nice -n 10 "$QMD_BIN" embed; echo "embed rc=$?"; else echo "embed skipped: no consent to the models in $ANSWER_FILE"; fi
  } >>"$LOG" 2>&1
}

if [[ "$WAIT" == 1 ]]; then
  run_update
  for c in "${COPIES[@]}"; do
    say "qmd-refresh: the index is at $(git -C "$c" rev-parse --short HEAD 2>/dev/null || echo '?')"
  done
  (( ${#COPIES} )) || say "qmd-refresh: index updated"
else
  # To the background without inheriting stdio: a hook waiting for `embed` to finish would hang the session.
  ( run_update ) </dev/null >/dev/null 2>&1 &
  print -r -- "$!" > "$LOCK/pid" 2>/dev/null || true
  disown 2>/dev/null
  say "qmd-refresh: update started in the background, log $LOG"
fi
finish
