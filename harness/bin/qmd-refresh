#!/usr/bin/env node
// qmd-refresh — brings the qmd index up to the projects' current main branches.
//
// The qmd-mcp wrapper updates the index ONCE, when the MCP server starts. In a long
// session that is not enough: main moves a dozen merges ahead, while search keeps
// answering with the snapshot from the start of the session — and answers confidently, which is worse than silence.
//
// Here is the same update, but on demand and cheap: first we ask the remote
// repositories whether the main branch has moved, and exit if not. One network call
// per git copy.
//
// What to check is taken from ~/.config/qmd/index.yml, not from this file:
//   git copies — collections whose `update:` runs qmd-sync-main <profile>; the copy's path, branch and
//               gh account come from `qmd-sync-main --describe <profile>` (that is, the project's profile);
//   local ones — paths of collections without `update:` (project memory, lessons).
// The exception is memory and lessons: they are outside git, and if there is a file newer than the last
// update (`last-index`), we update without the network check (since 2026-09-29: before that
// a note waited for main to move or for the MCP server to restart).
//
//   qmd-refresh            — update if main has moved
//   qmd-refresh --force    — update unconditionally
//   qmd-refresh --quiet    — no output (for the hook)
//   qmd-refresh --wait     — do not go to the background, wait for the end (for checking by hand)
//
// The check runs in place and costs one network call; the update itself (`update` +
// `embed`) goes to the BACKGROUND, because embed takes minutes and a hook cannot wait.
//
// The lock is shared with qmd-mcp: `qmd update` does a checkout in the shared copy, and two
// checkouts at once produce garbage. If it is taken, exit silently: whoever holds the lock
// is doing exactly the same work.
"use strict"

const fs = require("node:fs")
const path = require("node:path")
const { spawnSync } = require("node:child_process")
const { git: GIT } = require("../hooks/eval-env.cjs")
const q = require("../hooks/qmd-common.cjs")

const INDEX_YML = q.indexYml()
// qmd-sync-main is the script next to this one, in the folder of this file's real path.
const SYNC = process.env.QMD_REFRESH_SYNC || path.join(path.dirname(fs.realpathSync(__filename)), "qmd-sync-main") // override for tests
const LOG = q.logFile()
const STAMP = path.join(q.cacheDir(), "last-check")
const THROTTLE = 300 // seconds between network checks
const INDEXED = q.indexedFile() // start time of the last index update

const flags = new Set(process.argv.slice(2))
const FORCE = flags.has("--force")
const QUIET = flags.has("--quiet")
const WAIT = flags.has("--wait")
const say = (text) => {
    if (!QUIET) process.stdout.write(`${text}\n`)
}

// A partial failure (one profile not resolved, one copy missing) does not stop the run:
// memory and lessons must be updated even then. Exit code: without --quiet — 1 on a partial
// failure; with --quiet (this is how the Stop hook calls it) — 0, because a non-zero hook
// exit would show up as an error on every turn. The signal in that case is a line in $LOG; it is written
// only by a pass that got past the rate limit, otherwise the log would grow by a line
// on every turn.
let partial = false
let warnings = []
const warn = (text) => {
    partial = true
    warnings.push(text)
    say(`qmd-refresh: ${text}`)
}
function logWarnings() {
    if (warnings.length === 0) return
    try {
        fs.mkdirSync(q.cacheDir(), { recursive: true })
        fs.appendFileSync(LOG, warnings.map((w) => `${q.timestamp()} qmd-refresh: ${w}\n`).join(""))
    } catch {}
    warnings = []
}
const finish = () => process.exit(partial && !QUIET ? 1 : 0)
// A total failure (no qmd, no index.yml): with --quiet also 0 — for the same reason.
function die(code, text, stream = "stdout") {
    if (!QUIET) process[stream].write(`qmd-refresh: ${text}\n`)
    process.exit(QUIET ? 0 : code)
}

const tooOld = q.nodeTooOld()
if (tooOld) die(3, `${tooOld}, the index is not updated; ${q.GREP_FALLBACK}`, "stderr")
const QMD = q.findQmd()
if (!QMD) die(127, `qmd not found, the index is not updated; ${q.GREP_FALLBACK}`, "stderr")

let indexText
try {
    indexText = fs.readFileSync(INDEX_YML, "utf8")
} catch {
    die(1, `no ${INDEX_YML}`)
}

// Parsing index.yml: collections are keys indented by 2 under `collections:`, their fields are indented by 4.
const MIRRORS = [] // profile of each git copy
const LOCAL_DIRS = [] // path of each local collection
{
    let inside = false
    let current = null
    const flush = () => {
        if (current) {
            const sync = q.syncOf(current.update)
            if (sync) {
                if (!MIRRORS.includes(sync[1])) MIRRORS.push(sync[1])
            } else if (!current.update && current.path) LOCAL_DIRS.push(current.path)
        }
        current = null
    }
    for (const line of indexText.split(/\r?\n/)) {
        if (/^[^ #]/.test(line)) {
            flush()
            inside = /^collections:/.test(line)
            continue
        }
        if (!inside) continue
        if (/^ {2}[^ #][^:]*:\s*$/.test(line)) {
            flush()
            current = { path: "", update: "" }
            continue
        }
        const field = /^ {4}(path|update):(.*)$/.exec(line)
        if (current && field) current[field[1]] = q.unquote(field[2])
    }
    flush()
}

// Copy, branch, account of each git copy — from the profile via qmd-sync-main --describe.
// The answer is stdout only: a profile warning on stderr (bin/profile warns and still answers) passes
// through to our stderr, not under --quiet (the Stop hook, every turn); on a failure the reason is the
// last stderr line (qmd-sync-main prints it there), or stdout when stderr is empty.
const COPIES = []
for (const profile of MIRRORS) {
    const run = q.runScript(SYNC, ["--describe", profile])
    const out = (run.stdout || "").replace(/\r?\n$/, "")
    const err = (run.stderr || "").trimEnd()
    if (run.status !== 0) {
        warn(`profile ${profile} not resolved, its copy skipped — ${err.split(/\r?\n/).pop() || out || (run.error ? run.error.message : "")}`)
        continue
    }
    if (err && !QUIET) process.stderr.write(`${err}\n`)
    const [copy, branch, account] = out.split("\t")
    if (!fs.existsSync(path.join(copy, ".git"))) {
        warn(`copy ${copy} (profile ${profile}) is missing, skipped — start a session with qmd-mcp first`)
        continue
    }
    COPIES.push({ copy, branch, account })
}

// A failed pull (qmd-sync-main writes the markers, one per profile): the index answers with an old snapshot.
let cached = []
try {
    cached = fs.readdirSync(q.cacheDir())
} catch {}
for (const name of cached.filter((n) => n.startsWith("sync-failed"))) {
    say(`qmd-refresh: WARNING — the last pull of main failed, the index may be stale: ${fs.readFileSync(path.join(q.cacheDir(), name), "utf8").slice(0, 300)}`)
}

// Memory and lessons live outside git: main may not have moved while a note appeared. The check
// is local and cheap, so it runs before the rate limit and without the network.
const mtime = (file) => {
    try {
        return fs.statSync(file).mtimeMs
    } catch {
        return null
    }
}
function hasNewerNote(dir, since) {
    let entries
    try {
        entries = fs.readdirSync(dir, { withFileTypes: true })
    } catch {
        return false
    }
    for (const entry of entries) {
        const file = path.join(dir, entry.name)
        if (entry.isDirectory()) {
            if (hasNewerNote(file, since)) return true
        } else if (entry.name.endsWith(".md") && (mtime(file) ?? 0) > since) return true
    }
    return false
}
const indexedAt = mtime(INDEXED)
const LOCAL_NEWER = indexedAt === null || LOCAL_DIRS.some((dir) => hasNewerNote(dir, indexedAt))

// Rate: a network call at most once per THROTTLE seconds.
const checkedAt = mtime(STAMP)
if (!FORCE && !LOCAL_NEWER && checkedAt !== null) {
    const age = Math.floor((Date.now() - checkedAt) / 1000)
    if (age < THROTTLE) {
        say(`qmd-refresh: checked ${age} s ago, skipping`)
        finish()
    }
}

logWarnings() // the rate limit is passed (or an out-of-turn update) — write the warnings

const gitIn = (copy, argv, auth = []) => spawnSync(GIT, [...auth, "-C", copy, ...argv], { encoding: "utf8", windowsHide: true, stdio: ["ignore", "pipe", "ignore"] })

// Whether the main branch of at least one copy has moved. An empty answer (no network) is no reason
// to think it has.
if (!FORCE && !LOCAL_NEWER) {
    if (COPIES.length === 0) {
        say(`qmd-refresh: no live git copies in ${INDEX_YML}, local content unchanged — skipping`)
        finish()
    }
    let moved = false
    for (const { copy, branch, account } of COPIES) {
        // The token is taken explicitly from the profile's account: the active gh account may be the work one, and then
        // the private repository "does not exist", and the empty answer below silently skips the update.
        const auth = account ? ["-c", "credential.helper=", "-c", `credential.helper=!f() { echo username=x-access-token; echo password=$(gh auth token --user ${account}); }; f`] : []
        const remote = (gitIn(copy, ["ls-remote", "--heads", "origin", branch], auth).stdout || "").split("\t")[0].trim()
        if (!remote) {
            say("qmd-refresh: remote unavailable, skipping")
            continue
        }
        // Compare with the CHECKED-OUT commit, not with `origin/main`: the ref is moved by
        // any `git fetch`, including someone else's or a diagnostic one, while what gets indexed is
        // what lies in the copy's working tree. When those two diverge, they give a false "fresh".
        const head = gitIn(copy, ["rev-parse", "HEAD"])
        if (remote === (head.status === 0 ? head.stdout.trim() : "none")) say(`qmd-refresh: the index is already at ${remote}`)
        else moved = true
    }
    fs.mkdirSync(q.cacheDir(), { recursive: true })
    fs.writeFileSync(STAMP, "")
    if (!moved) finish()
}

// The lock is shared with qmd-mcp: if it is taken, the same work is going on there.
if (!q.takeLock()) {
    say("qmd-refresh: an update is already running")
    finish()
}

// `qmd embed` downloads its model when it is missing, so it runs only after the user agreed to the
// models (the answer file of qmd-mcp) and with the embedding model qmd-mcp
// sets: vectors of another model would not match the server's queries. `qmd update` needs no model.
if (WAIT) {
    q.writeLockPid(process.pid)
    q.runUpdate(QMD, " (qmd-refresh)", true)
    for (const { copy } of COPIES) {
        const head = gitIn(copy, ["rev-parse", "--short", "HEAD"])
        say(`qmd-refresh: the index is at ${head.status === 0 ? head.stdout.trim() : "?"}`)
    }
    if (COPIES.length === 0) say("qmd-refresh: index updated")
} else {
    // To the background without inheriting stdio: a hook waiting for `embed` to finish would hang the session.
    q.startUpdate(" (qmd-refresh)", true)
    say(`qmd-refresh: update started in the background, log ${LOG}`)
}
finish()
