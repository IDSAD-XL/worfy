#!/usr/bin/env node
// epic-board — a snapshot of all epics and tickets on one page.
//
//   epic-board [--days N] [--no-open] [--out FILE]
//
// The truth about tickets lives in .scratch/<epic>/issues/NN-slug.md and sits IN THE BRANCH, and the repository
// has close to a hundred branches. Therefore:
//   • there is one reader of the format and it is outside — epic-status --json --ref <ref>;
//   • epic-board itself also lives outside the project's repository (the plugin's bin/): a tool that reads
//     ACROSS branches cannot sit IN a branch — otherwise it has as many versions as there are branches;
//   • main is the base ("what really exists"), a branch is a mark ("a promise").
// In Silent mode (profile mode "silent") the status lives in the Workflow folder and in no branch: the page is
// built from that folder alone, with no branch marks.
'use strict';
const { execFileSync, execFile, spawn } = require('child_process');
const fs = require('fs');
const path = require('path');
// The git to start and the Harness state folder, with the variables of an eval run (EVAL_GIT, EVAL_HARNESS_HOME).
const { git: GIT, harnessHome } = require('../hooks/eval-env.cjs');

const argv = process.argv.slice(2);
// argv[i+1] of a flag that comes last is undefined, not the default: a trailing --days silently
// gave NaN and dropped all branches, a trailing --out crashed path.dirname.
const opt = (name, def) => {
  const i = argv.indexOf(name);
  if (i < 0) return def;
  const v = argv[i + 1];
  if (v === undefined || v.startsWith('--')) die(`${name} without a value`);
  return v;
};
const die = m => { process.stderr.write('epic-board: ' + m + '\n'); process.exit(2); };
const DAYS = Number(opt('--days', 14));
if (!Number.isFinite(DAYS) || DAYS < 0) die('--days needs a non-negative number');
// The snapshot is Harness state on this machine: $HARNESS_HOME/state (HARNESS_HOME defaults to
// ~/.claude/worfy-harness).
const OUT = opt('--out', path.join(harnessHome(), 'state', 'epic-board.html'));
const NO_OPEN = argv.includes('--no-open');
let BASE = 'main';

const git = (...a) => execFileSync(GIT, a, { encoding: 'utf8', maxBuffer: 1 << 28 }).trim();

// ── which branches to read ───────────────────────────────────────────────────
// Not merged into main and with activity within DAYS days. A branch is not the unit of display:
// the unit of display is the ticket, and branches become its marks.
function pickRefs() {
  // Without main the whole "base plus promises" model has no base — that is a refusal, not an empty page.
  try { git('rev-parse', '--verify', '--quiet', BASE + '^{commit}'); }
  catch { die(`no branch ${BASE} — nothing to count the base from`); }
  const notMerged = new Set(
    git('branch', '--no-merged', BASE, '--format=%(refname:short)').split('\n').filter(Boolean));
  const now = Date.now() / 1000;
  const live = git('for-each-ref', '--format=%(refname:short)\t%(committerdate:unix)', 'refs/heads/')
    .split('\n').filter(Boolean)
    .map(l => { const [name, ts] = l.split('\t'); return { name, ts: Number(ts) }; })
    .filter(b => notMerged.has(b.name) && (now - b.ts) / 86400 <= DAYS)
    .sort((a, b) => b.ts - a.ts)
    .map(b => b.name);
  return [BASE, ...live];
}

// The scripts next to this one: the folder of its real file, not of a symlink to it.
const BIN = path.dirname(fs.realpathSync(__filename));
const EPIC_STATUS = path.join(BIN, 'epic-status');
// A sibling script runs with the node running this one: Windows does not start an extensionless file
// by its #! line. A missing file fails with ENOENT before anything starts, as a missing program did.
const missing = (file, args) =>
  Object.assign(new Error(`spawnSync ${file} ENOENT`), { code: 'ENOENT', path: file, spawnargs: args });
function execScriptSync(file, args, options) {
  if (!fs.existsSync(file)) throw missing(file, args);
  return execFileSync(process.execPath, [file, ...args], options);
}
function execScript(file, args, options, callback) {
  if (!fs.existsSync(file)) return callback(missing(file, args), '');
  execFile(process.execPath, [file, ...args], options, callback);
}

// The page opens with the system's own command: open on macOS, explorer.exe on Windows, xdg-open
// elsewhere. explorer.exe gets the path with no shell in between (nothing to quote) and answers 1 even
// when it opened the file, so its exit code is not read; neither is xdg-open's.
function openPage(file) {
  if (process.platform === 'darwin') return execFileSync('open', [file]);
  const [cmd, args] = process.platform === 'win32' ? ['explorer.exe', [path.resolve(file)]] : ['xdg-open', [file]];
  const child = spawn(cmd, args, { detached: true, stdio: 'ignore' });
  child.on('error', e => {
    process.stderr.write(`epic-board: the page was not opened (${cmd}): ${e.message}\n`);
    process.exitCode = 1;
  });
  child.unref();
}
// The tickets root is the same for all branches — we ask for it once (the project's profile, otherwise
// <git top-level>/.scratch) and pass it to every epic-status, instead of resolving the profile
// again for each of a hundred branches.
let TICKETS_ROOT;
try {
  TICKETS_ROOT = execScriptSync(path.join(BIN, 'ticket'), ['root'],
    { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
} catch (e) {
  die(`tickets root not determined: ${String(e.stderr || e.message).split('\n')[0]}`);
}

// Silent mode is asked once, like the root. Not registered or no profile — Full mode, as before.
let SILENT = false;
try {
  SILENT = execScriptSync(path.join(BIN, 'profile'), ['--field', '_resolved.mode'],
    { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim() === 'silent';
} catch { SILENT = false; }
if (SILENT) BASE = 'Workflow folder';

function readRef(ref) {
  // Silent mode: one snapshot — the Workflow folder itself (epic-status without --ref).
  const args = SILENT ? ['--json', '--root', TICKETS_ROOT] : ['--json', '--ref', ref, '--root', TICKETS_ROOT];
  return new Promise(resolve => {
    execScript(EPIC_STATUS, args, { maxBuffer: 1 << 28 }, (err, stdout) => {
      if (err) return resolve({ ref, epics: [], tickets: [], error: String(err.message || err) });
      try { resolve(JSON.parse(stdout)); }
      catch (e) { resolve({ ref, epics: [], tickets: [], error: 'unreadable JSON: ' + e.message }); }
    });
  });
}

async function pool(items, n, fn) {
  const out = new Array(items.length);
  let i = 0;
  await Promise.all(Array.from({ length: Math.min(n, items.length) }, async () => {
    while (i < items.length) { const k = i++; out[k] = await fn(items[k]); }
  }));
  return out;
}

// ── merge ────────────────────────────────────────────────────────────────────
const key = t => t.epic + '/' + t.num;
const DONE = 'done';

function merge(snapshots) {
  const base = snapshots[0];
  const mainTickets = new Map();
  const collisions = [];
  for (const t of base.tickets) {
    if (mainTickets.has(key(t))) collisions.push({ ref: base.ref, key: key(t) });
    else mainTickets.set(key(t), t);
  }
  const mainEpics = new Set(base.epics.map(e => e.epic));
  const epicMeta = new Map(base.epics.map(e => [e.epic, { ...e, onMain: true, refs: new Set([base.ref]) }]));

  // The ticket is the unit of display. Each has: main's truth (if any) and branch marks.
  const rows = new Map();
  for (const t of mainTickets.values()) rows.set(key(t), { ...t, onMain: true, ahead: [], onlyIn: [] });

  for (const snap of snapshots.slice(1)) {
    const seen = new Set();
    for (const e of snap.epics) {
      if (!epicMeta.has(e.epic)) epicMeta.set(e.epic, { ...e, onMain: false, refs: new Set() });
      const m = epicMeta.get(e.epic);
      m.refs.add(snap.ref);
      m.hasSpec = m.hasSpec || e.hasSpec;
      m.hasMap = m.hasMap || e.hasMap;
    }
    for (const t of snap.tickets) {
      const k = key(t);
      if (seen.has(k)) { collisions.push({ ref: snap.ref, key: k }); continue; }
      seen.add(k);
      let row = rows.get(k);
      if (!row) {
        // The ticket is not on main: it exists only in branches — a promise, not a fact.
        row = { ...t, onMain: false, state: 'none', statusRaw: null, ahead: [], onlyIn: [] };
        rows.set(k, row);
      }
      if (row.onMain) {
        // "Moved ahead" = the state in the branch DIFFERS from main. Not "more advanced":
        // blocked and claimed are not comparable on one scale, the domain has no order between them.
        if (t.state !== row.state) row.ahead.push({ ref: snap.ref, state: t.state, statusRaw: t.statusRaw });
      } else {
        row.onlyIn.push({ ref: snap.ref, state: t.state, statusRaw: t.statusRaw, title: t.title });
        if (!row.title) row.title = t.title;
      }
    }
  }

  // For a ticket outside main the visible state is the freshest of the branches (they are sorted
  // by commit time), but it is still marked as "not on main".
  for (const row of rows.values()) {
    if (!row.onMain && row.onlyIn.length) {
      row.state = row.onlyIn[0].state;
      row.statusRaw = row.onlyIn[0].statusRaw;
    }
  }

  // Being unblocked is computed from the visible state of the blockers in the same epic.
  const stateOf = k => (rows.get(k) ? rows.get(k).state : null);
  for (const row of rows.values()) {
    if (!row.blockedParsed) { row.ready = null; row.waiting = []; row.unknown = []; continue; }
    row.waiting = []; row.unknown = [];
    for (const n of row.blockedNums) {
      const st = stateOf(row.epic + '/' + n);
      // There is no blocker with this number in the epic. Silently counting it as done would mean
      // declaring the ticket ready because of a typo in the number — so it keeps the block.
      if (st === null) row.unknown.push(n);
      else if (st !== DONE) row.waiting.push(n);
    }
    row.ready = row.waiting.length === 0 && row.unknown.length === 0;
  }

  // Epics. Progress is by main (what is done), the stage is by the union (the process goes on in the branch).
  const epics = [];
  for (const [name, meta] of epicMeta) {
    const all = [...rows.values()].filter(r => r.epic === name)
      .sort((a, b) => a.num - b.num);
    const onMain = all.filter(r => r.onMain);
    const doneMain = onMain.filter(r => r.state === DONE).length;
    const stage = stageOf(all, meta);
    epics.push({
      name, stage, meta,
      tickets: all,
      total: onMain.length,
      done: doneMain,
      unionTotal: all.length,
      onMain: mainEpics.has(name),
      refs: [...meta.refs].filter(r => r !== BASE),
    });
  }
  epics.sort((a, b) => a.name.localeCompare(b.name, 'ru'));
  return { epics, collisions, base };
}

function stageOf(all, meta) {
  if (!all.length) return meta.hasSpec ? '/to-spec' : meta.hasMap ? '/wayfinder' : '—';
  const done = all.filter(r => r.state === DONE).length;
  const busy = all.some(r => r.state === 'work' || r.state === 'blocked');
  if (done === all.length) return 'closed';
  if (busy || done > 0) return '/implement';
  return '/to-tickets';
}

// ── page ─────────────────────────────────────────────────────────────────────
const esc = s => String(s == null ? '' : s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const STATE_RU = { done: 'shipped', work: 'in progress', blocked: 'blocked', open: 'open', none: 'no Status' };

// Some titles start with their own number ("17 — Cleanup after the vertical").
// Next to the number column that is duplication, not information.
function shortTitle(t) {
  const pad = String(t.num).padStart(2, '0');
  return String(t.title || '').replace(new RegExp('^(?:' + pad + '|' + t.num + ')(?:\\s+[—–-]\\s+|\\s*[—–]\\s*)'), '');
}

function ticketHtml(t) {
  const cls = ['t', 's-' + t.state];
  if (t.ready === true && t.state !== 'done') cls.push('ready');
  if (t.ready === null) cls.push('unparsed');
  if (!t.onMain) cls.push('offmain');
  const bits = [];
  if (t.ready === null && t.blockedRaw === null) {
    bits.push(`<span class="chip warn">no Blocked by field</span>`);
  } else if (t.ready === null) {
    bits.push(`<span class="chip warn" title="${esc(t.blockedRaw)}">blockers not parsed</span>`);
  } else if (t.unknown.length) {
    bits.push(`<span class="chip warn" title="${esc(t.blockedRaw)}">blocker ${t.unknown.map(n => String(n).padStart(2, '0')).join(', ')} not found</span>`);
  } else if (t.waiting.length) {
    bits.push(`<span class="chip wait">waits for ${t.waiting.map(n => String(n).padStart(2, '0')).join(', ')}</span>`);
  } else if (t.state !== 'done') {
    bits.push(`<span class="chip go">unblocked</span>`);
  }
  // Marks are collapsed by state: one ticket lives in dozens of branches of one
  // family, and sixty "in progress" chips are not a signal but a wall.
  // Branches are sorted by freshness, so the freshest goes into the chip.
  const byState = new Map();
  for (const a of t.ahead) {
    if (!byState.has(a.state)) byState.set(a.state, []);
    byState.get(a.state).push(a);
  }
  for (const [st, list] of byState) {
    const more = list.length > 1 ? ` +${list.length - 1}` : '';
    const title = list.map(a => a.ref + (a.statusRaw ? ' — ' + a.statusRaw : '')).join('\n');
    bits.push(`<span class="chip br" title="${esc(title)}">${esc(STATE_RU[st] || st)} in branch ${esc(list[0].ref)}${esc(more)}</span>`);
  }
  if (!t.onMain) {
    const more = t.onlyIn.length > 1 ? ` +${t.onlyIn.length - 1}` : '';
    const title = t.onlyIn.map(o => o.ref + (o.statusRaw ? ' — ' + o.statusRaw : '')).join('\n');
    bits.push(`<span class="chip off" title="${esc(title)}">only in branch ${esc(t.onlyIn[0].ref)}${esc(more)}</span>`);
  }
  // "Unblocked" = can be taken into work. A shipped ticket is formally not blocked by anything,
  // but it cannot be taken, and in the filter it would be 140 lines of noise.
  const takeable = t.ready === true && t.state !== 'done' ? 1 : 0;
  return `<div class="${cls.join(' ')}" data-ready="${takeable}">
    <span class="num">${String(t.num).padStart(2, '0')}</span>
    <span class="st" title="${esc(t.statusRaw || '')}">${esc(STATE_RU[t.state] || t.state)}</span>
    <span class="title">${esc(shortTitle(t))}</span>
    <span class="bits">${bits.join('')}</span>
  </div>`;
}

function epicHtml(e) {
  const counter = e.onMain
    ? `${e.done}/${e.total}` + (e.unionTotal > e.total ? ` <span class="dim">(+${e.unionTotal - e.total} in branches)</span>` : '')
    : `${e.unionTotal} in branches`;
  return `<details class="epic" open>
    <summary><span class="stage">${esc(e.stage)}</span><span class="ename">${esc(e.name)}</span>
      <span class="count">${counter}</span></summary>
    <div class="tickets">${e.tickets.map(ticketHtml).join('')}</div>
  </details>`;
}

function page(model, refs, elapsed) {
  const onMain = model.epics.filter(e => e.onMain);
  const offMain = model.epics.filter(e => !e.onMain);
  const totals = model.epics.reduce((a, e) => (a.t += e.unionTotal, a.m += e.total, a.d += e.done, a), { t: 0, m: 0, d: 0 });
  const collisions = model.collisions.length
    ? `<div class="err"><b>Number collision.</b> One number is taken twice — fix it in the files,
        not here: ${model.collisions.map(c => esc(c.ref + ' → ' + c.key)).join(', ')}</div>` : '';
  return `<!doctype html><meta charset="utf-8"><title>Epics and tickets</title>
<style>
:root{--bg:#fff;--fg:#111;--dim:#777;--line:#e3e3e3;--card:#fafafa}
@media(prefers-color-scheme:dark){:root{--bg:#15161a;--fg:#e6e6e6;--dim:#8b8b93;--line:#2c2e35;--card:#1c1e24}}
*{box-sizing:border-box}
body{margin:0;padding:24px;background:var(--bg);color:var(--fg);
 font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
h1{font-size:18px;margin:0 0 4px}
.meta{color:var(--dim);font-size:12px;margin-bottom:14px}
.bar{position:sticky;top:0;background:var(--bg);padding:8px 0 12px;border-bottom:1px solid var(--line);
 margin-bottom:14px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;z-index:2}
.bar label{cursor:pointer;user-select:none}
button{font:inherit;background:var(--card);color:var(--fg);border:1px solid var(--line);
 border-radius:6px;padding:3px 10px;cursor:pointer}
.epic{border:1px solid var(--line);border-radius:8px;margin-bottom:10px;background:var(--card)}
summary{cursor:pointer;padding:9px 12px;display:flex;gap:10px;align-items:baseline;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"▸";color:var(--dim);transition:.1s}
details[open]>summary::before{content:"▾"}
.stage{color:var(--dim);font-size:12px;min-width:88px}
.ename{font-weight:600}
.count{color:var(--dim);font-size:12px;margin-left:auto}
.tickets{border-top:1px solid var(--line)}
.t{display:flex;gap:10px;align-items:baseline;padding:5px 12px;border-bottom:1px solid var(--line)}
.t:last-child{border-bottom:none}
.num{color:var(--dim);font-variant-numeric:tabular-nums;min-width:22px}
.st{font-size:11px;min-width:92px;color:var(--dim)}
.s-done .st{color:#3a8f4f}.s-work .st{color:#b8860b}.s-blocked .st{color:#c0392b}.s-none .st{color:#c0392b}
.s-done .title{color:var(--dim)}
.title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bits{display:flex;gap:5px;flex-wrap:wrap}
.chip{font-size:11px;padding:1px 7px;border-radius:10px;border:1px solid var(--line);white-space:nowrap}
.chip.go{border-color:#3a8f4f;color:#3a8f4f}
.chip.wait{color:var(--dim)}
.chip.warn{border-color:#b8860b;color:#b8860b}
.chip.br{border-color:#5566cc;color:#6677dd}
.chip.off{border-color:#8a6ad0;color:#9b7ee0}
.dim{color:var(--dim)}
h2{font-size:14px;margin:26px 0 10px;color:var(--dim);font-weight:600}
.err{border:1px solid #c0392b;color:#c0392b;border-radius:8px;padding:10px 12px;margin-bottom:14px}
body.only-ready .t[data-ready="0"]{display:none}
body.only-ready .epic:not(:has(.t[data-ready="1"])){display:none}
</style>
<h1>Epics and tickets</h1>
<div class="meta">Snapshot ${esc(new Date().toLocaleString('ru-RU'))} · base <b>${esc(BASE)}</b> +
 ${refs.length - 1} ${refs.length - 1 === 1 ? 'live branch' : 'live branches'} (not merged, activity ≤ ${DAYS} days) ·
 ${model.epics.length} epics · ${totals.m} tickets on ${esc(BASE)}, ${totals.t} including branches ·
 built in ${elapsed} s</div>
${collisions}
<div class="bar">
  <label><input type="checkbox" id="ready"> unblocked only</label>
  <button id="expand">expand all</button>
  <button id="collapse">collapse all</button>
</div>
<div id="main">${onMain.map(epicHtml).join('')}</div>
${offMain.length ? `<h2>Not on ${esc(BASE)} yet — exist only in branches</h2>
<div id="off">${offMain.map(epicHtml).join('')}</div>` : ''}
<script>
document.getElementById('ready').onchange = e =>
  document.body.classList.toggle('only-ready', e.target.checked);
const all = d => document.querySelectorAll('details.epic').forEach(x => x.open = d);
document.getElementById('expand').onclick = () => all(true);
document.getElementById('collapse').onclick = () => all(false);
</script>`;
}

// ── run ──────────────────────────────────────────────────────────────────────
(async () => {
  const t0 = Date.now();
  const refs = SILENT ? [BASE] : pickRefs();
  process.stderr.write(`epic-board: ${refs.length} trees (${BASE} + ${refs.length - 1})…\n`);
  const snaps = await pool(refs, 8, readRef);
  const failed = snaps.filter(s => s.error);
  for (const f of failed) process.stderr.write(`  ! ${f.ref}: ${f.error}\n`);
  // A broken snapshot of the base gives a page where EVERYTHING moved to "only in branches":
  // it looks plausible and lies entirely. Better to give nothing.
  if (snaps[0].error) die(`base ${BASE} could not be read: ${snaps[0].error}`);
  if (!snaps[0].epics.length) die(`base ${BASE} has no epics — .scratch is empty or unavailable`);
  // epic-status labels the folder by the branch of its own git (the Workflow folder may be a git repository);
  // on the page it is the base, not a branch.
  if (SILENT) snaps[0].ref = BASE;
  const model = merge(snaps);
  const elapsed = ((Date.now() - t0) / 1000).toFixed(1);
  fs.mkdirSync(path.dirname(OUT), { recursive: true });
  fs.writeFileSync(OUT, page(model, refs, elapsed));
  process.stderr.write(`epic-board: ${model.epics.length} epics → ${OUT} (${elapsed} s)\n`);
  if (!NO_OPEN) openPage(OUT);
})().catch(e => { process.stderr.write('epic-board: ' + (e.stack || e) + '\n'); process.exit(1); });
