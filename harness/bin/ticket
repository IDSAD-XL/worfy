#!/usr/bin/env node
// ticket — механический перевод статуса тикета. Пишет ОДНУ каноническую строку,
// чтобы поле Status перестало вестись руками в четырёх разных написаниях.
//
//   ticket done  <эпик> <NN> [--pr N]   Status: done — 2026-08-27, [PR #N](…)
//   ticket claim <эпик> <NN>            Status: claimed — 2026-08-27
//   ticket open  <эпик> <NN>            Status: open
//   ticket block <эпик> <NN> <причина>  Status: blocked — <причина>
//   ticket show  <эпик> <NN>            показать текущую строку, файл не трогать
//
// Эпик и номер можно писать через слэш: ticket done disputes/03
// Флаг -n печатает будущую строку и не записывает. Флаги распознаются в любой
// позиции, поэтому причина у block не должна содержать отдельный токен «-n».
//
// Написание поля НЕ навязывается: если строка Status уже есть, её префикс
// (`**Status:**` или `Status:`) сохраняется — меняется только значение. Так
// инструмент не воюет с шаблонами /to-tickets и /wayfinder.

import fs from "node:fs"
import path from "node:path"
import { execFileSync } from "node:child_process"

const die = (msg) => {
    process.stderr.write(msg + "\n")
    process.exit(1)
}

const USAGE = `usage: ticket <done|claim|open|block|show> <эпик> <NN> [--pr N] [-n]
       ticket done disputes/03 --pr 42
       ticket block disputes 04 «ждёт ADR-0045»`

const git = (args) => {
    try {
        return execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim()
    } catch {
        return ""
    }
}

// --- аргументы --------------------------------------------------------------
const argv = process.argv.slice(2)
let dryRun = false
let pr = null
const positional = []
for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === "-n") dryRun = true
    else if (a === "--pr") {
        pr = argv[++i]
        if (pr === undefined) die("--pr ждёт номер")
    } else if (a.startsWith("--pr=")) pr = a.slice(5)
    else if (a.startsWith("-")) die(`неизвестный флаг: ${a}\n${USAGE}`)
    else positional.push(a)
}

const [cmd, ...where] = positional
if (!cmd || !["done", "claim", "open", "block", "show"].includes(cmd)) die(USAGE)

// эпик и номер: «disputes 03» или «disputes/03»; остаток — причина для block
let epic, num, reason
if (where[0]?.includes("/")) {
    ;[epic, num] = where[0].split("/")
    reason = where.slice(1).join(" ").replace(/\s+/g, " ").trim()
} else {
    ;[epic, num] = where
    reason = where.slice(2).join(" ").replace(/\s+/g, " ").trim()
}
if (!epic || !num) die(USAGE)
if (/[/\\]/.test(epic) || epic === "." || epic === "..") die(`имя эпика — один каталог в .scratch, получил «${epic}»`)
if (cmd !== "block" && reason) die(`лишние аргументы: ${reason}\n${USAGE}`)
if (!/^\d+$/.test(String(num).trim())) die(`номер тикета ждёт цифры, получил «${num}»`)
const n = Number(num)

// --- файл тикета ------------------------------------------------------------
const root = git(["rev-parse", "--show-toplevel"]) || process.cwd()
const issuesDir = path.join(root, ".scratch", epic, "issues")
if (!fs.existsSync(issuesDir)) die(`нет эпика «${epic}»: ${issuesDir}`)

const matches = fs.readdirSync(issuesDir).filter((f) => f.endsWith(".md") && new RegExp(`^0*${n}-`).test(f))
if (!matches.length) die(`нет тикета ${n} в ${epic}`)
if (matches.length > 1) die(`номер ${n} в ${epic} неоднозначен: ${matches.join(", ")}`)
const file = path.join(issuesDir, matches[0])

// Тикеты очереди фиксов лежат в `.scratch/research-triage/fixes/`, а в каталоге
// эпика на них стоят символические ссылки. Запись шла через rename поверх ссылки
// и заменяла её обычным файлом: Status уезжал в копию, источник оставался
// прежним, и дальше расходились два файла с одним именем (три случая за ночь
// 2026-09-09 — тикеты 29, 31, 33). Пишем по адресу ссылки: и ссылка цела, и
// Status один. Отсутствующая цель — ошибка ссылки, а не тикета, поэтому её
// называем прямо.
let target
try {
    target = fs.realpathSync(file)
} catch (e) {
    die(`не разобрал путь ${path.relative(root, file)}: ${e.message}`)
}
const viaLink = target !== file

// --- чтение с сохранением формы файла ---------------------------------------
let raw = fs.readFileSync(target, "utf8")
const bom = raw.startsWith("﻿") ? "﻿" : ""
if (bom) raw = raw.slice(1)
const eol = raw.includes("\r\n") ? "\r\n" : "\n"
const lines = raw.split(/\r?\n/)

// Префикс поля разбирается двумя вариантами, а не одним: у `Status: **open**`
// звёздочки принадлежат значению, а у `**Status:**` — префиксу.
const STATUS_BOLD = /^(\*\*Status\b[ \t]*\*{0,2}[ \t]*:[ \t]*\*{0,2}[ \t]*)(.*)$/i
const STATUS_PLAIN = /^(Status\b[ \t]*:[ \t]*)(.*)$/i
const statusOf = (l) => l.match(STATUS_BOLD) || l.match(STATUS_PLAIN)
const FIELD_LINE = /^(\*{0,2})(Type|Status|Blocked by|Source|What to build)\b/i

const statusIdx = lines.reduce((last, l, i) => (statusOf(l) ? i : last), -1)

if (cmd === "show") {
    if (statusIdx === -1) die(`${matches[0]}: строки Status нет`)
    console.log(`${matches[0]}:${statusIdx + 1}  ${lines[statusIdx].trim()}`)
    process.exit(0)
}

// --- новое значение ---------------------------------------------------------
const today = new Date().toISOString().slice(0, 10)

const prLink = () => {
    if (pr === null) return ""
    const num = String(pr).replace(/\D/g, "")
    if (!num) die(`--pr ждёт номер, получил «${pr}»`)
    const repo = git(["remote", "get-url", "origin"]).match(/github\.com[:/](.+?)(?:\.git)?$/)?.[1]
    return repo ? `, [PR #${num}](https://github.com/${repo}/pull/${num})` : `, PR #${num}`
}

if (cmd === "block" && !reason) die(`block ждёт причину:\n${USAGE}`)
if (pr !== null && cmd !== "done") die(`--pr бывает только у done, не у ${cmd}`)
const value = {
    done: () => `done — ${today}${prLink()}`,
    claim: () => `claimed — ${today}`,
    open: () => "open",
    block: () => `blocked — ${reason}`,
}[cmd]()

// --- правка -----------------------------------------------------------------
let before = null
let at
if (statusIdx !== -1) {
    before = lines[statusIdx]
    lines[statusIdx] = statusOf(before)[1] + value
    at = statusIdx
} else {
    // Поля нет — вставляем в шапку следом за последним полем, а если полей нет,
    // то за заголовком. Написание берём у соседей.
    const headEnd = lines.slice(0, 25).reduce((last, l, i) => (FIELD_LINE.test(l) ? i : last), -1)
    const bold = headEnd !== -1 && lines[headEnd].match(FIELD_LINE)[1] === "**"
    const line = bold ? `**Status:** ${value}` : `Status: ${value}`

    let insert
    if (headEnd !== -1) [at, insert] = [headEnd + 1, [line]]
    else if (lines[0]?.startsWith("#")) [at, insert] = [1, ["", line]]
    else [at, insert] = [0, [line]]
    // Вставка не должна склеиваться со следующим разделом.
    if (lines[at] !== undefined && lines[at].trim() !== "") insert.push("")
    lines.splice(at, 0, ...insert)
    at += insert.indexOf(line)
}

console.log(`${path.relative(root, target)}:${at + 1}${viaLink ? `  (по ссылке ${path.relative(root, file)})` : ""}`)
if (before !== null) console.log(`  было:  ${before.trim()}`)
console.log(`  стало: ${lines[at].trim()}`)
if (dryRun) {
    console.log("  (-n: файл не тронут)")
    process.exit(0)
}

// Запись через временный файл: обрыв на полуслове не оставит обрезанный тикет.
const tmp = `${target}.ticket.tmp`
try {
    fs.writeFileSync(tmp, bom + lines.join(eol))
    fs.renameSync(tmp, target)
} catch (e) {
    try {
        fs.unlinkSync(tmp)
    } catch {
        /* временного файла может и не быть */
    }
    die(`не записал ${path.relative(root, target)}: ${e.message}`)
}
