#!/usr/bin/env node
// ticket — mechanical change of a ticket's status. Writes ONE canonical line,
// so that the Status field stops being kept by hand in four different spellings.
//
//   ticket done  <epic> <NN> [--pr N]   Status: done — 2026-08-27, [PR #N](…)
//   ticket claim <epic> <NN> [--branch B] [--repo R]
//                                       Status: claimed — 2026-08-27; with --branch also the line
//                                       `Branch: B`, with --repo the line `Repo: R` (a name from
//                                       _resolved.repos of the profile — a project of several repositories)
//   ticket open  <epic> <NN>            Status: open
//   ticket block <epic> <NN> <reason>   Status: blocked — <reason>
//   ticket show  <epic> <NN>            show the current line, do not touch the file
//   ticket root                         print the tickets root (the directory of epics) and exit
//
// Tickets root (the directory holding <epic>/issues/): --root <dir>, otherwise
// the tickets.root field of the project's profile (bin/profile next to this script), otherwise, as before,
// <git top-level or the current directory>/.scratch. The path rules are in profiles/README.md
// (the tickets.root field); epic-status and epic-board take the root from here too. In Silent mode
// (profile mode "silent") a relative root — and the default .scratch — is taken from the Workflow
// folder (_resolved.workflow_folder): the status lives there, one for every worktree, not in a branch.
//
// Epic and number can be written with a slash: ticket done disputes/03
// The -n flag prints the future line and does not write it. Flags are recognised in any
// position, so a block reason must not contain a separate token "-n".
//
// The field's spelling is NOT imposed: if a Status line already exists, its prefix
// (`**Status:**` or `Status:`) is kept — only the value changes. This way
// the tool does not fight the /to-tickets and /wayfinder templates.

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import { execFileSync } from "node:child_process"
import { fileURLToPath } from "node:url"

const die = (msg) => {
    process.stderr.write(msg + "\n")
    process.exit(1)
}

const USAGE = `usage: ticket <done|claim|open|block|show> <epic> <NN> [--pr N] [--branch B] [--repo R] [-n] [--root <dir>]
       ticket root [--root <dir>]
       ticket claim checkout-flow 05 --branch fix/lot-withdraw-button
       ticket done disputes/03 --pr 42
       ticket block disputes 04 "waits for ADR-0045"`

const git = (args) => {
    try {
        return execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim()
    } catch {
        return ""
    }
}

// --- arguments --------------------------------------------------------------
const argv = process.argv.slice(2)
let dryRun = false
let pr = null
let rootArg = null
let branchArg = null
let repoArg = null
const positional = []
const valueOf = (flag, v) => {
    if (v === undefined || v === "" || v.startsWith("-")) die(`${flag} needs a value`)
    return v
}
for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === "-n") dryRun = true
    else if (a === "--pr") {
        pr = argv[++i]
        if (pr === undefined) die("--pr needs a number")
    } else if (a.startsWith("--pr=")) pr = a.slice(5)
    else if (a === "--root") {
        rootArg = argv[++i]
        if (!rootArg) die("--root needs a directory")
    } else if (a.startsWith("--root=")) {
        rootArg = a.slice(7)
        if (!rootArg) die("--root needs a directory")
    }
    else if (a === "--branch") branchArg = valueOf("--branch", argv[++i])
    else if (a.startsWith("--branch=")) branchArg = valueOf("--branch", a.slice(9))
    else if (a === "--repo") repoArg = valueOf("--repo", argv[++i])
    else if (a.startsWith("--repo=")) repoArg = valueOf("--repo", a.slice(7))
    else if (a.startsWith("-")) die(`unknown flag: ${a}\n${USAGE}`)
    else positional.push(a)
}

const [cmd, ...where] = positional
if (!cmd || !["done", "claim", "open", "block", "show", "root"].includes(cmd)) die(USAGE)

// --- tickets root -----------------------------------------------------------
// The profile is always asked, not only outside git: Atakama's tickets live in a common
// directory above three repositories, and from any of them git top-level would point
// to the wrong place. Exit 3 (directory not registered) and an empty field — the old behaviour.
// A broken registry or profile (exit 1) — refusal: a silent fallback to git top-level
// would write the status into the wrong file.
// profile is the script next to this one (the folder of its real file, not of a symlink).
const PROFILE = process.env.CLAUDE_PROFILE_BIN || path.join(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))), "profile")
// The logical launch directory, like $PWD in a shell: process.cwd() resolves symlinks
// (/tmp → /private/tmp), and messages outside git would differ from the old ones.
function launchDir() {
    const cwd = process.cwd()
    const pwd = process.env.PWD
    try {
        if (pwd && path.isAbsolute(pwd) && fs.realpathSync(pwd) === fs.realpathSync(cwd)) return pwd
    } catch {
        /* $PWD is stale — take cwd */
    }
    return cwd
}
let prof = null // the profile as `profile --json` prints it; null — not registered (exit 3) or no profile script
function ticketsRoot() {
    const top = git(["rev-parse", "--show-toplevel"])
    // For `ticket root` (epic-status calls it) — the logical directory, as epic-status
    // used before; for editing a ticket — process.cwd(), as ticket used before.
    const here = cmd === "root" ? launchDir() : process.cwd()
    // An explicit --root is taken from process.cwd() for every command: `ticket root --root ../x` (epic-status
    // calls it) and `ticket claim --root ../x` must point to the same directory. It needs no profile — unless
    // --repo has to be checked against the project's repositories.
    if (rootArg !== null && repoArg === null) return path.resolve(process.cwd(), rootArg)
    try {
        prof = JSON.parse(
            execFileSync(PROFILE, ["-C", here, "--json"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }),
        )
    } catch (e) {
        if (e.code === "ENOENT" || e.status === 3) prof = null
        else {
            const why = String(e.stderr || e.message || "").split("\n")[0].trim()
            if (rootArg !== null) prof = null // the root is given explicitly; the profile is only asked for the repositories
            else die(`project profile not read (${PROFILE}, exit ${e.status ?? e.code}): ${why}\ngive the tickets root explicitly: --root <dir>`)
        }
    }
    if (rootArg !== null) return path.resolve(process.cwd(), rootArg)
    // Silent mode: the workflow files live in the Workflow folder, so a relative root (and the default
    // .scratch) is taken from there, the same from every worktree and from the main checkout.
    const silent = prof?._resolved?.mode === "silent" && typeof prof?._resolved?.workflow_folder === "string"
    const field = prof?.tickets?.root
    if (typeof field !== "string" || !field.trim())
        return path.join(silent ? prof._resolved.workflow_folder : top || here, ".scratch")
    let r = field.trim()
    if (r === "~" || r.startsWith("~/")) r = path.join(os.homedir(), r.slice(1))
    if (path.isAbsolute(r)) return path.resolve(r)
    if (silent) return path.resolve(prof._resolved.workflow_folder, r)
    // A relative one is taken from the root of the current working tree: tickets travel with the branch, and
    // a worktree has its own. Outside git — from the profile's common directory, otherwise from cwd.
    return path.resolve(top || prof?._resolved?.workspace || here, r)
}
const scratch = ticketsRoot()
if (cmd === "root") {
    if (where.length) die(`extra arguments: ${where.join(" ")}\n${USAGE}`)
    console.log(scratch)
    process.exit(0)
}

// epic and number: "disputes 03" or "disputes/03"; the rest is the reason for block
let epic, num, reason
if (where[0]?.includes("/")) {
    ;[epic, num] = where[0].split("/")
    reason = where.slice(1).join(" ").replace(/\s+/g, " ").trim()
} else {
    ;[epic, num] = where
    reason = where.slice(2).join(" ").replace(/\s+/g, " ").trim()
}
if (!epic || !num) die(USAGE)
if (/[/\\]/.test(epic) || epic === "." || epic === "..") die(`an epic name is one directory in .scratch, got "${epic}"`)
if (cmd !== "block" && reason) die(`extra arguments: ${reason}\n${USAGE}`)
if (!/^\d+$/.test(String(num).trim())) die(`a ticket number needs digits, got "${num}"`)
const n = Number(num)

// --- ticket file ------------------------------------------------------------
// Paths in the output are relative to the directory above the tickets root: ".scratch/<epic>/issues/…".
const root = path.dirname(scratch)
const issuesDir = path.join(scratch, epic, "issues")
if (!fs.existsSync(issuesDir)) die(`no epic "${epic}": ${issuesDir}`)

const matches = fs.readdirSync(issuesDir).filter((f) => f.endsWith(".md") && new RegExp(`^0*${n}-`).test(f))
if (!matches.length) die(`no ticket ${n} in ${epic}`)
if (matches.length > 1) die(`number ${n} in ${epic} is ambiguous: ${matches.join(", ")}`)
const file = path.join(issuesDir, matches[0])

// Tickets of the fix queue live in `.scratch/research-triage/fixes/`, and the epic's
// directory holds symbolic links to them. Writing went through rename over the link
// and replaced it with a regular file: Status went into the copy, the source stayed
// as it was, and from then on two files with the same name diverged (three cases in one night,
// 2026-09-09 — tickets 29, 31, 33). We write to the link's target: the link stays intact, and
// there is one Status. A missing target is an error of the link, not of the ticket, so we
// name it directly.
let target
try {
    target = fs.realpathSync(file)
} catch (e) {
    die(`could not resolve the path ${path.relative(root, file)}: ${e.message}`)
}
const viaLink = target !== file

// --- reading while keeping the file's shape ----------------------------------
let raw = fs.readFileSync(target, "utf8")
const bom = raw.startsWith("﻿") ? "﻿" : ""
if (bom) raw = raw.slice(1)
const eol = raw.includes("\r\n") ? "\r\n" : "\n"
const lines = raw.split(/\r?\n/)

// The field prefix is parsed with two variants, not one: in `Status: **open**`
// the asterisks belong to the value, and in `**Status:**` to the prefix.
const STATUS_BOLD = /^(\*\*Status\b[ \t]*\*{0,2}[ \t]*:[ \t]*\*{0,2}[ \t]*)(.*)$/i
const STATUS_PLAIN = /^(Status\b[ \t]*:[ \t]*)(.*)$/i
const statusOf = (l) => l.match(STATUS_BOLD) || l.match(STATUS_PLAIN)
const FIELD_LINE = /^(\*{0,2})(Type|Status|Blocked by|Source|What to build)\b/i

const statusIdx = lines.reduce((last, l, i) => (statusOf(l) ? i : last), -1)

if (cmd === "show") {
    if (statusIdx === -1) die(`${matches[0]}: no Status line`)
    console.log(`${matches[0]}:${statusIdx + 1}  ${lines[statusIdx].trim()}`)
    process.exit(0)
}

// --- new value --------------------------------------------------------------
const today = new Date().toISOString().slice(0, 10)

const prLink = () => {
    if (pr === null) return ""
    const num = String(pr).replace(/\D/g, "")
    if (!num) die(`--pr needs a number, got "${pr}"`)
    const repo = git(["remote", "get-url", "origin"]).match(/github\.com[:/](.+?)(?:\.git)?$/)?.[1]
    return repo ? `, [PR #${num}](https://github.com/${repo}/pull/${num})` : `, PR #${num}`
}

if (cmd === "block" && !reason) die(`block needs a reason:\n${USAGE}`)
if (pr !== null && cmd !== "done") die(`--pr goes only with done, not with ${cmd}`)
if (branchArg !== null && cmd !== "claim") die(`--branch goes only with claim, not with ${cmd}`)
if (repoArg !== null && cmd !== "claim") die(`--repo goes only with claim, not with ${cmd}`)
// A branch name git would refuse would end up in the ticket and lead nowhere.
if (branchArg !== null) {
    try {
        execFileSync("git", ["check-ref-format", "--branch", branchArg], { stdio: ["ignore", "ignore", "ignore"] })
    } catch {
        die(`--branch: "${branchArg}" is not a valid branch name`)
    }
}
// The repository of the ticket is one of the project's repositories (_resolved.repos, ADR-0045: one ticket — one
// repository). Without a profile (--root outside the registry) there is nothing to check against.
if (repoArg !== null && Array.isArray(prof?._resolved?.repos) && prof._resolved.repos.length) {
    const names = prof._resolved.repos.map((r) => r.name)
    if (!names.includes(repoArg)) die(`--repo: "${repoArg}" is not a repository of the project (${names.join(", ")})`)
}
const value = {
    done: () => `done — ${today}${prLink()}`,
    claim: () => `claimed — ${today}`,
    open: () => "open",
    block: () => `blocked — ${reason}`,
}[cmd]()

// --- edit -------------------------------------------------------------------
let before = null
let at
if (statusIdx !== -1) {
    before = lines[statusIdx]
    lines[statusIdx] = statusOf(before)[1] + value
    at = statusIdx
} else {
    // No field — insert into the header right after the last field, and if there are no fields,
    // after the heading. The spelling is taken from the neighbours.
    const headEnd = lines.slice(0, 25).reduce((last, l, i) => (FIELD_LINE.test(l) ? i : last), -1)
    const bold = headEnd !== -1 && lines[headEnd].match(FIELD_LINE)[1] === "**"
    const line = bold ? `**Status:** ${value}` : `Status: ${value}`

    let insert
    if (headEnd !== -1) [at, insert] = [headEnd + 1, [line]]
    else if (lines[0]?.startsWith("#")) [at, insert] = [1, ["", line]]
    else [at, insert] = [0, [line]]
    // The insertion must not merge with the next section.
    if (lines[at] !== undefined && lines[at].trim() !== "") insert.push("")
    lines.splice(at, 0, ...insert)
    at += insert.indexOf(line)
}

console.log(`${path.relative(root, target)}:${at + 1}${viaLink ? `  (via link ${path.relative(root, file)})` : ""}`)
if (before !== null) console.log(`  was: ${before.trim()}`)
console.log(`  now: ${lines[at].trim()}`)

// `Branch:` and `Repo:` — header lines next to Status (machine lines, English keys). An existing line keeps its
// prefix (`**Branch:**` or `Branch:`) and gets the new value; a missing one goes right after the Status line,
// in the Status line's spelling.
const extra = [
    ["Branch", branchArg],
    ["Repo", repoArg],
]
for (const [key, val] of extra) {
    if (val === null) continue
    const bold = new RegExp(`^(\\*\\*${key}\\b[ \\t]*\\*{0,2}[ \\t]*:[ \\t]*\\*{0,2}[ \\t]*)(.*)$`, "i")
    const plain = new RegExp(`^(${key}\\b[ \\t]*:[ \\t]*)(.*)$`, "i")
    const idx = lines.reduce((last, l, i) => (bold.test(l) || plain.test(l) ? i : last), -1)
    if (idx !== -1) {
        const was = lines[idx]
        lines[idx] = (was.match(bold) || was.match(plain))[1] + val
        console.log(`  ${key.toLowerCase()}: ${was.trim()} -> ${lines[idx].trim()}`)
    } else {
        const line = lines[at].startsWith("**") ? `**${key}:** ${val}` : `${key}: ${val}`
        lines.splice(at + 1, 0, line)
        console.log(`  ${key.toLowerCase()}: ${line}`)
    }
}
if (dryRun) {
    console.log("  (-n: file not touched)")
    process.exit(0)
}

// Writing through a temporary file: an interruption mid-write will not leave a truncated ticket.
const tmp = `${target}.ticket.tmp`
try {
    fs.writeFileSync(tmp, bom + lines.join(eol))
    fs.renameSync(tmp, target)
} catch (e) {
    try {
        fs.unlinkSync(tmp)
    } catch {
        /* the temporary file may not exist */
    }
    die(`could not write ${path.relative(root, target)}: ${e.message}`)
}
