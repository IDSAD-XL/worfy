{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/card-runtime/**/*.ts",
    "src/renderer/canvas/epic-layout.ts",
    "src/renderer/canvas/elk/layout.ts",
    "src/renderer/focus/split-tree.ts",
    "src/renderer/canvas/card-bridge.ts",
    "src/renderer/canvas/history.ts",
    "src/renderer/find/search-index.ts",
    "src/renderer/ipc.ts",
    "test/unit/**/*.ts",
    "test/contract/**/*.ts",
    "test/e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "out", ".claude/worktrees/**", "**/*.tsx"]
}
